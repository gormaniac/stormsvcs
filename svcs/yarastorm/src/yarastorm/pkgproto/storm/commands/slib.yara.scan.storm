init {
    $yaralib = $lib.import(slib.yara.lib)
    $yaraingest = $lib.import(slib.yara.ingest)

    $count = $yaralib.ruleCount()
    if ($count.status and $count.data = 0) {
        $lib.warn("The slib.yara service has no rules to scan with, enable rules with slib.yara.enable or run slib.yara.sync.")
    }
}

switch $node.form() {
    "file:bytes": {
        if (not :sha256) {
            $lib.warn(`file:bytes={$node.repr()} has no :sha256 and can't be scanned.`)
        }
        else {
            $sha256 = :sha256
            $file = $node.repr()

            for $retn in $yaralib.match($sha256) {
                if $retn.status {
                    if $retn.data.matched {
                        $yaraingest.yaraMatch($retn.data.rule, $file)
                        $lib.print(`it:app:yara:rule={$retn.data.rule} matched file:bytes={$file}`)
                    }
                    elif $lib.debug {
                        $lib.print(`it:app:yara:rule={$retn.data.rule} did not match file:bytes={$file}`)
                    }
                }
                elif $retn.data {
                    $lib.warn(`Unable to scan file:bytes={$file} with it:app:yara:rule={$retn.data.rule}: {$retn.mesg}`)
                }
                else {
                    $lib.warn(`There was an error scanning file:bytes={$file}: {$retn.mesg}`)
                }
            }
        }
    }
    *: {
        $lib.warn(`slib.yara.scan only supports file:bytes nodes, skipping {$node.form()}.`)
    }
}
