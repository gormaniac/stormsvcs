init {
    $yaralib = $lib.import(slib.yara.lib)
}

if ($node.form() = "it:app:yara:rule") {
    $retn = $yaralib.disable_rule($node)
    if (not $retn.status) {
        $lib.warn(
            "Unable to disable it:app:yara:rule={guid}: {err}",
            guid=$node.value(),
            err=$retn.mesg
        )
    }
}
