init {
    $svc = $lib.service.get(slib.yara)
}

// Raise an AuthDeny if the current user can't change the service's rules.
function reqAdmin() {
    if (not $lib.user.allowed(slib.yara.admin)) {
        $lib.raise(AuthDeny, "Changing the slib.yara rules requires the slib.yara.admin permission.")
    }
    return()
}

// Yield every enabled it:app:yara:rule node.
function getEnabledRules() {
    it:app:yara:rule:enabled=(true)
    emit $node
}

function match(sha256) {
    return($svc.matchFile($sha256))
}

function compile(rule, check=(false)) {
    return($svc.compileRule($rule.pack(), $check))
}

// The number of compiled rules the service scans with, as a TelepathRetn.
function ruleCount() {
    return($svc.getRuleCount())
}

// Compile the rule into the service (so scans use it) and mark it enabled.
// Returns the service's compile result, the rule is left untouched if it fails to compile.
function enableRule(rule) {
    $reqAdmin()
    $retn = $svc.compileRule($rule.pack())
    if $retn.status {
        yield $rule
        [ :enabled=(true) ]
    }
    return($retn)
}

// Remove the rule from the service (so scans skip it) and mark it disabled.
function disableRule(rule) {
    $reqAdmin()
    $retn = $svc.removeRule($rule.repr())
    if $retn.status {
        yield $rule
        [ :enabled=(false) ]
    }
    return($retn)
}

// Compile every enabled rule into the service and remove the service's rules that aren't
// enabled in the Cortex. Enabled rules that fail to compile are left as they are.
// Returns a dict of "compiled" (count), "failed" (list of {rule, mesg}),
// and "removed" (list of rule guids).
function sync() {
    $reqAdmin()

    $enabled = $lib.set()
    $compiled = (0)
    $failed = ([])
    for $rule in $getEnabledRules() {
        $iden = $rule.repr()
        $enabled.add($iden)
        $retn = $svc.compileRule($rule.pack())
        if $retn.status {
            $compiled = ($compiled + 1)
        }
        else {
            $failed.append(({"rule": $iden, "mesg": $retn.mesg}))
        }
    }

    $removed = ([])
    $retn = $svc.listRules()
    if (not $retn.status) {
        $lib.raise(StormRaise, `Unable to list the slib.yara service's rules: {$retn.mesg}`)
    }
    for $iden in $retn.data {
        if (not $enabled.has($iden)) {
            $retn = $svc.removeRule($iden)
            if $retn.status {
                $removed.append($iden)
            }
            else {
                $failed.append(({"rule": $iden, "mesg": $retn.mesg}))
            }
        }
    }

    return(({"compiled": $compiled, "failed": $failed, "removed": $removed}))
}
