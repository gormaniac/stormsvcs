init {
    $capa = $lib.import(slib.capa.lib)
    $util = $lib.import(slib.capa.util)
    // Looked up once, on the first file, so an empty pipeline doesn't call the service:
    // the view's custom rules (sent to the service once for every file), and the rules
    // info to skip files already scanned with these rules.
    $state = ({"ready": false, "custom": false, "info": null, "force": $cmdopts.force})
}

// Statements after an if block still run for a node spun inside it, so the work is in the else.
// $node.form() (R002) is kept, $node.form isn't a property on Synapse 2.x.
if ($node.form() != "file:bytes") {  // noqa: R002
    $repr = `{$node.form()}={$node.repr()}`  // noqa: R002
    $lib.warn(`slib.capa.scan: Only file:bytes nodes can be scanned, skipping {$repr}.`)
    // Drops the node from the output, unless the inbound nodes are yielded.
    if $cmdopts.yield { spin }  // noqa: P001
} else {
    if (not $state.ready) {
        $state.ready = (true)
        $state.custom = $capa.customKey()
        if (not $state.force) {
            $state.info = $capa.info()
            // The rules aren't available (the lookup warned), so the scans fail without the check.
            if ($state.info = null) { $state.force = (true) }
        }
    }
    divert $cmdopts.yield $util.nodes($capa.scan($node, fmt=$cmdopts.format, osname=$cmdopts.os,
                                                 force=$state.force, rinfo=$state.info,
                                                 custom=$state.custom))
}
