init {
    $priv = $lib.import(slib.capa.priv.user)
    $util = $lib.import(slib.capa.util)

    $info = $lib.null
    $retn = $priv.rulesInfo()
    if (not $util.failed($retn, "Getting the capa rules info")) {
        $info = $retn.data
        $state = $priv.syncState()
        $tags = $priv.tagSettings()

        $lib.print("capa: {capa}", capa=$info.capa)
        $lib.print("rules: {version} ({rules} rules, {lib} library rules, {ns} namespaces)",
                   version=$info.version, rules=$info.rules, lib=$info.lib, ns=$info.namespaces)
        $lib.print("rules sha256: {sha256}", sha256=$info.sha256)
        $lib.print("rules imported: {done}", done=($state.rules = $info.sha256))
        $lib.print("tags: enabled={enabled} prefix={prefix}", enabled=$tags.enabled, prefix=$tags.prefix)
        $lib.print("tag docs imported: {done}", done=($state.tags = `{$tags.prefix}:{$info.sha256}`))
    }
}

if ($cmdopts.yield and $info != $lib.null) {
    spin | meta:ruleset=$info.ruleset
}
