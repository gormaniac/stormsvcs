init {
    $priv = $lib.import(slib.capa.priv.user)
    $util = $lib.import(slib.capa.util)

    $info = (null)
    $retn = $priv.rulesInfo()
    if (not $util.failed($retn, "Getting the capa rules info")) {
        $info = $retn.data
        $state = $priv.syncState()
        $tags = $priv.tagSettings()

        $lib.print(`capa: {$info.capa}`)
        $counts = `{$info.rules} rules, {$info.lib} library rules, {$info.namespaces} namespaces`
        $lib.print(`rules: {$info.version} ({$counts})`)
        $lib.print(`rules sha256: {$info.sha256}`)
        $lib.print(`rules imported: {($state.rules = $info.key)}`)
        $lib.print(`tags: enabled={$tags.enabled} prefix={$tags.prefix}`)
        $tagkey = `{$tags.prefix}:{$info.key}`
        $lib.print(`tag docs imported: {($state.tags = $tagkey)}`)

        // Also warns about the custom rules that are skipped.
        $custom = $lib.import(slib.capa.lib).customInfo()
        if ($custom = null) {
            $lib.print("custom rules: 0")
        } else {
            $skipped = ($custom.errors.size() + $custom.shadowed.size())
            $lib.print(`custom rules: {$custom.rules.size()} ({$skipped} skipped)`)
            for $rule in $custom.rules {
                $lib.print(`    {$rule.name} (meta:rule={$rule.guid})`)
            }
        }
    }
}

if ($cmdopts.yield and $info != null) {
    // The command yields the ruleset, not its inbound nodes.
    spin | meta:ruleset=$info.ruleset  // noqa: P001
}
