// The slib.capa user API. Errors are reported as warnings.
//
// Usable directly from Storm, ex:
//     $capa = $lib.import(slib.capa.lib)
//     file:bytes=<sha256> for $rule in $capa.scan($node) { $lib.print($rule.props.name) }

init {
    $priv = $lib.import(slib.capa.priv.user)
    $model = $lib.import(slib.capa.model)
    $util = $lib.import(slib.capa.util)
}

// The service's rules info (see CapaSvc.rulesInfo), or null if they aren't loaded.
function info() {
    $retn = $priv.rulesInfo()
    if $util.failed($retn, "Getting the capa rules info") { return($lib.null) }
    return($retn.data)
}

// Whether a file:bytes was already scanned with the service's rules. rinfo is the service's
// rules info, it's looked up if not given.
function scanned(file, rinfo=$lib.null) {
    $data = $file.data.get("slib:capa")
    if ($data = $lib.null) { return((false)) }
    if ($rinfo = $lib.null) { $rinfo = $info() }
    if ($rinfo = $lib.null) { return((false)) }
    return(($data.rules.sha256 = $rinfo.sha256))
}

// Run capa against a file:bytes node (pulled from the Axon by :sha256) and model the results.
// Emits the matched meta:rule nodes.
//
// Files already scanned with the same rules are skipped unless force is true. rinfo is the
// service's rules info, it's looked up if not given.
//
// NOTE: return() in a function that emits raises an error, so this uses elif/else instead.
function scan(file, fmt=auto, osname=auto, force=(false), rinfo=$lib.null) {
    $sha256 = $file.props.sha256
    if (not $sha256) {
        $lib.warn("slib.capa: Unable to scan file:bytes={valu}, it has no :sha256.",
                  valu=$file.repr())
    }
    elif ((not $force) and $scanned($file, $rinfo)) {
        $lib.print("slib.capa: Skipping {sha256}, it was already scanned with these rules (see --force).",
                   sha256=$sha256)
    }
    else {
        $retn = $priv.scan($sha256, fmt=$fmt, osname=$osname)
        if (not $util.failed($retn, `Scanning {$sha256}`)) {
            for $r in $model.results($file, $retn.data, $priv.tagPrefix()) { emit $r }
        }
    }
}
