init {
    $rules = $lib.import(slib.snort.priv.rules)
    $util = $lib.import(slib.snort.util)
    $push = ([])
}

if ($node.form() = "it:app:snort:rule") {
    [ :enabled=(true) ]
    $engine = $node.props.engine
    if (not $node.props.text) {
        $lib.warn("slib.snort.rule.enable: it:app:snort:rule={guid} has no :text, it can't be pushed to the service.",
            guid=$node.repr())
    } elif ($engine != $lib.null and $engine != 2 and $engine != 3) {
        $lib.warn("slib.snort.rule.enable: it:app:snort:rule={guid} has an unsupported :engine ({engine}), the service runs engines 2 and 3.",
            guid=$node.repr(), engine=$engine)
    } else {
        $push.append(($node.repr(), $node.props.text, $engine))
    }
}

fini {
    if $push {
        $summary = $util.data($rules.update(rules=$push), "Pushing the rules to the service")
        if $summary {
            $util.printBuild("slib.snort.rule.enable", $summary)
            for ($guid, $mesg) in $summary.errors {
                $lib.warn("slib.snort.rule.enable: it:app:snort:rule={guid} couldn't be loaded: {err}", guid=$guid, err=$mesg)
            }
        }
    }
}
