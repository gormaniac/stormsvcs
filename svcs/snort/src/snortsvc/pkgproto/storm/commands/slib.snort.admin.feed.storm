init {
    $admin = $lib.import(slib.snort.priv.admin)
    $util = $lib.import(slib.snort.util)

    $name = $lib.cast(str, $cmdopts.name).lower()
    switch $cmdopts.action {
        "add": {
            if (not $cmdopts.url) {
                $lib.warn("slib.snort.admin.feed: A URL is required to add a feed.")
            } else {
                $fdef = ({"name": $name, "url": $cmdopts.url, "engine": $cmdopts.engine,
                          "exclude": $cmdopts.exclude, "desc": $cmdopts.desc, "enabled": (not $cmdopts.disabled)})
                $feed = $util.data($admin.feedAdd($fdef), `Adding the {$name} feed`)
                if $feed {
                    $lib.print("slib.snort.admin.feed: Added the {name} feed ({url}), it syncs on the next slib.snort.sync.",
                        name=$feed.name, url=$feed.url)
                }
            }
        }
        "del": {
            $feed = $util.data($admin.feedDel($name), `Removing the {$name} feed`)
            if $feed {
                $lib.print("slib.snort.admin.feed: Removed the {name} feed, its meta:ruleset={guid} and rules are still in the Cortex.",
                    name=$feed.name, guid=$feed.ruleset)
            }
        }
        "enable": {
            if $util.data($admin.feedEnable($name, enabled=(true)), `Enabling the {$name} feed`) {
                $lib.print("slib.snort.admin.feed: Enabled the {name} feed.", name=$name)
            }
        }
        "disable": {
            if $util.data($admin.feedEnable($name, enabled=(false)), `Disabling the {$name} feed`) {
                $lib.print("slib.snort.admin.feed: Disabled the {name} feed, its rules are left as they are.", name=$name)
            }
        }
    }
}
