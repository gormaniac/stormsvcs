init {
    $ipapilib = $lib.import("slib.ipapi.lib")
    // TODO - cast query to an inet:ipv4/6 so we can error on bad input
    $queryOpt = $cmdopts.query
    // Read fresh on every command call so slib.ipapi.admin.settag/enabletag/disabletag
    // take effect on subsequent queries without needing a package reload.
    $tagPrefix = $lib.import("slib.ipapi.privsep").getIpApiTag()
}

// Use the value in --query if it is passed. This branch must not reference
// $node at all - that would make it non-runtsafe and the command would never
// run when --query is used without inbound nodes.
if ( $queryOpt != '' ) {
    // We spin when --query is used because this isn't meant to accept inbound nodes.
    | spin |

    $retn = $ipapilib.query($queryOpt)

    if $retn.status {
        divert $cmdopts.yield $ipapilib.modelResult($retn.data, $tagPrefix)
    }
    else {
        $lib.warn("There was an error querying the IPAPI service for '{query}': {err}",
            query=$queryOpt, err=$retn.mesg
        )
    }
}
else {
    if (($node.form() = "inet:ipv4") or ($node.form() = "inet:ipv6")) {
        // Use repr() not value() - ip-api.com needs the printable address,
        // not the normalized integer form that value() returns for inet:ipv4.
        $query = $node.repr()

        $retn = $ipapilib.query($query)

        if $retn.status {
            divert $cmdopts.yield $ipapilib.modelResult($retn.data, $tagPrefix)
        }
        else {
            $lib.warn("There was an error querying the IPAPI service for '{query}': {err}",
                query=$query, err=$retn.mesg
            )
        }
    }
    else {
        // Never hit the API for unsupported forms - ip-api.com answers an
        // empty query with the requesting host's own IP.
        $lib.warn(`The node form "{$node.form()}" is not supported by the slib.ipapi.query command.`)
    }
}
