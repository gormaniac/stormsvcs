init {
    $ipapilib = $lib.import(slib.ipapi.lib)
    $queryOpt = $cmdopts.query

    // Read fresh on every command call so slib.ipapi.admin.settag/enabletag/disabletag
    // take effect on subsequent queries without needing a package reload. A bad setting
    // only means the results go untagged, it doesn't stop the query.
    try {
        $tagPrefix = $lib.import(slib.ipapi.privsep).getIpApiTag()
    }
    catch BadConfValu as err {
        $lib.warn(`{$err.mesg} Querying without tags.`)
        $tagPrefix = (null)
    }

    // --query ignores inbound nodes, they're dropped and its query runs in the fini block.
    $useNodes = ($queryOpt = '')

    // Inbound IP nodes waiting to be sent to ip-api.com in one batch request.
    $state = ({"nodes": []})
}

+$useNodes

if $ipapilib.isIp($node) {
    // Queue the node, it's yielded again once its batch is queried and modeled.
    divert (true) $ipapilib.queueNode($state, $node, $tagPrefix)
}
else {
    // Never hit the API for unsupported forms - ip-api.com answers an
    // empty query with the requesting host's own IP.
    $lib.warn(`The node {$node.repr()} is not supported by the slib.ipapi.query command, only inet:ipv4 and inet:ipv6 nodes are.`)
}

// NOTE: The fini block must come last, any opers after it would get the nodes it yields.
fini {
    if $useNodes {
        // Query whatever is left of the last batch.
        yield $ipapilib.flushNodes($state, $tagPrefix)
    }
    else {
        divert $cmdopts.yield $ipapilib.queryText($queryOpt, $tagPrefix)
    }
}
