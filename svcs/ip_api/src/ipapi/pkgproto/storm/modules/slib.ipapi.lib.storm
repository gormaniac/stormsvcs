init {
    $svc = $lib.service.get('slib.ipapi')
    // TODO - maybe let a user override this per call to modelResult()?
    $tagPrefix = $lib.import("slib.ipapi.privsep").getIpApiTag()
}

function query(query) {
    return($svc.queryIp($query))
}

function buildGeoTelemNode (ipNode, placeNode, data) {
    [ geo:telem=({"node": ([$ipNode.form(), $ipNode.value()]), "place": $placeNode}))
        :time=($lib.now())
        :place:name = {yield $placeNode :name -> *}
        :place:latlong = {yield $placeNode :latlong -> *}
        :place:country = $data.country
        :place:countrycode = $data.countryCode
        :desc = (`IP geolocation data for {$ipNode.form()}={$ipNode.value()} at the coordinates {$data.lat}, {$data.lon} per ip-api.com.`)
    ]

    return((null))
}

function buildPlaceNode(data) {
    $placeName = (', ').join(([$data.city, $data.regionName, $data.country]))

    [
        geo:place=($data.lat, $data.lon, $data.city)
        :latlong=($data.lat, $data.lon)
        :name=`$placeName ({$data.lat}, {$data.lon})`
        :type=ip.geoloc.city
        :desc=(`{$placeName} at the coordinates {$data.lat}, {$data.lon} per ip geolocation data.`)
    ]

    return($node)
}

function buildOrgNode(data) {
    gen.ou.org($data.isp) --yield
    [
        :names=($data.asname, $data.as_, $data.as_.strip("AS").split(" ").0)
        :orgtype=company.isp
    ]

    return($node)
}

function buildASNNode(data) {
    $asnParts = $data.as_.strip("AS").split(" ")

    [
        inet:asn?=$asnParts.0
        :owner={ yield $buildOrgNode($data) }
    ]

    return($node)
}

function modelResult(data) {
    $locNode = $buildPlaceNode($data)
    $asnNode = $buildASNNode($data)

    [
        inet:ipv4?=$data.query
        inet:ipv6?=$data.query
        :asn=$asnNode
    ]

    // TODO - add timestamps here
    if ($tagPrefix != null) {
        if (data.hosting) {
            [+#`{$tagPrefix}.hosting`]
        }
        if ($data.proxy) {
            [+#`{$tagPrefix}.proxy`]
        }
        if ($data.mobile) {
            [+#`{$tagPrefix}.mobile`]
        }
    }

    $buildGeoTelemNode($node, $locNode, $data)
}
