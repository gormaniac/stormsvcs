// Privileged (asroot) wrappers around the slib.hatching service for slib.hatching.submit.
// These send samples to Hatching Triage, and change or delete submitted samples.

init {
    $svc = $lib.service.get("slib.hatching")
    $userKey = $lib.import(slib.hatching.util).userKey
}

function _fail(mesg) { return(({"status": false, "mesg": $mesg, "data": null})) }

// Submit a file from the Axon. opts are the slib.hatching.submit options.
// The file is sent to the service 1MiB at a time, read until the Axon has no more bytes, so the
// whole file is never held in Storm or sent in one Telepath call. The service enforces its max size.
function submitFile(sha256, name, opts) {
    if (not $lib.axon.has($sha256)) { return($_fail(`The Axon doesn't have {$sha256}.`)) }

    $retn = $svc.submitFileInit()
    if (not $retn.status) { return($retn) }
    $upload = $retn.data
    $offs = (0)
    while (true) {
        $byts = $lib.axon.read($sha256, offs=$offs, size=(1048576))
        if (not $byts) { break }
        $retn = $svc.submitFileChunk($upload, $byts)
        if (not $retn.status) { return($retn) }
        $offs = ($offs + $lib.len($byts))
    }

    return($svc.submitFile($upload, $name, interactive=$opts.interactive,
                           password=$opts.password, profiles=$opts.profiles, tags=$opts.tags,
                           timeout=$opts.timeout, network=$opts.network, geolocation=$opts.geolocation,
                           apikey=$userKey()))
}

function submitUrl(url, opts) {
    return($svc.submitUrl($url, fetch=$opts.fetch, interactive=$opts.interactive, profiles=$opts.profiles,
                          tags=$opts.tags, timeout=$opts.timeout, network=$opts.network,
                          geolocation=$opts.geolocation, apikey=$userKey()))
}

function importSample(sample) { return($svc.importSample($sample, apikey=$userKey())) }

function setProfile(sample, profiles=(null), auto=(false), pick=(null)) {
    return($svc.setProfile($sample, profiles=$profiles, auto=$auto, pick=$pick, apikey=$userKey()))
}

function deleteSample(sample) { return($svc.deleteSample($sample, apikey=$userKey())) }
