init {
    $priv = $lib.import(slib.hatching.priv.user)
    $util = $lib.import(slib.hatching.util)

    $retn = $priv.profiles()
    if (not $util.failed($retn, "Listing profiles")) {
        $rows = ([])
        for $p in $retn.data {
            $rows.append(($p.name, $p.network, $p.geolocation, $p.timeout, (",").join($p.tags), $p.id))
        }
        $util.table((("name", 24), ("network", 10), ("geolocation", 12), ("timeout", 8), ("tags", 32), ("id", 36)), $rows)
    }
}
