init {
    $padmin = $lib.import(slib.hatching.priv.admin)
    $util = $lib.import(slib.hatching.util)

    $retn = $padmin.addUserKey($cmdopts.user, $cmdopts.name)
    if (not $util.failed($retn, `Adding API key {$cmdopts.name} for {$cmdopts.user}`)) {
        $key = $retn.data.key
        if ((not $cmdopts.show) and $key) { $key = `{$key.slice(0, 4)}... (use --show to print it all)` }
        $lib.print(`slib.hatching.admin.user.key.add: Created API key {$retn.data.name} for {$cmdopts.user}: {$key}`)
    }
}
