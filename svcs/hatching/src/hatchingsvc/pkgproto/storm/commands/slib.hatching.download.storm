init {
    $hatching = $lib.import(slib.hatching.lib)
    $priv = $lib.import(slib.hatching.priv.user)
    $model = $lib.import(slib.hatching.model)
    $util = $lib.import(slib.hatching.util)

    if ($cmdopts.file and (not $cmdopts.task)) {
        $lib.raise(BadArg, "slib.hatching.download: --file requires --task.")
    }

    // Download everything the options ask for from a sample. Returns a list of file:bytes nodes.
    function download(sample) {
        $nodes = ([])
        $any = (false)
        if $cmdopts.file {
            $any = (true)
            $nodes.append($hatching.downloadTaskFile($sample, $cmdopts.task, $cmdopts.file))
        }
        if $cmdopts.pcap {
            $any = (true)
            $nodes.extend($hatching.downloadPcaps($sample, task=$cmdopts.task))
        }
        if $cmdopts.pcapng {
            $any = (true)
            $nodes.extend($hatching.downloadPcaps($sample, task=$cmdopts.task, pcapng=(true)))
        }
        if $cmdopts.screenshot {
            $any = (true)
            $task = $cmdopts.task
            if (not $task) { $task = urlscan1 }
            $nodes.append($hatching.downloadTaskFile($sample, $task, "screenshot.png"))
        }
        if $cmdopts.archive {
            $any = (true)
            $nodes.append($hatching.downloadArchive($sample, fmt=$cmdopts.archive))
        }
        if $cmdopts.dumped {
            $any = (true)
            $nodes.extend($hatching.downloadDumped($sample))
        }
        if (not $any) { $nodes.append($hatching.downloadSample($sample)) }
        return($nodes)
    }

    // --sample is downloaded once here (init runs once per query), not once per inbound node.
    $made = ([])
    for $sid in $cmdopts.sample {
        for $n in $download($sid) {
            if $n { $made.append($n) }
        }
    }
}

if $cmdopts.sample {
    // Inbound nodes pass through, unless --yield replaces them with the downloaded files.
    if $cmdopts.yield { spin }  // noqa: P001
}
else {
    $hash = $util.nodeHash($node)
    if ($hash = null) {
        $lib.warn(`slib.hatching.download: {$node.form()} {$node.repr()} has no hash to find a sample by.`)
        spin  // noqa: P001 - drop the node it can't be used with
    }
    $retn = $priv.resolve($hash)
    if $util.failed($retn, `Finding the sample of {$hash}`) { spin }  // noqa: P001
    divert $cmdopts.yield $model.nodes($download($retn.data))
}

fini {
    if $cmdopts.yield { for $n in $made { yield $n } }
}
