init {
    $hatching = $lib.import(slib.hatching.lib)
    $model = $lib.import(slib.hatching.model)

    // --sample is modeled once here (init runs once per query), not once per inbound node.
    $made = ([])
    for $sid in $cmdopts.sample {
        $n = $hatching.model($sid, tasks=$cmdopts.tasks)
        if $n { $made.append($n) }
    }
}

if $cmdopts.sample {
    // Inbound nodes pass through, unless --yield replaces them with the samples' nodes.
    if $cmdopts.yield { spin }  // noqa: P001
}
else {
    switch $node.form() {
        "file:bytes": { }
        "hash:md5": { }
        "hash:sha1": { }
        "hash:sha256": { }
        "hash:sha512": { }
        "inet:url": { }
        *: {
            $lib.warn(`slib.hatching.enrich: The node form {$node.form()} is not supported.`)
            spin  // noqa: P001 - drop the node it can't be used with
        }
    }
    divert $cmdopts.yield $model.nodes(($hatching.enrich($node, tasks=$cmdopts.tasks),))
}

fini {
    if $cmdopts.yield { for $n in $made { yield $n } }
}
