init {
    $pman = $lib.import(slib.hatching.priv.manage)
    $util = $lib.import(slib.hatching.util)

    $tags = $lib.null
    if $cmdopts.tag { $tags = $cmdopts.tag }
    $retn = $pman.editProfile($cmdopts.profile, name=$cmdopts.name, tags=$tags, timeout=$cmdopts.timeout,
                              network=$cmdopts.network)
    if (not $util.failed($retn, `Editing profile {$cmdopts.profile}`)) {
        $p = $retn.data
        $lib.print("slib.hatching.profile.edit: Updated profile {name}: network={network} timeout={timeout} tags={tags}",
                   name=$p.name, network=$p.network, timeout=$p.timeout, tags=(",").join($p.tags))
    }
}
