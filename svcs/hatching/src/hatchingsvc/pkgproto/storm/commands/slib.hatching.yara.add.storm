init {
    $pman = $lib.import(slib.hatching.priv.manage)
    $util = $lib.import(slib.hatching.util)

    if ($cmdopts.rename and (not $cmdopts.name)) {
        $lib.raise(BadArg, "slib.hatching.yara.add: --rename requires --name.")
    }

    function add(name, text) {
        if ((not $name) or ((not $text) and (not $cmdopts.rename))) {
            $lib.warn("slib.hatching.yara.add: A rule needs a name and text.")
            return((false))
        }
        if $cmdopts.rename {
            $retn = $pman.renameRule($cmdopts.rename, $name, text=$text)
            if $util.failed($retn, `Renaming Yara rule {$cmdopts.rename}`) { return((false)) }
            $lib.print(`slib.hatching.yara.add: Renamed Yara rule {$cmdopts.rename} to {$name}.`)
            return((true))
        }
        if $cmdopts.update { $retn = $pman.editRule($name, $text) $verb = Updated }
        else { $retn = $pman.addRule($name, $text) $verb = Added }
        if $util.failed($retn, `Saving Yara rule {$name}`) { return((false)) }
        $lib.print(`slib.hatching.yara.add: {$verb} Yara rule {$name}.`)
        return((true))
    }

    // --name is saved once here (init runs once per query), not once per inbound node.
    if $cmdopts.name { $add($cmdopts.name, $cmdopts.text) }
}

// With --name, inbound nodes pass through untouched.
if (not $cmdopts.name) {
    if ($node.form() != "it:app:yara:rule") {
        $lib.warn(`slib.hatching.yara.add: The node form {$node.form()} is not supported.`)
        spin  // noqa: P001 - drop the node it can't be used with
    }
    else {
        $name = :name
        if ($name and (not $name.endswith(".yara"))) { $name = `{$name}.yara` }
        $add($name, :text)
    }
}
