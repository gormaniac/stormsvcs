init {
    $priv = $lib.import(slib.hatching.priv.user)
    $hatching = $lib.import(slib.hatching.lib)
    $util = $lib.import(slib.hatching.util)

    // Runs once per query (not once per inbound node).
    $made = ([])
    for $sample in $cmdopts.sample {
        $retn = $priv.wait($sample, timeout=$cmdopts.timeout)
        if (not $util.failed($retn, `Waiting for sample {$sample}`)) {
            $lib.print(`slib.hatching.sample.wait: Sample {$retn.data.id} is {$retn.data.status}.`)
            if (($cmdopts.model or $cmdopts.yield) and $retn.data.status = "reported") {
                $n = $hatching.model($retn.data.id, tasks=$cmdopts.tasks)
                if $n { $made.append($n) }
            }
        }
    }
}

// The work ran once in init. Inbound nodes pass through, unless --yield replaces them.
if $cmdopts.yield { spin }  // noqa: P001

fini {
    if $cmdopts.yield { for $n in $made { yield $n } }
}
