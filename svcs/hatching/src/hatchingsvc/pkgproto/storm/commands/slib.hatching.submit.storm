init {
    $hatching = $lib.import(slib.hatching.lib)
    $model = $lib.import(slib.hatching.model)

    $profiles = ([])
    for $p in $cmdopts.profile { $profiles.append($p) }
    $opts = ({
        "fetch": $cmdopts.fetch,
        "interactive": $cmdopts.interactive,
        "password": $cmdopts.password,
        "profiles": $profiles,
        "tags": $cmdopts.tag,
        "timeout": $cmdopts.timeout,
        "network": $cmdopts.network,
        "geolocation": $cmdopts.geolocation,
        "name": $cmdopts.name,
        "wait": $cmdopts.wait,
        "tasks": $cmdopts.tasks,
    })

    function asNode(valu) {
        if ($lib.vars.type($valu) = "node") { return($valu) }
        return()
    }

    // --url is submitted once here (init runs once per query), not once per inbound node.
    $made = ([])
    for $url in $cmdopts.url {
        $n = $asNode($hatching.submitUrl($url, $opts))
        if $n { $made.append($n) }
    }
}

if $cmdopts.url {
    // Inbound nodes pass through, unless --yield replaces them with the samples' nodes.
    if $cmdopts.yield { spin }  // noqa: P001
}
else {
    switch $node.form() {
        "file:bytes": { }
        "inet:url": { }
        *: {
            $lib.warn(`slib.hatching.submit: The node form {$node.form()} is not supported.`)
            spin  // noqa: P001 - drop the node it can't be used with
        }
    }
    divert $cmdopts.yield $model.nodes(($asNode($hatching.submitNode($node, $opts)),))
}

fini {
    if $cmdopts.yield { for $n in $made { yield $n } }
}
