init {
    $padmin = $lib.import(slib.hatching.priv.admin)
    $util = $lib.import(slib.hatching.util)

    for $name in $cmdopts.name {
        $retn = $padmin.delUserKey($cmdopts.user, $name)
        if (not $util.failed($retn, `Deleting API key {$name} of {$cmdopts.user}`)) {
            $lib.print("slib.hatching.admin.user.key.del: Deleted API key {name} of {user}.", name=$name, user=$cmdopts.user)
        }
    }
}
