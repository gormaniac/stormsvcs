init {
    $padmin = $lib.import(slib.hatching.priv.admin)
    $util = $lib.import(slib.hatching.util)

    $retn = $padmin.addUser($cmdopts.login, password=$cmdopts.password, name=$cmdopts.name, role=$cmdopts.role,
                            confirmed=$cmdopts.confirmed)
    if (not $util.failed($retn, `Adding user {$cmdopts.login}`)) {
        $lib.print("slib.hatching.admin.user.add: Added user {login} ({id}) with the role {role}.",
                   login=$retn.data.email, id=$retn.data.id, role=$retn.data.role)
    }
}
