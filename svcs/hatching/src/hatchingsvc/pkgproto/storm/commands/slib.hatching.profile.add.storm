init {
    $pman = $lib.import(slib.hatching.priv.manage)
    $util = $lib.import(slib.hatching.util)

    $retn = $pman.addProfile($cmdopts.name, tags=$cmdopts.tag, timeout=$cmdopts.timeout, network=$cmdopts.network)
    if (not $util.failed($retn, `Adding profile {$cmdopts.name}`)) {
        $lib.print("slib.hatching.profile.add: Added profile {name} ({id}).", name=$retn.data.name, id=$retn.data.id)
    }
}
