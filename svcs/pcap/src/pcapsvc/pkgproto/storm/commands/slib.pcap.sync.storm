init {
    // The sync edits nodes as root in this view, and replaces the service's rules with this
    // view's, so only users that can add rules to the view's layer may run it here.
    $layer = $lib.layer.get().iden
    if (not ($lib.user.allowed("node.add.it:app:snort:rule", gateiden=$layer)
             and $lib.user.allowed("node.add.it:app:suricata:rule", gateiden=$layer))) {
        $lib.raise(AuthDeny, "slib.pcap.sync edits the rules in the current view, it needs permission to add it:app:snort:rule and it:app:suricata:rule nodes to its layer.")
    }
    $sync = $lib.import(slib.pcap.priv.sync)
    $util = $lib.import(slib.pcap.util)

    if (not $cmdopts.no_feeds) {
        $feeds = $util.data($sync.feeds(), "Listing the feeds")
        $wanted = $lib.set()
        for $name in $cmdopts.feed { $wanted.add($lib.cast(str, $name).lower()) }
        $found = $lib.set()

        for $feed in $feeds {
            if $wanted {
                if (not $wanted.has($feed.name)) { continue }
            } elif (not $feed.enabled) {
                continue
            }
            $found.add($feed.name)

            $s = $sync.syncFeed($feed, force=$cmdopts.force)
            if $s.error {
                $lib.warn("slib.pcap.sync: Syncing the {name} feed failed: {err}", name=$s.name, err=$s.error)
            } elif ($s.synced and $s.full) {
                $lib.print("slib.pcap.sync: {name}: synced {count} rules ({added} added, {updated} updated, {removed} removed).",
                    name=$s.name, count=$s.count, added=$s.added, updated=$s.updated, removed=$s.removed)
            } elif $s.synced {
                $lib.print("slib.pcap.sync: {name}: synced the feed's changes ({added} added, {updated} updated, {removed} removed), it has {count} rules.",
                    name=$s.name, count=$s.count, added=$s.added, updated=$s.updated, removed=$s.removed)
            } elif $s.pulled {
                $lib.print("slib.pcap.sync: {name}: downloaded, the feed is unchanged.", name=$s.name)
            } else {
                $lib.print("slib.pcap.sync: {name}: up to date (the feed isn't due to be downloaded yet).", name=$s.name)
            }
        }

        for $name in $wanted {
            if (not $found.has($name)) { $lib.warn("slib.pcap.sync: Unknown feed: {name}", name=$name) }
        }
    }

    if (not $cmdopts.no_push) {
        $summary = $util.data($sync.push(force=$cmdopts.force), "Pushing the rules to the service")
        if $summary { $util.printBuild("slib.pcap.sync", $summary) }
    }
}
