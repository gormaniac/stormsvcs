init {
    $pcap = $lib.import(slib.pcap.lib)
    $util = $lib.import(slib.pcap.util)

    $status = $pcap.status()
    if $status {
        for ($name, $eng) in $status.engines {
            if (not $eng.available) {
                $lib.print(`{$name}: not installed`)
            } elif (not $eng.enabled) {
                $lib.print(`{$name}: {$eng.version} (disabled by default)`)
            } else {
                $lib.print(`{$name}: {$eng.version}`)
            }
        }

        $sbx = $status.sandbox
        $lib.print(`Sandbox: {$sbx.mode}, engines run as {$sbx.uid}, Landlock ABI {$sbx.landlock}, seccomp {$sbx.seccomp}`)
        if $sbx.alerts {
            $lib.warn(`slib.pcap: The sandbox has {$sbx.alerts} alerts since the service started (an engine crashed, tried to open a socket, or got out of its sandbox). The latest:`)
            for $alert in $sbx.recent {
                $lib.warn(`    {$lib.time.format($alert.time, "%Y-%m-%d %H:%M:%S")} {$alert.engine} ({$alert.kind}): {$alert.detail}`)
            }
        } else {
            $lib.print("Sandbox alerts: none")
        }
        if $sbx.missing {
            $lib.warn(`slib.pcap: The host doesn't support these sandbox layers: {$lib.str.join(", ", $sbx.missing)}`)
        }

        if $status.axon {
            $lib.print("Axon: PCAPs are read from the Axon by the service, extracted files are saved to it.")
        } else {
            $lib.warn("slib.pcap: The service has no Axon (axon:url). PCAPs are streamed to it, and files extracted from flows can't be saved. Set axon:url to the Cortex's Axon.")
        }

        $rules = $status.rules
        $engines = ([])
        for ($engine, $count) in $rules.engines { $engines.append(`{$engine} {$count}`) }
        if (not $engines) { $engines.append("no engines") }
        $lib.print(`Rules: {$rules.loaded} loaded of {$rules.rules} pushed ({$lib.str.join(", ", $engines)}), {$rules.invalid} invalid`)
        $lib.print(`Last pushed: {$util.when($rules.pushed)}, last built: {$util.when($rules.built)}`)
        if $rules.building { $lib.print("The service is building its rules now.") }
        if $rules.error { $lib.warn(`slib.pcap: The last rule build failed: {$rules.error}`) }
    }

    $job = $pcap.schedule()
    if $job {
        $state = disabled
        if $job.enabled { $state = enabled }
        $lib.print(`Sync schedule: cron {$job.iden} ({$state}), last run: {$util.when($job.laststart)}`)
    } else {
        $lib.print("Sync schedule: none, see slib.pcap.admin.schedule.")
    }
}
