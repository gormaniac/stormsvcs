init {
    $privadmin = $lib.import(slib.pcap.priv.admin)
    $util = $lib.import(slib.pcap.util)
    $util.warnNoAxon("slib.pcap.admin.vars", $privadmin.hasAxon())

    $vars = ({})
    if (not $cmdopts.clear) {
        for ($name, $valu) in $privadmin.netVars() { $vars.$name = $valu }
    }
    $ok = (true)
    for $item in $cmdopts.set {
        $parts = $lib.cast(str, $item).split("=", maxsplit=1)
        if ($lib.len($parts) != 2) {
            $lib.warn("slib.pcap.admin.vars: Invalid --set {item}, use NAME=VALUE, ex. HOME_NET=[10.0.0.0/8].",
                item=$item)
            $ok = (false)
        } else {
            $vars.($parts.index(0).strip().upper()) = $parts.index(1).strip()
        }
    }
    for $name in $cmdopts.del { $vars.($lib.cast(str, $name).strip().upper()) = $lib.undef }

    if ($ok and ($cmdopts.set or $cmdopts.del or $cmdopts.clear)) {
        $retn = $privadmin.setNetVars($vars)
        if (not $retn.status) {
            $lib.warn("slib.pcap.admin.vars: {err}", err=$retn.mesg)
        }
    }

    $vars = $privadmin.netVars()
    if $vars {
        $lib.print("slib.pcap network variables for every run (over the service's config):")
        for ($name, $valu) in $vars { $lib.print("    {name} = {valu}", name=$name, valu=$valu) }
    } else {
        $lib.print("slib.pcap has no network variables for every run, the service's config (suricata:vars, snort:vars) is used.")
    }
}
