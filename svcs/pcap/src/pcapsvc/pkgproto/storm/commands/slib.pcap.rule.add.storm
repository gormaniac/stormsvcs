init {
    $priv = $lib.import(slib.pcap.priv.user)
    $rules = $lib.import(slib.pcap.priv.rules)
    $model = $lib.import(slib.pcap.model)
    $util = $lib.import(slib.pcap.util)

    // Check the view first, so no rule nodes are made when the push would be refused.
    $deny = $rules.denied()
    if $deny { $lib.warn(`slib.pcap.rule.add: {$deny} No rules were added.`) }

    $nodes = ([])
    $push = ([])
    $forms = ({})
    $dels = ([])
    if $deny { $texts = ([]) } else { $texts = $cmdopts.text }
    for $text in $texts {
        $r = $util.data($priv.ruleParse($text, engine=$cmdopts.engine), "Parsing the rule")
        if (not $r) { continue }

        $rule = $model.rule($r, enabled=(not $cmdopts.disabled))
        if $r.refs { $model.ruleRefs($rule, $r.refs) }
        $nodes.append($rule)

        if $cmdopts.disabled {
            $dels.append($rule.repr())
        } else {
            $forms.($rule.repr()) = $rule.form()
            $push.append(($rule.repr(), $rule.form(), $rule.props.text, $rule.props.engine))
        }
        $lib.print(`slib.pcap.rule.add: {$rule.form()}={$rule.repr()} (sid {$r.id}, rev {$r.rev}): {$r.msg}`)
    }

    if ($push or $dels) {
        $summary = $util.data($rules.update(rules=$push, dels=$dels), "Pushing the rules to the service")
        if $summary {
            $util.printBuild("slib.pcap.rule.add", $summary)
            for ($guid, $mesg) in $summary.errors {
                $lib.warn(`slib.pcap.rule.add: {$forms.$guid}={$guid} couldn't be loaded: {$mesg}`)
            }
        }
    }
}

// The nodes are yielded once, in the fini block (not once per inbound node), and the inbound
// nodes pass through without --yield.
-$cmdopts.yield

fini {
    if $cmdopts.yield {
        for $n in $model.nodes($nodes) { yield $n }
    }
}
