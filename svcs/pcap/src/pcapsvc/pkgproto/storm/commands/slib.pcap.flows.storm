init {
    $pcap = $lib.import(slib.pcap.lib)
    // null leaves it to the service's config.
    $optional = ({"tshark": $cmdopts.no_tshark, "suricata": $cmdopts.no_suricata,
                  "snort": $cmdopts.no_snort, "files": $cmdopts.no_files})
    $opts = ({"timeout": $cmdopts.timeout, "limit": $cmdopts.limit, "handshake": $cmdopts.handshake,
              "keylogs": $cmdopts.keylog, "decode": $cmdopts.decode_as, "rules": (not $cmdopts.no_rules),
              "tag": $cmdopts.tag, "host": $cmdopts.host, "sandbox": $cmdopts.sandbox_file})
    for ($name, $off) in $optional {
        $opts.$name = (null)
        if $off { $opts.$name = (false) }
    }
    $yieldit = $cmdopts.yield
}

if $cmdopts.sha256s {
    // SHA-256s ignore inbound nodes, spin drops them on purpose (P001 is ignored).
    // NOTE: $node.form is a gtor in Synapse 3.x, 2.x needs the call, this package requires
    // Synapse <3.0.0 so R002 is ignored here and in the slib.pcap.rule.* commands.
    spin |  // noqa: P001
    for $sha256 in $cmdopts.sha256s {
        for $n in $pcap.ingest($sha256, opts=$opts, hits=$cmdopts.hits) {
            yield $n
        }
    }
}
else {
    if ($node.form() = "file:bytes" and :sha256) {  // noqa: R002
        divert $yieldit $pcap.nodes($pcap.ingest(:sha256, opts=$opts, file=$node, hits=$cmdopts.hits))
    } else {
        $lib.warn(`slib.pcap.flows: Unable to analyze {$node.form()} {$node.repr()}, it needs to be a file:bytes with a :sha256.`)  // noqa: R002
        // Drop the node that can't be analyzed.
        spin  // noqa: P001
    }
}
