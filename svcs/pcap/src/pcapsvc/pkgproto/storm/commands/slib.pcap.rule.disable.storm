init {
    $rules = $lib.import(slib.pcap.priv.rules)
    $util = $lib.import(slib.pcap.util)
    // Check the view first, so rules aren't edited when the push would be refused.
    $deny = $rules.denied()
    if $deny { $lib.warn(`slib.pcap.rule.disable: {$deny} The rules weren't changed.`) }
    $dels = ([])
}

$form = $node.form()  // noqa: R002
if (not $deny and ($form = "it:app:snort:rule" or $form = "it:app:suricata:rule")) {
    [ :enabled=(false) ]
    $dels.append($node.repr())
}

fini {
    if $dels {
        $summary = $util.data($rules.update(dels=$dels), "Removing the rules from the service")
        if $summary { $util.printBuild("slib.pcap.rule.disable", $summary) }
    }
}
