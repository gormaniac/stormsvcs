// Privileged (asroot) wrappers around the slib.pcap service, the sync cron job, and the
// Decode As rules for every run, for slib.pcap.admin.
//
// NOTE: $lib.globals.get()/set() and $lib.cron.enable()/disable() are removed in Synapse 3.x,
// but 2.x has no $lib.globals.<name> (and these names have colons) and its $lib.cron.mod() can't
// enable a job. This package requires Synapse <3.0.0 so R005 is ignored here.

init {
    $svc = $lib.service.get("slib.pcap")
    $cronglobal = "slib:pcap:cron"
}


function hasAxon() { return($svc.hasAxon()) }
function feedAdd(fdef) { return($svc.feedAdd($fdef)) }
function feedDel(name) { return($svc.feedDel($name)) }
function feedEnable(name, enabled=(true)) { return($svc.feedEnable($name, enabled=$enabled)) }

// The sync cron job, or null if there isn't one.
function cron() {
    $iden = $lib.globals.get($cronglobal)  // noqa: R005
    if (not $iden) { return() }
    try {
        return($lib.cron.get($iden))
    } catch (NoSuchIden, StormRuntimeError) as err {
        return()
    }
}

// Replace the sync cron job with one on a new schedule (a cron.add --period), in the current view.
// The job runs as the calling user (not root), so slib.pcap.sync checks their permissions.
function schedule(period) {
    $old = $cron()
    $new = $lib.cron.add(query="slib.pcap.sync", period=$period)
    // The current user is still the caller in this asroot module, set it explicitly anyway.
    $new.set(creator, $lib.auth.users.get().iden)
    $new.set(name, "slib.pcap.sync")
    $new.set(doc, "Sync the slib.pcap rule feeds into the Cortex and push the enabled it:app:snort:rule and it:app:suricata:rule nodes to the slib.pcap service.")
    $lib.globals.set($cronglobal, $new.iden)  // noqa: R005
    // The service's rules now come from this view (see slib.pcap.priv.sync.rulesView).
    $lib.globals.set("slib:pcap:rules:view", $lib.view.get().iden)  // noqa: R005
    if $old { $lib.cron.del($old.iden) }
    return($new)
}

function enable(enabled=(true)) {
    $job = $cron()
    if (not $job) { return() }
    if $enabled { $lib.cron.enable($job.iden) }  // noqa: R005
    else { $lib.cron.disable($job.iden) }  // noqa: R005
    return($lib.cron.get($job.iden))
}

function decodeDefaults() {
    $rules = $lib.globals.get("slib:pcap:decode")  // noqa: R005
    if ($rules = null) { return(([])) }
    return($rules)
}

// The network variables (ex. HOME_NET) both engines use for every run, {name: address group}.
function netVars() {
    $vars = $lib.globals.get("slib:pcap:vars")  // noqa: R005
    if ($vars = null) { return(({})) }
    return($vars)
}

// Validate and save the network variables. Returns the service's retn.
function setNetVars(vars) {
    $retn = $svc.checkNetVars($vars)
    if $retn.status { $lib.globals.set("slib:pcap:vars", $retn.data) }  // noqa: R005
    return($retn)
}

// Validate and save the Decode As rules used for every run. Returns the service's retn.
function setDecodeDefaults(rules) {
    $retn = $svc.checkDecodeAs($rules)
    if $retn.status { $lib.globals.set("slib:pcap:decode", $retn.data) }  // noqa: R005
    return($retn)
}
