// Model what the slib.pcap service finds (see pcapsvc.flows.Flow.asdict, pcapsvc.enrich, and
// pcapsvc.feeds.ruleRecord) in Synapse: flows, rule matches, DNS, and rules.
//
// Node edits here run as the calling user (or as root, when called by slib.pcap.priv.sync).
// Every flow and match is linked to the slib.pcap meta:source node with a -(seen)> edge.

init {
    $sourceGuid = "cae9b5f5923a48b9a1a691f851a77429"
}

// ---- Helpers ----
//
// NOTE: A for loop that runs while a node is in a function's pipeline sends the node
// downstream after its first iteration, reaching return() and ending the function early.
// So functions that loop never have a node in their pipeline, they call helpers that
// yield and edit the node in their own runtime instead.

function setProp(n, prop, valu) {
    yield $n
    [ :$prop ?= $valu ]
    return($node)
}

// Add a value to an array prop, skipping values that don't norm.
function addValu(n, prop, valu) {
    yield $n
    [ :$prop ?+= $valu ]
    return($node)
}

function addValus(n, prop, valus) {
    for $valu in $valus { $addValu($n, $prop, $valu) }
    return($n)
}

function refs(n, other) {
    yield $n
    [ +(refs)> { yield $other } ]
    return($node)
}

// Link a node to an inet:fqdn with a -(refs)> edge, skipping values that aren't FQDNs.
function refsFqdn(n, fqdn) {
    yield $n
    [ +(refs)> { [ inet:fqdn ?= $fqdn ] } ]
    return($node)
}

// ---- Nodes ----

// The file:bytes node for a PCAP's SHA-256, created if needed.
function fileNode(sha256) {
    [ file:bytes=$sha256 ]
    return($node)
}

// The inet:flow:from guid shared by every flow from a PCAP.
function fromGuid(sha256) {
    return($lib.guid(slib.pcap, pcap, $sha256))
}

// A file the service extracted into the Axon (see pcapsvc.enrich.Enricher._file).
function txFileNode(t) {
    [ file:bytes=$t.sha256 :size=$t.size ]
    if ($t.mime and not :mime) { [ :mime ?= $t.mime ] }
    return($node)
}

// The file:attachment for a file sent in a flow, unique to the flow, side, file, and name.
function attachmentNode(flowIden, side, t) {
    $file = $txFileNode($t)
    [ file:attachment=$lib.guid(slib.pcap, attachment, $flowIden, $side, $t.sha256, $t.name)
        :file=$file
        :name ?= $t.name
        :text ?= $t.text
    ]
    return($node)
}

// A crypto:x509:cert from a TLS handshake (see pcapsvc.x509.parseCert), deconflicted by
// SHA-256 like slib.crtsh models them.
function certNode(c) {
    [ crypto:x509:cert=({"sha256": $c.sha256}) ]
    [
        :sha1 = $c.sha1
        :md5 = $c.md5
        :file = `sha256:{$c.sha256}`
    ]
    if (not $c.error) {
        [
            :serial ?= $c.serial
            :version ?= $c.version
            :subject ?= $c.subject
            :issuer ?= $c.issuer
            :validity:notbefore ?= $c.notbefore
            :validity:notafter ?= $c.notafter
            :algo ?= $c.algo
            :signature ?= $c.signature
            :selfsigned = $c.selfsigned
        ]
        if $c.pubkey.rsa { [ :rsa:key ?= ($c.pubkey.rsa.mod, $c.pubkey.rsa.exp) ] }
    }
    return($node)
}

function cert(c) {
    $n = $certNode($c)
    if $c.error { return($n) }
    $addValus($n, "ext:sans", $c.sans)
    $addValus($n, "identities:fqdns", $c.identities.fqdns)
    $addValus($n, "identities:emails", $c.identities.emails)
    $addValus($n, "identities:ipv4s", $c.identities.ipv4s)
    $addValus($n, "identities:ipv6s", $c.identities.ipv6s)
    $addValus($n, "identities:urls", $c.identities.urls)
    return($n)
}

// An SSH public key (see pcapsvc.enrich.sshKey), deconflicted by the SHA-256 of its blob.
function sshKeyNode(k) {
    [ crypto:key=({"public:sha256": $k.sha256})
        :algorithm ?= $k.algo
        :public ?= $k.blob
        :public:sha1 ?= $k.sha1
        :public:md5 ?= $k.md5
    ]
    return($node)
}

// ---- Flows ----

// Set the packet level props for one side (src or dst) of a flow.
function side(n, name, s, proto) {
    $txcount = `{$name}:txcount`
    $txbytes = `{$name}:txbytes`
    $protoprop = `{$name}:proto`
    $port = `{$name}:port`
    $handshake = `{$name}:handshake`
    if ($s.ip.find(":") = $lib.null) { $ip = `{$name}:ipv4` } else { $ip = `{$name}:ipv6` }
    yield $n
    [
        :$txcount=$s.pkts
        :$txbytes=$s.bytes
        :$ip=$s.ip
        :$protoprop ?= $proto
        :$port ?= $s.port
        :$handshake ?= $s.handshake
    ]
    return($node)
}

// Model what tshark found for one side (src or dst) of a flow.
function enrichSide(n, name, s) {
    if $s."ssl:cert" {
        $leaf = $cert($s."ssl:cert")
        $setProp($n, `{$name}:ssl:cert`, $leaf.value())
        // The rest of the chain the side sent.
        for $c in $s."ssl:certs" { $refs($n, $cert($c)) }
    }
    if $s."ssh:key" {
        $setProp($n, `{$name}:ssh:key`, $sshKeyNode($s."ssh:key").value())
    }
    if $s."rdp:hostname" { $setProp($n, `{$name}:rdp:hostname`, $s."rdp:hostname") }
    if $s."rdp:keyboard:layout" {
        $setProp($n, `{$name}:rdp:keyboard:layout`, $s."rdp:keyboard:layout")
    }
    $addValus($n, `{$name}:softnames`, $s.softnames)
    $addValus($n, `{$name}:cpes`, $s.cpes)
    for $t in $s.txfiles {
        $addValu($n, `{$name}:txfiles`, $attachmentNode($n.value(), $name, $t).value())
    }
    return($n)
}

// The inet:flow node with its packet level props.
function flowNode(f, file, opts) {
    $sha256 = $file.props.sha256
    [ inet:flow=$f.iden
        :time=$f.time
        :duration=$f.duration
        :from=$fromGuid($sha256)
        :ip:proto=$f.ipproto
        :tot:txcount=$f.pkts
        :tot:txbytes=$f.bytes
        :ip:tcp:flags ?= $f."tcp:flags"
        :raw=$f
        .seen=($f.time, $f.last)
        <(seen)+ { [ meta:source=$sourceGuid :name="slib.pcap" ] }
        <(refs)+ { yield $file }
    ]
    $side($node, src, $f.src, $f.proto)
    $side($node, dst, $f.dst, $f.proto)
    if $f.src.addr { [ :src=$f.src.addr ] }
    if $f.dst.addr { [ :dst=$f.dst.addr ] }
    if $opts.host { [ :capture:host=$opts.host ] }
    if $opts.sandbox { [ :sandbox:file=$opts.sandbox ] }
    if $opts.tag { [ +#$opts.tag ] }
    return($node)
}

// Create (or update) the inet:flow node for a flow, with everything tshark found, and return it.
//
// f is a flow from the service, file is the PCAP's file:bytes node, and opts may have a "tag"
// to add, a "host" (it:host) to set as the :capture:host, and a "sandbox" (file:bytes) to set
// as the :sandbox:file.
function flow(f, file, opts=$lib.null) {
    if ($opts = $lib.null) { $opts = ({}) }
    $n = $flowNode($f, $file, $opts)
    $enrichSide($n, src, $f.src)
    $enrichSide($n, dst, $f.dst)
    if $f.tls {
        // The server names clients asked for.
        for $sni in $f.tls.sni { $refsFqdn($n, $sni) }
    }
    if $f.dns { $dns($n, $f, $opts) }
    $hits = ([])
    for $h in $f.hits { $hits.append($hit($n, $f, $h, $file, $opts)) }
    return(({"flow": $n, "hits": $hits}))
}

// ---- Rule matches ----

function _hitEnds(n, f) {
    yield $n
    if ($f.version = 6) {
        [ :src:ipv6=$f.src.ip :dst:ipv6=$f.dst.ip ]
    } else {
        [ :src:ipv4=$f.src.ip :dst:ipv4=$f.dst.ip ]
    }
    [ :src:port?=$f.src.port :dst:port?=$f.dst.port :src?=$f.src.addr :dst?=$f.dst.addr ]
    return($node)
}

// A rule match on a flow: an it:app:snort:hit (Snort rules) or it:app:suricata:matched
// (Suricata rules), unique to the engine, flow, and rule.
function hit(flownode, f, h, file, opts) {
    $guid = $lib.guid(slib.pcap.hit, $h.engine, $f.iden, $h.rule)
    if ($h.engine = "suricata") {
        [ it:app:suricata:matched=$guid :rule=$h.rule :target=$flownode ]
    } else {
        [ it:app:snort:hit=$guid :rule=$h.rule :flow=$flownode ]
        $_hitEnds($node, $f)
    }
    [ :version?=$lib.cast(str, $h.rev) ]
    if $h.time { [ :time=$h.time .seen=$h.time ] }
    if $h.last { [ .seen=$h.last ] }
    if $opts.host { [ :sensor=$opts.host ] }
    [ <(seen)+ { meta:source=$sourceGuid } <(refs)+ { yield $file } ]
    return($node)
}

// ---- DNS ----

function _dnsAnswer(req, a) {
    [ inet:dns:answer=$lib.guid(slib.pcap.dns.answer, $req.repr(), $a.rrname, $a.rrtype, $a.rdata)
        :request=$req
        :ttl?=$a.ttl
    ]
    switch $a.rrtype {
        "A": { [ :a?=($a.rrname, $a.rdata) ] }
        "AAAA": { [ :aaaa?=($a.rrname, $a.rdata) ] }
        "CNAME": { [ :cname?=($a.rrname, $a.rdata) ] }
        "NS": { [ :ns?=($a.rrname, $a.rdata) ] }
        "MX": { [ :mx?=($a.rrname, $a.rdata) ] }
        "TXT": { [ :txt?=($a.rrname, $a.rdata) ] }
    }
    return($node)
}

// An inet:dns:request for a DNS query (by transaction ID and name) in a flow, with its answers.
function _dnsRequest(flownode, f, q, opts) {
    $types = ({"A": 1, "NS": 2, "CNAME": 5, "SOA": 6, "PTR": 12, "MX": 15, "TXT": 16,
               "AAAA": 28, "SRV": 33, "HTTPS": 65, "SVCB": 64, "ANY": 255})
    $qtype = $types.($q.rrtype)
    [ inet:dns:request=$lib.guid(slib.pcap.dns, $f.iden, $q.id, $q.rrname, $q.rrtype)
        :query:name?=$q.rrname
        :time?=$q.time
        :server?=$f.dst.addr
        :sandbox:file?=$opts.sandbox
    ]
    if ($qtype != $lib.null) { [ :query:type=$qtype ] }
    if ($f.src.addr and $q.rrname and $qtype != $lib.null) {
        [ :query?=($f.src.addr, $q.rrname, $qtype) ]
    }
    if ($q.rcode != $lib.null) { [ :reply:code?=$q.rcode ] }
    [ <(refs)- { yield $flownode } ]
    return($node)
}

// Model a flow's DNS queries (see pcapsvc.eve.dnsQueries).
function dns(flownode, f, opts) {
    for $q in $f.dns {
        $req = $_dnsRequest($flownode, $f, $q, $opts)
        for $a in $q.answers { $_dnsAnswer($req, $a) }
    }
    return()
}

// ---- Rules ----

// Create or update a rule node from a parsed rule (the service's ruleParse or a feed's rule
// record): an it:app:snort:rule (Snort 2.x and 3 rules) or it:app:suricata:rule.
// enabled is only set when it isn't null.
function rule(r, enabled=$lib.null) {
    if ($r.form = "it:app:suricata:rule") {
        [ it:app:suricata:rule=$r.guid ]
    } else {
        $engines = ({"snort2": 2, "snort3": 3})
        [ it:app:snort:rule=$r.guid :engine=$engines.($r.engine) :family?=$r.family ]
    }
    [
        :id=$r.id
        :text=$r.text
        :version=$lib.cast(str, $r.rev)
        :name?=$r.msg
        :created?=$r.created
        :updated?=$r.updated
    ]
    if ($enabled != $lib.null) { [ :enabled=$enabled ] }
    return($node)
}

// Link a rule to one of its references: the CVE it detects, or the URL or hash it refers to.
function _ref(rule, scheme, valu) {
    yield $rule
    switch $scheme {
        "cve": {
            $cve = $lib.cast(str, $valu).lower()
            if (not $cve.startswith("cve-")) { $cve = `cve-{$cve}` }
            [ +(detects)> { [ it:sec:cve?=$cve ] } ]
        }
        "url": {
            $url = $lib.cast(str, $valu)
            if (not $lib.regex.matches("^[a-zA-Z][a-zA-Z0-9+.-]*://", $url)) { $url = `http://{$url}` }
            [ +(refs)> { [ inet:url?=$url ] } ]
        }
        "md5": { [ +(refs)> { [ hash:md5?=$valu ] } ] }
        "sha256": { [ +(refs)> { [ hash:sha256?=$valu ] } ] }
    }
    return($rule)
}

// Link a rule to its references, a list of (scheme, value).
function ruleRefs(rule, refs) {
    for ($scheme, $valu) in $refs {
        $_ref($rule, $scheme, $valu)
    }
    return($rule)
}

// ---- Generators ----

// Yield every node in a list.
function nodes(items) {
    for $item in $items {
        if $item { yield $item }
    }
}

// Yield the rule nodes (either form) with these guids (that exist).
function rules(guids) {
    if (not $guids) { stop }
    // One pipeline, a second for loop would run once per node the first one lifted.
    it:app:snort:rule*in=$guids it:app:suricata:rule*in=$guids
    emit $node
}

// Yield the meta:ruleset nodes with these guids (that exist).
function rulesets(guids) {
    for $guid in $guids {
        meta:ruleset=$guid
        emit $node
    }
}
