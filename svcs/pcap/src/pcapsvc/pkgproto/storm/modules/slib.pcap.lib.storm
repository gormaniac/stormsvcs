// Analyze PCAPs in the Axon with the slib.pcap service and model their flows.

init {
    $priv = $lib.import(slib.pcap.priv)
    $model = $lib.import(slib.pcap.model)
}

// Normalize a SHA-256 (or a file:bytes sha256:<sha256> value) to a lowercase hex string.
function normSha256(valu) {
    $valu = $lib.cast(str, $valu).strip().lower()
    if $valu.startswith("sha256:") { $valu = $valu.slice(7) }
    return($valu)
}

// Emit the inet:flow nodes for every flow in a PCAP, modeling them as needed.
//
// file is the PCAP's file:bytes node (created from the SHA-256 if null). opts may have a
// "tag" to add to every flow and a "host" (it:host) to set as their :capture:host.
//
// Raises slib.pcap.Error if the PCAP can't be read (ex. it isn't in the Axon).
function flows(sha256, timeout=$lib.null, limit=$lib.null, handshake=$lib.null, file=$lib.null,
               opts=$lib.null) {
    $sha256 = $normSha256($sha256)
    for $retn in $priv.flows($sha256, timeout=$timeout, limit=$limit, handshake=$handshake) {
        if (not $retn.status) { $lib.raise(slib.pcap.Error, $retn.mesg, sha256=$sha256) }
        if $retn.data.summary {
            // Only create the file:bytes node once the service has read the PCAP.
            if (not $file) { $file = $model.fileNode($sha256) }
        } else {
            emit $model.flow($retn.data.flow, $file, opts=$opts)
        }
    }
}

// The same as flows(), but for user facing code: it warns instead of raising, and prints
// a summary of the PCAP (or more details with $lib.debug).
function ingest(sha256, timeout=$lib.null, limit=$lib.null, handshake=$lib.null, file=$lib.null,
                opts=$lib.null) {
    $sha256 = $normSha256($sha256)
    $summary = $lib.null
    $count = (0)
    for $retn in $priv.flows($sha256, timeout=$timeout, limit=$limit, handshake=$handshake) {
        if (not $retn.status) {
            $lib.warn("slib.pcap: Unable to analyze {sha256}: {err}", sha256=$sha256,
                      err=$retn.mesg)
            stop
        }
        if $retn.data.summary {
            $summary = $retn.data.summary
            if (not $file) { $file = $model.fileNode($sha256) }
        } else {
            $count = ($count + 1)
            emit $model.flow($retn.data.flow, $file, opts=$opts)
        }
    }

    if (not $summary) { stop }

    $lib.print("slib.pcap: Modeled {count} flows from {packets} packets in file:bytes={file}",
               count=$count, packets=$summary.packets, file=$file.repr())
    if $summary.truncated {
        $lib.warn("slib.pcap: {sha256} is truncated, read up to the error: {err}",
                  sha256=$sha256, err=$summary.error)
    }
    if $summary.limited {
        $lib.warn("slib.pcap: {sha256} has more than {count} flows, {dropped} packets for the rest were dropped.",
                  sha256=$sha256, count=$count, dropped=$summary.dropped)
    }
    if $lib.debug {
        $lib.print("slib.pcap: {sha256} summary: {summary}", sha256=$sha256,
                   summary=$lib.json.save($summary))
    }
}

// Yield the nodes a generator emits, so divert can use them.
function nodes(items) {
    for $item in $items { yield $item }
}
