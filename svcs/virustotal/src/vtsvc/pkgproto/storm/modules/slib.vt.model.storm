// Model normalized VirusTotal objects (see vtsvc.norm) in Synapse.
//
// Node edits here run as the calling user. Every node created is linked to the virustotal
// meta:source with a -(seen)> edge.
//
// NOTE: A for loop that runs while a node is in a function's pipeline sends the node
// downstream after its first iteration, reaching return() and ending the function early. So
// functions here only yield a node when they don't loop, and loops call helpers that
// yield/edit the node in their own runtime instead.

init {
    $srcguid = "176fcd24cf1f42bfa5d95a013eec1487"
    $scanner = virustotal
    // The tag prefix (null when tagging is disabled), set by slib.vt.lib with setPrefix().
    $state = ({"prefix": $lib.null})
}

function setPrefix(prefix) {
    $state.prefix = $prefix
    return($prefix)
}

// ---- Generic helpers, each returns a single node (or null) ----

function seen(n) {
    if ($n = $lib.null) { return($n) }
    yield $n
    [ <(seen)+ { meta:source=$srcguid } ]
    return($n)
}

function edge(n, verb, m) {
    if ($n = $lib.null or $m = $lib.null) { return($n) }
    yield $n
    [ +($verb)> $m ]
    return($n)
}

function addTag(n, tagname) {
    if ($n = $lib.null) { return($n) }
    yield $n
    [ +?#$tagname ]
    return($n)
}

function delTag(n, tagname) {
    if ($n = $lib.null) { return($n) }
    yield $n
    [ -#$tagname ]
    return($n)
}

// Apply VirusTotal tags (relative to the prefix, see norm.objTags), replacing the verdict tag.
function tags(n, vtags) {
    if ($state.prefix = $lib.null or $n = $lib.null) { return($n) }
    $delTag($n, `{$state.prefix}.verdict`)
    for $t in $vtags { $addTag($n, `{$state.prefix}.{$t}`) }
    return($n)
}

function setSeen(n, time) {
    if ($n = $lib.null or $time = $lib.null) { return($n) }
    yield $n
    [ .seen ?= $time ]
    return($n)
}

function contact(name) {
    if (not $name) { return($lib.null) }
    [ ps:contact?=$lib.guid(slib.vt, contact, $name) :name?=$name ]
    return($seen($node))
}

// ---- Simple nodes ----

function fqdnNode(fqdn) {
    if (not $fqdn) { return($lib.null) }
    [ inet:fqdn?=$fqdn ]
    return($seen($node))
}

function ipNode(ip) {
    if (not $ip) { return($lib.null) }
    ($ok, $v4) = $lib.trycast(inet:ipv4, $ip)
    if $ok { [ inet:ipv4=$v4 ] }
    else { [ inet:ipv6?=$ip ] }
    return($seen($node))
}

function urlNode(url) {
    if (not $url) { return($lib.null) }
    [ inet:url?=$url ]
    return($seen($node))
}

function serverNode(server) {
    if (not $server) { return($lib.null) }
    [ inet:server?=$server ]
    return($seen($node))
}

function sha256Node(sha256) {
    if (not $sha256) { return($lib.null) }
    [ file:bytes?=`sha256:{$sha256}` :sha256?=$sha256 ]
    return($seen($node))
}

function dnsNode(fqdn, rtype, valu, time=$lib.null, email=$lib.null) {
    switch $rtype {
        A: { [ inet:dns:a?=($fqdn, $valu) ] }
        AAAA: { [ inet:dns:aaaa?=($fqdn, $valu) ] }
        CNAME: { [ inet:dns:cname?=($fqdn, $valu) ] }
        MX: { [ inet:dns:mx?=($fqdn, $valu) ] }
        NS: { [ inet:dns:ns?=($fqdn, $valu) ] }
        TXT: { [ inet:dns:txt?=($fqdn, $valu) ] }
        SOA: { [ inet:dns:soa?=$lib.guid(slib.vt, soa, $fqdn, $valu, $email) :fqdn?=$fqdn :ns?=$valu :email?=$email ] }
        *: { return($lib.null) }
    }
    if $time { [ .seen ?= $time ] }
    return($seen($node))
}

// The node a normalized object is about, without modeling anything else.
function objNode(obj) {
    switch $obj.type {
        file: { return($sha256Node($obj.sha256)) }
        domain: { return($fqdnNode($obj.fqdn)) }
        ip_address: { return($ipNode($obj.ip)) }
        url: { return($urlNode($obj.url)) }
    }
    return($lib.null)
}

// The it:av:scan:result target prop for a node.
function targetProp(n) {
    switch $n.form() {
        "file:bytes": { return("target:file") }
        "inet:fqdn": { return("target:fqdn") }
        "inet:ipv4": { return("target:ipv4") }
        "inet:ipv6": { return("target:ipv6") }
        "inet:url": { return("target:url") }
    }
    return($lib.null)
}

// ---- Scans ----

// The overall multi-engine scan as an it:av:scan:result, with an it:av:scan:result per
// engine (engines is detected, all, or none) under it with :multi:scan. Returns the overall one.
function scan(n, scan, engines=detected, signame=$lib.null, categories=$lib.null) {
    if ($n = $lib.null or $scan = $lib.null) { return($lib.null) }
    $prop = $targetProp($n)
    if ($prop = $lib.null) { return($lib.null) }
    $time = $scan.time
    if ($time = $lib.null) { $time = latest }

    $c = $scan.counts
    if ($c = $lib.null) { $c = ({}) }
    $top = $scanNode($n, $prop, $time, $scan, $c, $signame, $categories)

    if ($engines = "none") { return($top) }
    for $eng in $scan.engines {
        if ($engines = "all" or $eng.verdict >= 30) { $engineNode($n, $prop, $time, $top, $eng) }
    }
    return($top)
}

function scanNode(n, prop, time, scan, c, signame, categories) {
    [ it:av:scan:result=$lib.guid(slib.vt, scan, $n.form(), $n.repr(), $time)
        :scanner:name=$scanner :$prop=$n.repr() :time?=$scan.time :verdict?=$scan.verdict
        :signame?=$signame :categories?=$categories
        :multi:count?=$c.total :multi:count:malicious?=$c.malicious
        :multi:count:suspicious?=$c.suspicious :multi:count:benign?=$c.benign
        :multi:count:unknown?=$c.unknown ]
    return($seen($node))
}

function engineNode(n, prop, time, top, eng) {
    [ it:av:scan:result=$lib.guid(slib.vt, scan, $n.form(), $n.repr(), $time, $eng.name)
        :scanner:name?=$eng.name :$prop=$n.repr() :time?=$top.props.time :verdict?=$eng.verdict
        :signame?=$eng.signame :multi:scan=$top ]
    return($seen($node))
}

// ---- Files ----

// Model a normalized file (norm.normFile). Returns its file:bytes node.
function file(f, engines=detected) {
    $n = $fileNode($f)
    if ($n = $lib.null) { return($n) }
    $tags($n, $f.vtags)
    $scan($n, $f.scan, $engines, $f.threat.label, $f.threat.categories)
    for $sb in $f.sandboxes { $sandbox($n, $f.sha256, $sb) }
    for $r in $f.yara { $yara($n, $r) }
    for $r in $f.ids { $ids($n, $r) }
    for $r in $f.sigma { $sigma($n, $r) }
    return($n)
}

function fileNode(f) {
    if (not $f.sha256) { return($lib.null) }
    [ file:bytes=`sha256:{$f.sha256}`
        :sha256=$f.sha256 :md5?=$f.md5 :sha1?=$f.sha1 :size?=$f.size :name?=$f.name
        :mime:pe:imphash?=$f.imphash :mime:pe:compiled?=$f.compiled ]
    if $f.ssdeep { [ :ssdeeps?+=$f.ssdeep ] }
    if $f.first_seen { [ .seen ?= $f.first_seen ] }
    if $f.last_seen { [ .seen ?= $f.last_seen ] }
    return($seen($node))
}

function sandbox(n, sha256, sb) {
    $cats = $lib.null
    if $sb.categories { $cats = $sb.categories }
    [ it:av:scan:result=$lib.guid(slib.vt, sandbox, $sha256, $sb.name)
        :scanner:name?=$sb.name :target:file=$n :verdict?=$sb.verdict :signame?=$sb.signame
        :categories?=$cats ]
    return($seen($node))
}

function yara(n, r) {
    $rule = $yaraRule($r)
    [ it:app:yara:match=($rule, $n) ]
    if $r.time { [ .seen ?= $r.time ] }
    return($seen($node))
}

function yaraRule(r) {
    $author = $contact($r.author)
    [ it:app:yara:rule=$lib.guid(slib.vt, yara, $r.ruleset_id, $r.name)
        :name=$r.name :ext:id?=$r.ruleset_id :url?=$r.url ]
    if $author { [ :author=$author ] }
    return($seen($node))
}

function ids(n, r) {
    $id = $r.id
    if ($id = $lib.null) { $id = $r.name }
    [ it:app:snort:rule=$lib.guid(slib.vt, ids, $id)
        :id?=$r.id :name?=$r.name :desc?=$r.category :text?=$r.text ]
    $rule = $seen($node)
    return($edge($rule, matches, $n))
}

function sigma(n, r) {
    $author = $contact($r.author)
    [ it:app:sigma:rule=$lib.guid(slib.vt, sigma, $r.id) :id=$r.id :name?=$r.name :desc?=$r.desc ]
    if $author { [ :author=$author ] }
    $rule = $seen($node)
    return($edge($rule, matches, $n))
}

// Model a file's normalized behaviour summary (norm.normBehaviour) on its file:bytes node.
function behaviour(n, b) {
    if ($n = $lib.null or $b = $lib.null) { return($n) }
    $tags($n, $b.vtags)
    for $d in $b.dns {
        $fqdn = $fqdnNode($d.fqdn)
        $edge($n, refs, $fqdn)
        for $ip in $d.ips { $resolved($d.fqdn, $ip) }
    }
    for $t in $b.traffic { $edge($n, refs, $serverNode($t.server)) }
    for $h in $b.http { $edge($n, refs, $urlNode($h.url)) }
    for $tid in $b.techniques { $edge($n, uses, $techniqueNode($tid)) }
    for $m in $b.mutexes { $edge($n, refs, $mutexNode($m)) }
    for $d in $b.dropped { $edge($n, refs, $sha256Node($d.sha256)) }
    return($n)
}

function resolved(fqdn, ip) {
    ($ok, $v4) = $lib.trycast(inet:ipv4, $ip)
    if $ok { return($dnsNode($fqdn, A, $v4)) }
    return($dnsNode($fqdn, AAAA, $ip))
}

function techniqueNode(tid) {
    [ it:mitre:attack:technique?=$tid ]
    return($seen($node))
}

function mutexNode(name) {
    [ it:dev:mutex?=$name ]
    return($seen($node))
}

// ---- Network objects ----

// Model a normalized domain (norm.normDomain). Returns its inet:fqdn node.
function domain(d, engines=detected) {
    $n = $fqdnNode($d.fqdn)
    if ($n = $lib.null) { return($n) }
    $tags($n, $d.vtags)
    $setSeen($n, $d.first_seen)
    $scan($n, $d.scan, $engines)
    for $rec in $d.dns { $dnsNode($d.fqdn, $rec.type, $rec.value, $d.dns_time, $rec.email) }
    $whois($d.fqdn, $d.whois)
    $cert($d.cert)
    return($n)
}

// A domain's whois as an inet:whois:rec, also used for historical_whois objects.
function whois(fqdn, w) {
    if ($w = $lib.null or $w.asof = $lib.null) { return($lib.null) }
    [ inet:whois:rec?=($fqdn, $w.asof) :text?=$w.text :registrar?=$w.registrar
        :created?=$w.created :expires?=$w.expires :updated?=$w.updated ]
    return($seen($node))
}

function cert(c) {
    if ($c = $lib.null) { return($lib.null) }
    [ crypto:x509:cert=({"sha256": $c.sha256})
        :sha1?=$c.sha1 :serial?=$c.serial :subject?=$c.subject :issuer?=$c.issuer
        :validity:notbefore?=$c.notbefore :validity:notafter?=$c.notafter
        :selfsigned?=$c.selfsigned ]
    if $c.sans { [ :identities:fqdns?=$c.sans ] }
    if $c.crls { [ :crl:urls?=$c.crls ] }
    if $c.time { [ .seen ?= $c.time ] }
    return($seen($node))
}

// Model a normalized IP (norm.normIp). Returns its inet:ipv4/inet:ipv6 node.
function ip(i, engines=detected) {
    $n = $ipNode($i.ip)
    if ($n = $lib.null) { return($n) }
    $asn = $asnNode($i.asn, $i.as_owner)
    $setIpProps($n, $asn, $i.country)
    $tags($n, $i.vtags)
    $scan($n, $i.scan, $engines)
    $ipWhois($i, $i.whois)
    $c = $cert($i.cert)
    if $i.https {
        $serverCert($i.https, $c)
        $jarm($i.https, $i.jarm)
    }
    return($n)
}

function serverCert(srv, c) {
    if ($c = $lib.null) { return($lib.null) }
    [ inet:tls:servercert?=($srv, $c) ]
    return($seen($node))
}

function jarm(srv, hash) {
    if (not $hash) { return($lib.null) }
    [ inet:ssl:jarmsample?=($srv, $hash) ]
    return($seen($node))
}

function asnNode(asn, owner) {
    if ($asn = $lib.null) { return($lib.null) }
    [ inet:asn?=$asn :name?=$owner ]
    return($seen($node))
}

function setIpProps(n, asn, country) {
    yield $n
    if $asn { [ :asn=$asn ] }
    if $country { [ :loc?=$country ] }
    return($n)
}

// An IP's whois as an inet:whois:iprec, also used for historical_whois objects.
function ipWhois(i, w) {
    if ($w = $lib.null) { return($lib.null) }
    [ inet:whois:iprec=$lib.guid(slib.vt, iprec, $i.ip, $w.asof, $w.text)
        :text?=$w.text :asof?=$w.asof :created?=$w.created :updated?=$w.updated
        :asn?=$i.asn :country?=$i.country ]
    if $i.network {
        if ($i.version = 6) { [ :net6?=$i.network ] }
        else { [ :net4?=$i.network ] }
    }
    return($seen($node))
}

// Model a normalized URL (norm.normUrl). Returns its inet:url node.
function url(u, engines=detected) {
    $n = $urlNode($u.url)
    if ($n = $lib.null) { return($n) }
    $tags($n, $u.vtags)
    $setSeen($n, $u.first_seen)
    $setSeen($n, $u.last_seen)
    $scan($n, $u.scan, $engines)

    // The redirection chain, then the last hop to the final URL.
    $prev = $u.url
    for $hop in $u.redirects {
        if ($hop != $prev) { $redir($prev, $hop) }
        $prev = $hop
    }
    if ($u.final and $u.final != $prev) { $redir($prev, $u.final) }

    if $u.content_sha256 {
        $last = $u.final
        if ($last = $lib.null) { $last = $u.url }
        $content = $sha256Node($u.content_sha256)
        $setSize($content, $u.content_size)
        $urlFile($last, $content)
    }
    return($n)
}

function setSize(n, size) {
    if ($n = $lib.null or $size = $lib.null) { return($n) }
    yield $n
    [ :size?=$size ]
    return($n)
}

function redir(src, dst) {
    $urlNode($dst)
    [ inet:urlredir?=($src, $dst) ]
    return($seen($node))
}

function urlFile(url, file) {
    if ($file = $lib.null) { return($lib.null) }
    [ inet:urlfile?=($url, $file) ]
    return($seen($node))
}

// ---- Other objects ----

function resolution(r) {
    if ($r.version = 6) { $rtype = AAAA } else { $rtype = A }
    $fqdnNode($r.fqdn)
    return($dnsNode($r.fqdn, $rtype, $r.ip, $r.time))
}

// A comment as a meta:note -(about)> the node it's on.
function comment(n, c) {
    [ meta:note=$lib.guid(slib.vt, comment, $c.id)
        :text=$c.text :created?=$c.time :type=virustotal.comment ]
    $note = $seen($node)
    $edge($note, about, $n)
    return($note)
}

// Model an analysis's results (norm.normAnalysis) on the analyzed node.
function analysis(a, engines=detected) {
    $n = $lib.null
    if $a.sha256 {
        $n = $fileNode(({"sha256": $a.sha256, "md5": $a.md5, "sha1": $a.sha1, "size": $a.size}))
    } elif $a.url {
        $n = $urlNode($a.url)
    }
    if ($n = $lib.null) { return($n) }
    $scan($n, $a.scan, $engines)
    return($n)
}

// Model any normalized object. Returns the node it's about (or null). n is the node the
// object is related to (for comments and whois), if any.
function obj(o, engines=detected, n=$lib.null) {
    switch $o.type {
        file: { return($file($o, $engines)) }
        domain: { return($domain($o, $engines)) }
        ip_address: { return($ip($o, $engines)) }
        url: { return($url($o, $engines)) }
        resolution: { return($resolution($o)) }
        ssl_cert: { return($sslCert($n, $o)) }
        comment: {
            if ($n = $lib.null) { return($lib.null) }
            return($comment($n, $o))
        }
        whois: { return($histWhois($n, $o)) }
    }
    return($lib.null)
}

function sslCert(n, c) {
    $certnode = $cert($c)
    if ($n = $lib.null or $certnode = $lib.null) { return($certnode) }
    if ($n.form() = "inet:ipv4") { $serverCert(`tcp://{$n.repr()}:443`, $certnode) }
    elif ($n.form() = "inet:ipv6") { $serverCert(`tcp://[{$n.repr()}]:443`, $certnode) }
    return($certnode)
}

function histWhois(n, w) {
    if ($n = $lib.null) { return($lib.null) }
    if ($n.form() = "inet:fqdn") { return($whois($n.repr(), $w)) }
    if ($n.form() = "inet:ipv4" or $n.form() = "inet:ipv6") {
        $ver = (4)
        if ($n.form() = "inet:ipv6") { $ver = (6) }
        return($ipWhois(({"ip": $n.repr(), "version": $ver}), $w))
    }
    return($lib.null)
}
