// Unprivileged helpers shared by the slib.vt commands.

// Warn about a failed service call. Returns true if the call failed.
function failed(retn, what) {
    if $retn.status { return((false)) }
    $lib.warn("slib.vt: {what} failed: {err}", what=$what, err=$retn.mesg)
    return((true))
}

// The VirusTotal (kind, id) a node is looked up by, or null if it can't be.
function target(n) {
    switch $n.form() {
        "file:bytes": {
            for $prop in (sha256, sha1, md5) {
                $valu = $n.props.$prop
                if $valu { return((file, $valu)) }
            }
            return($lib.null)
        }
        "hash:md5": { return((file, $n.repr())) }
        "hash:sha1": { return((file, $n.repr())) }
        "hash:sha256": { return((file, $n.repr())) }
        "inet:fqdn": { return((domain, $n.repr())) }
        "inet:ipv4": { return((ip_address, $n.repr())) }
        "inet:ipv6": { return((ip_address, $n.repr())) }
        "inet:url": { return((url, $n.repr())) }
    }
    return($lib.null)
}

// Format an epoch millis time (or null) for printing.
function when(time) {
    if ($time = $lib.null) { return(never) }
    return($lib.time.format($time, "%Y-%m-%d %H:%M:%S UTC"))
}

// "68/75 engines" from a normalized scan, or "not scanned".
function detections(scan) {
    if ($scan = $lib.null or $scan.counts = $lib.null) { return("not scanned") }
    $c = $scan.counts
    return(`{$c.malicious} malicious, {$c.suspicious} suspicious of {$c.total} engines`)
}

// Print a table. columns is a list of (name, width) and rows is a list of lists.
function table(columns, rows) {
    $cols = ([])
    for ($name, $width) in $columns {
        $cols.append(({"name": $name, "width": $width}))
    }
    $printer = $lib.tabular.printer(({"columns": $cols}))
    $lib.print($printer.header())
    for $row in $rows {
        $lib.print($printer.row($row))
    }
}

// Print any value as indented JSON.
function printJson(valu) {
    $lib.print($lib.json.save($valu, indent=(true)))
}
