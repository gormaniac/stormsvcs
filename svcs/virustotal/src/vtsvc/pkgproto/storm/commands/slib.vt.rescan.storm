init {
    $submit = $lib.import(slib.vt.priv.submit)
    $util = $lib.import(slib.vt.util)
}

$tgt = $util.target($node)
if ($tgt = null) {
    $lib.warn(`slib.vt.rescan: Can't rescan {$node.repr()}, it has no hash.`)
} else {
    ($kind, $ident) = $tgt
    $retn = $submit.rescan($kind, $ident)
    if (not $util.failed($retn, `Rescanning {$ident}`)) {
        $lib.print(`slib.vt.rescan: Rescanning {$ident}, analysis {$retn.data.id}.`)
    }
}
