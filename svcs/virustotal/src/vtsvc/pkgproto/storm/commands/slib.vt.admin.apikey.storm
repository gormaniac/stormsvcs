init {
    $admin = $lib.import(slib.vt.priv.admin)
    $util = $lib.import(slib.vt.util)

    if $cmdopts.clear {
        $retn = $admin.setApiKey($lib.null)
        if (not $util.failed($retn, "Clearing the API key")) { $lib.print($retn.mesg) }
    }
    elif $cmdopts.apikey {
        $retn = $admin.setApiKey($cmdopts.apikey)
        if (not $util.failed($retn, "Setting the API key")) { $lib.print($retn.mesg) }
    }
    else {
        $retn = $admin.hasApiKey()
        if $retn.data { $lib.print("slib.vt: A service-wide API key is set.") }
        else { $lib.print("slib.vt: No service-wide API key is set.") }
    }
}
