init {
    $vtlib = $lib.import(slib.vt.lib)
    $util = $lib.import(slib.vt.util)
    $opts = $cmdopts
    $found = ([])
}

$tgt = $util.target($node)
if ($tgt = null) {
    $lib.warn(`slib.vt.comments: Can't look up {$node.repr()}, it has no hash.`)
} else {
    ($kind, $ident) = $tgt
    $nodes = $vtlib.comments($node, $kind, $ident, limit=$opts.limit)
    if $opts.yield { $found.extend($nodes) }
}

if $opts.yield { spin }  // noqa: P001 - --yield yields the collected nodes in fini

fini {
    if $opts.yield {
        for $n in $found { yield $n }
    }
}
