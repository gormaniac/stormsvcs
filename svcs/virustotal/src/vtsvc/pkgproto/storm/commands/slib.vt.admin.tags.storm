init {
    $admin = $lib.import(slib.vt.priv.admin)
    $name = "slib.vt.admin.tags"

    if ($cmdopts.enable and $cmdopts.disable) {
        $lib.warn(`{$name}: Use --enable or --disable, not both.`)
    } else {
        $ok = (true)
        if ($cmdopts.prefix != null) {
            try { $admin.setTagPrefix($cmdopts.prefix) }
            catch * as err {
                $lib.warn(`{$name}: Invalid tag prefix: {$err.mesg}. Nothing was changed.`)
                $ok = (false)
            }
        }
        if $ok {
            if $cmdopts.enable { $admin.setTagsEnabled((true)) }
            if $cmdopts.disable { $admin.setTagsEnabled((false)) }
        }
    }

    $settings = $admin.tagSettings()
    $lib.print(`{$name}: enabled={$settings.enabled} prefix={$settings.prefix}`)
}
