init {
    $vault = $lib.vault.bytype(virustotal, scope=user)

    if $cmdopts.clear {
        if $vault {
            $vault.delete()
            $lib.print("slib.vt: Deleted your VirusTotal API key.")
        } else {
            $lib.print("slib.vt: You don't have a VirusTotal API key set.")
        }
    }
    elif (not $cmdopts.apikey) {
        if $vault {
            $lib.print(`slib.vt: Your VirusTotal API key is set in vault {$vault.name}.`)
        } else {
            $lib.print("slib.vt: You don't have a VirusTotal API key set.")
        }
    }
    elif $vault {
        $vault.secrets.apikey = $cmdopts.apikey
        $lib.print("slib.vt: Updated your VirusTotal API key.")
    }
    else {
        $name = `virustotal:{$lib.auth.users.get().name}`
        $lib.vault.add($name, virustotal, user, $lib.auth.users.get().iden, ({"apikey": $cmdopts.apikey}), ({}))
        $lib.print(`slib.vt: Saved your VirusTotal API key in vault {$name}.`)
    }
}
