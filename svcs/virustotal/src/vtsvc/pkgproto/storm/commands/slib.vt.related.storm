init {
    $vtlib = $lib.import(slib.vt.lib)
    $util = $lib.import(slib.vt.util)
    $opts = $cmdopts
    $found = ([])
}

$tgt = $util.target($node)
if ($tgt = $lib.null) {
    $lib.warn("slib.vt.related: Can't look up {repr}, it has no hash.", repr=$node.repr())
} else {
    ($kind, $ident) = $tgt
    $nodes = $vtlib.related($node, $kind, $ident, $opts.rel, limit=$opts.limit)
    if $opts.yield { $found.extend($nodes) }
}

if $opts.yield { spin }

fini {
    if $opts.yield {
        for $n in $found { yield $n }
    }
}
