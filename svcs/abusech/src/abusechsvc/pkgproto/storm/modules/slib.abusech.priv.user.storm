// Privileged (asroot) wrappers around the slib.abusech service for slib.abusech.user.
// Every function returns the service's {status, mesg, data} dict, or emits them for generators.
//
// The calling user's own Auth-Key (a user scoped "abusech" vault) is passed to the service,
// otherwise the service falls back to its stored/configured key. Only the user scope is
// read so this module never exposes another user's or role's secrets.

init {
    $svc = $lib.service.get("slib.abusech")
}

function userKey() {
    $vault = $lib.vault.bytype(abusech, scope=user)
    if ($vault = $lib.null) { return($lib.null) }
    $secrets = $vault.secrets
    if ($secrets = $lib.null) { return($lib.null) }
    return($secrets.apikey)
}

function hasKey() {
    if $userKey() { return((true)) }
    return($svc.hasApiKey().data)
}

function tagPrefix() {
    if $lib.globals.get("slib:abusech:tag:enabled") {
        return($lib.globals.get("slib:abusech:tag:prefix"))
    }
    return($lib.null)
}

// MalwareBazaar

function bazaarInfo(sha) { return($svc.normBazaarInfo($sha, apikey=$userKey())) }
function bazaarSearch(by, valu, limit=(100)) { return($svc.normBazaarSearch($by, $valu, limit=$limit, apikey=$userKey())) }
function bazaarRecent(selector=time) { return($svc.normBazaarRecent($selector, apikey=$userKey())) }
function bazaarCscb() { return($svc.normBazaarCscb(apikey=$userKey())) }
function bazaarExport(kind=recent, limit=(0)) {
    for $retn in $svc.bazaarExport(kind=$kind, limit=$limit, apikey=$userKey()) { emit $retn }
}

// URLhaus

function urlhausUrl(url=$lib.null, urlid=$lib.null) { return($svc.normUrlhausUrl(url=$url, urlid=$urlid, apikey=$userKey())) }
function urlhausHost(host) { return($svc.normUrlhausHost($host, apikey=$userKey())) }
function urlhausPayload(sha) { return($svc.normUrlhausPayload($sha, apikey=$userKey())) }
function urlhausSearch(by, valu, limit=(0)) { return($svc.normUrlhausSearch($by, $valu, limit=$limit, apikey=$userKey())) }
function urlhausRecent(kind=urls, limit=$lib.null) { return($svc.normUrlhausRecent(kind=$kind, limit=$limit, apikey=$userKey())) }
function urlhausExport(kind=recent, limit=(0)) {
    for $retn in $svc.urlhausExport(kind=$kind, limit=$limit, apikey=$userKey()) { emit $retn }
}

// ThreatFox

function threatfox(by, valu=$lib.null, limit=(100), exact=(false)) {
    return($svc.normThreatfox($by, valu=$valu, limit=$limit, exact=$exact, apikey=$userKey()))
}
function threatfoxTypes() { return($svc.threatfoxTypes(apikey=$userKey())) }
function threatfoxTagList() { return($svc.threatfoxTagList(apikey=$userKey())) }
function threatfoxMalwareList() { return($svc.threatfoxMalwareList(apikey=$userKey())) }
function threatfoxLabel(malware, platform=$lib.null) { return($svc.threatfoxLabel($malware, platform=$platform, apikey=$userKey())) }
function threatfoxExport(kind=recent, limit=(0)) {
    for $retn in $svc.threatfoxExport(kind=$kind, limit=$limit, apikey=$userKey()) { emit $retn }
}

// YARAify

function yaraifyHash(sha, malpedia=$lib.null) { return($svc.normYaraifyHash($sha, malpedia=$malpedia, apikey=$userKey())) }
function yaraifySearch(by, valu, limit=(25)) { return($svc.normYaraifySearch($by, $valu, limit=$limit, apikey=$userKey())) }
function yaraifyResults(taskid, malpedia=$lib.null) { return($svc.normYaraifyResults($taskid, malpedia=$malpedia, apikey=$userKey())) }
function yaraifyTasks(identifier, status=processed) { return($svc.normYaraifyTasks($identifier, status=$status, apikey=$userKey())) }
function yaraifyIdentifier() { return($svc.yaraifyIdentifier(apikey=$userKey())) }
function yaraifyRecentRules() { return($svc.normYaraifyRecentRules(apikey=$userKey())) }
function yaraifyRule(uuid) { return($svc.yaraifyRule($uuid, apikey=$userKey())) }
function yaraifyRulesExport(limit=(0)) {
    for $retn in $svc.yaraifyRulesExport(limit=$limit, apikey=$userKey()) { emit $retn }
}

// Feodo Tracker and SSL Blacklist

function feodoBlocklist(kind=all, limit=(0)) {
    for $retn in $svc.feodoBlocklist(kind=$kind, limit=$limit, apikey=$userKey()) { emit $retn }
}
function sslblBlocklist(kind=certs, limit=(0)) {
    for $retn in $svc.sslblBlocklist(kind=$kind, limit=$limit, apikey=$userKey()) { emit $retn }
}

// Hunting

function fplist(platform=$lib.null) { return($svc.normFplist(platform=$platform, apikey=$userKey())) }
