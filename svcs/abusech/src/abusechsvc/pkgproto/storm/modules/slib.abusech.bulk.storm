// Bulk imports of abuse.ch exports (the --bulk option of the slib.abusech.*.export commands).
//
// The export is pulled into the Axon, copied into the service, built into a syn.nodes .nodes file
// by the service (the same nodes slib.abusech.model creates), saved back into the Axon, and
// ingested with $lib.feed.fromAxon() as the calling user. Each pull is recorded in the
// slib:abusech:datasets global so later imports (ex. after a service update) reuse the same file
// instead of pulling it from abuse.ch again.

init {
    $privbulk = $lib.import(slib.abusech.priv.bulk)
    $util = $lib.import(slib.abusech.util)

    // How long to wait between pulls of the frequently updated exports.
    $recentWait = (3600000)
    // Print progress after this many rows.
    $progressRows = (50000)
}

function _time(tick) { return($lib.time.format($tick, "%Y-%m-%d %H:%M:%S")) }

// The exports abuse.ch regenerates often, which may only be pulled once an hour.
function isRecent(kind) { return(($kind = "recent" or $kind = "online")) }

// Pick the export file to import: the last pull, or a new one. Returns its dataset info, or null.
function _dataset(cmd, plat, kind, reuse, repull) {
    $info = $privbulk.dataset($plat, $kind)
    $pull = (true)

    if $repull { $pull = (true) }
    elif $reuse {
        if (not $info) {
            $lib.warn("{cmd}: There's no previous {kind} pull to reuse, run without --reuse to pull it.", cmd=$cmd, kind=$kind)
            return($lib.null)
        }
        $pull = (false)
    }
    elif $info {
        if $isRecent($kind) {
            $age = ($lib.time.now() - $info.time)
            if ($age < $recentWait) {
                $lib.warn("{cmd}: The {kind} export was last pulled {mins} minutes ago ({time}). To avoid overusing abuse.ch, rerun with --reuse to import that pull again, or --repull to pull a new one.",
                          cmd=$cmd, kind=$kind, mins=($age / 60000), time=$_time($info.time))
                return($lib.null)
            }
        } else {
            $pull = (false)
            $lib.print("{cmd}: Using the {kind} export pulled at {time} ({sha}), use --repull to pull a new one.",
                       cmd=$cmd, kind=$kind, time=$_time($info.time), sha=$info.sha256)
        }
    }

    if $pull {
        $lib.print("{cmd}: Pulling the {kind} export into the Axon.", cmd=$cmd, kind=$kind)
        $info = $privbulk.pull($plat, $kind)
        $lib.print("{cmd}: Pulled the {kind} export ({size} bytes, {sha}).", cmd=$cmd, kind=$kind,
                   size=$info.size, sha=$info.sha256)
        return($info)
    }

    if (not $privbulk.hasFile($info.sha256)) {
        $lib.warn("{cmd}: The {kind} export pulled at {time} ({sha}) is no longer in the Axon, rerun with --repull.",
                  cmd=$cmd, kind=$kind, time=$_time($info.time), sha=$info.sha256)
        return($lib.null)
    }
    return($info)
}

// Bulk import an export. Returns the number of nodes ingested, or null if it didn't run.
function run(plat, kind, reuse=(false), repull=(false)) {
    $cmd = `slib.abusech.{$plat}.export`
    if ($reuse and $repull) {
        $lib.raise(BadArg, `{$cmd}: Use --reuse or --repull, not both.`)
    }

    $lib.warn("{cmd}: Bulk imports can take a long time (hours for the full exports), run them in the background, ex. background { {cmd} {kind} --bulk }",
              cmd=$cmd, kind=$kind)

    $jobid = $lib.null
    $count = $lib.null
    try {
        $info = $_dataset($cmd, $plat, $kind, $reuse, $repull)
        if (not $info) { return($lib.null) }

        $lib.print("{cmd}: Copying the export into the service.", cmd=$cmd)
        $jobid = $privbulk.stage($plat, $kind, $info.sha256, $info.size)

        $result = $lib.null
        for $retn in $privbulk.build($jobid, prefix=$privbulk.tagPrefix()) {
            if $util.failed($retn, `Building the {$kind} export's nodes`) { break }
            if $retn.data.done { $result = $retn.data }
            elif (($retn.data.rows % $progressRows) = 0) {
                $lib.print("{cmd}: Built {nodes} nodes from {rows} rows.", cmd=$cmd, nodes=$retn.data.nodes, rows=$retn.data.rows)
            }
        }

        if $result {
            $lib.print("{cmd}: Built {nodes} nodes from {rows} rows in {secs}s, saving them to the Axon.",
                       cmd=$cmd, nodes=$result.nodes, rows=$result.rows, secs=$result.seconds)
            ($size, $sha256) = $privbulk.storeNodes($jobid)

            $lib.print("{cmd}: Ingesting {sha}.", cmd=$cmd, sha=$sha256)
            $start = $lib.time.now()
            $count = $lib.feed.fromAxon($sha256)
            $secs = (($lib.time.now() - $start) / 1000)

            $info.nodes = ({"sha256": $sha256, "size": $size, "count": $result.nodes, "rows": $result.rows,
                            "skipped": $result.skipped, "builder": $result.builder, "time": $lib.time.now()})
            $privbulk.setDataset($plat, $kind, $info)
            $lib.print("{cmd}: Ingested {count} nodes in {secs}s.", cmd=$cmd, count=$count, secs=$secs)
        }
    } catch * as err {
        $lib.warn("{cmd}: The bulk import failed: {error}", cmd=$cmd, error=$err.mesg)
    }

    if $jobid { $privbulk.done($jobid) }
    return($count)
}
