// Unprivileged helpers shared by the slib.abusech commands.

// The calling user's own abuse.ch Auth-Key, from their user scoped "abusech" vault (or null).
// Only the user scope is read, so another user's or role's secrets are never exposed.
function userKey() {
    $vault = $lib.vault.bytype(abusech, scope=user)
    if ($vault = null) { return() }
    $secrets = $vault.secrets
    if ($secrets = null) { return() }
    return($secrets.apikey)
}

// Whether a string looks like an IPv6 address (vs. IPv4).
function isIpv6(ip) {
    return(($lib.cast(str, $ip) ~= ":"))
}

// Warn about a failed service call. Returns true if the call failed.
function failed(retn, what) {
    if $retn.status { return((false)) }
    $lib.warn(`slib.abusech: {$what} failed: {$retn.mesg}`)
    return((true))
}

// The type of a hex hash by its length (md5, sha1, sha256, sha3_384), or null.
function hashType(valu) {
    $valu = $lib.cast(str, $valu)
    if (not $lib.regex.matches("^[0-9a-fA-F]+$", $valu)) { return() }
    switch $lib.len($valu) {
        "32": { return(md5) }
        "40": { return(sha1) }
        "64": { return(sha256) }
        "96": { return(sha3_384) }
    }
    return()
}

// The best hash to look a file:bytes/hash:* node up by, preferring SHA256. Returns null if there isn't one.
function nodeHash(node) {
    switch $node.form() {  // noqa: R002
        "file:bytes": {
            if $node.props.sha256 { return($node.props.sha256) }
            if $node.props.sha1 { return($node.props.sha1) }
            if $node.props.md5 { return($node.props.md5) }
            return()
        }
        "hash:md5": { return($node.repr()) }
        "hash:sha1": { return($node.repr()) }
        "hash:sha256": { return($node.repr()) }
    }
    return()
}

// Print a table. columns is a list of (name, width) and rows is a list of lists.
function table(columns, rows) {
    $cols = ([])
    for ($name, $width) in $columns {
        $cols.append(({"name": $name, "width": $width}))
    }
    $printer = $lib.tabular.printer(({"columns": $cols}))
    $lib.print($printer.header())
    for $row in $rows {
        $lib.print($printer.row($row))
    }
}

// Print any value as indented JSON.
function printJson(valu) {
    $lib.print($lib.json.save($valu, indent=(true)))
}

// Print an abuse.ch submission response.
function printSubmission(what, retn) {
    if $failed($retn, $what) { return((false)) }
    if ($lib.vars.type($retn.data) = "str") {  // noqa: R005 - 2.x has no $lib.utils.type()
        $lib.print(`slib.abusech: {$what}: {$retn.data}`)
    } else {
        $lib.print(`slib.abusech: {$what}:`)
        $printJson($retn.data)
    }
    return((true))
}

// Whether this is the first call with a command's state dict, ({"done": (false)}) made in its init
// block. A command's body runs once per inbound node, so the work that ignores inbound nodes (ex.
// a --hash option, or a blocklist download) is gated on this to run once, without a spin.
function first(state) {
    if $state.done { return((false)) }
    $state.done = (true)
    return((true))
}
