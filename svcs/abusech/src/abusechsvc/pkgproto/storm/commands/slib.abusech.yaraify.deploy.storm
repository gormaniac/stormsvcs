init {
    $privsub = $lib.import(slib.abusech.priv.submit)
    $util = $lib.import(slib.abusech.util)

    if $cmdopts.text {
        $util.printSubmission("Deploying a YARA rule to YARAify", $privsub.yaraifyDeploy($cmdopts.text))
    }
    for $uuid in $cmdopts.delete {
        $util.printSubmission(`Deleting YARA rule {$uuid} from YARAify`, $privsub.yaraifyDeleteRule($uuid))
    }
}

if ($node.form() != "it:app:yara:rule") {  // noqa: R002
    $lib.warn(`slib.abusech.yaraify.deploy: Only it:app:yara:rule nodes can be deployed, not {$node.form()}.`)  // noqa: R002
}
elif (not :text) {
    $lib.warn(`slib.abusech.yaraify.deploy: {:name} has no :text to deploy.`)
}
else {
    $name = :name
    if (not $name) { $name = "rule" }
    $util.printSubmission(`Deploying {$name} to YARAify`, $privsub.yaraifyDeploy(:text, name=`{$name}.yar`))
}
