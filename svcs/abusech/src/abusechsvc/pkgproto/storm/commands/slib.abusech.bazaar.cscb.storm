init {
    $util = $lib.import(slib.abusech.util)
    $once = ({"done": false})
    $abusech = $lib.import(slib.abusech.lib)
    $model = $lib.import(slib.abusech.model)
    $certs = $abusech.bazaarCscb()
    $lib.print(`slib.abusech.bazaar.cscb: {$lib.len($certs)} blocklisted code signing certificates.`)

    // Yield the results once, not once per inbound node (which are dropped).
    function results() {
        if $util.first($once) {
            if $cmdopts.yield { yield $model.nodes($certs) }
        }
    }
}

divert (true) $results()
