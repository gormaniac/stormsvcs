init {
    $util = $lib.import(slib.abusech.util)
    $once = ({"done": false})
    $abusech = $lib.import(slib.abusech.lib)
    $model = $lib.import(slib.abusech.model)

    if ($cmdopts.by = "detections") {
        $hours = (48)
        if $cmdopts.value { $hours = $lib.cast(int, $cmdopts.value) }
        $files = $abusech.bazaarDetections($hours)
    }
    elif ($cmdopts.by = "recent") {
        $selector = "time"
        if $cmdopts.value { $selector = $cmdopts.value }
        $files = $abusech.bazaarRecent($selector)
    }
    elif (not $cmdopts.value) {
        $lib.raise(BadArg, "slib.abusech.bazaar.search requires a value to search for.")
    }
    else {
        $files = $abusech.bazaarSearch($cmdopts.by, $cmdopts.value, limit=$cmdopts.limit)
    }
    $lib.print(`slib.abusech.bazaar.search: Found {$lib.len($files)} samples.`)

    // Yield the results once, not once per inbound node (which are dropped).
    function results() {
        if $util.first($once) {
            yield $model.nodes($files)
        }
    }
}

divert (true) $results()
