init {
    $vault = $lib.vault.bytype(abusech, scope=user)

    if $cmdopts.clear {
        if $vault {
            $vault.delete()
            $lib.print("slib.abusech: Deleted your abuse.ch Auth-Key.")
        } else {
            $lib.print("slib.abusech: You don't have an abuse.ch Auth-Key set.")
        }
    }
    elif (not $cmdopts.apikey) {
        if $vault {
            $lib.print(`slib.abusech: Your abuse.ch Auth-Key is set in vault {$vault.name}.`)
        } else {
            $lib.print("slib.abusech: You don't have an abuse.ch Auth-Key set.")
        }
    }
    elif $vault {
        $vault.secrets.apikey = $cmdopts.apikey
        $lib.print("slib.abusech: Updated your abuse.ch Auth-Key.")
    }
    else {
        $user = $lib.auth.users.get()
        $name = `abusech:{$user.name}`
        // The name can already be taken, ex. by a vault of another type or scope (ABUSE-ST-10).
        try {
            $lib.vault.add($name, abusech, user, $user.iden, ({"apikey": $cmdopts.apikey}), ({}))
            $lib.print(`slib.abusech: Saved your abuse.ch Auth-Key in vault {$name}.`)
        } catch * as err {
            $lib.warn(`slib.abusech: Unable to save your abuse.ch Auth-Key in a new vault named {$name}: {$err.mesg} If a vault with that name already exists, rename or delete it, or ask an admin to.`)
        }
    }
}
