init {
    $util = $lib.import(slib.abusech.util)
    $once = ({"done": false})
    $abusech = $lib.import(slib.abusech.lib)

    // Run once, not once per inbound node (which are dropped).
    function results() {
        if $util.first($once) {
            for $n in $abusech.sslblBlocklist(kind=$cmdopts.list, limit=$cmdopts.limit) {
                if $cmdopts.yield { yield $n }
            }
        }
    }
}

divert (true) $results()
