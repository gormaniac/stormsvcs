init {
    $once = ({"done": false})
    $dl = $lib.import(slib.abusech.download)
    $model = $lib.import(slib.abusech.model)
    $util = $lib.import(slib.abusech.util)

    // The options that ignore inbound nodes (which are dropped) run once, not once per node.
    function byOptions() {
        if $util.first($once) {
            for $sha in $cmdopts.hash {
                $file = $dl.download(yaraify, $sha, unpacked=$cmdopts.unpacked)
                if ($cmdopts.yield and $file) { yield $file }
            }
        }
    }
}

if $cmdopts.hash {
    // --hash ignores inbound nodes.
    divert (true) $byOptions()
}
else {
    $sha = $util.nodeHash($node)
    $results = ([])
    if ($sha and $util.hashType($sha) = "sha256") { $results = ($dl.download(yaraify, $sha, unpacked=$cmdopts.unpacked),) }
    else {
        $lib.warn(`slib.abusech.yaraify.download: {$node.form()} {$node.repr()} has no SHA256 to download.`)  // noqa: R002
    }
    divert $cmdopts.yield $model.nodes($results)
}
