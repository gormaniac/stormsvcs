init {
    $util = $lib.import(slib.abusech.util)
    $once = ({"done": false})
    $abusech = $lib.import(slib.abusech.lib)
    $model = $lib.import(slib.abusech.model)
    $files = $abusech.yaraifySearch($cmdopts.by, $cmdopts.value, limit=$cmdopts.limit)
    $lib.print(`slib.abusech.yaraify.search: Found {$lib.len($files)} files.`)

    // Yield the results once, not once per inbound node (which are dropped).
    function results() {
        if $util.first($once) {
            yield $model.nodes($files)
        }
    }
}

divert (true) $results()
