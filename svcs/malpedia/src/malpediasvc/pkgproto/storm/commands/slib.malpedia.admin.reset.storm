init {
    $admin = $lib.import(slib.malpedia.priv.admin)
    $name = "slib.malpedia.admin.reset"

    if (not $cmdopts.yes) {
        $lib.warn("{name}: This makes the next sync model every record into this view again, use --yes to confirm.", name=$name)
    } else {
        $retn = $admin.resetView()
        if $retn.status { $lib.print("{name}: Reset this view, its next sync models every record.", name=$name) }
        else { $lib.warn("{name}: Unable to reset this view: {err}", name=$name, err=$retn.mesg) }
    }
}
