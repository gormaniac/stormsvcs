init {
    $admin = $lib.import(slib.malpedia.priv.admin)
    $name = "slib.malpedia.admin.reset"

    if (not $cmdopts.yes) {
        $lib.warn(`{$name}: This makes the next sync model every record into this view again, use --yes to confirm.`)
    } else {
        $retn = $admin.resetView()
        if $retn.status { $lib.print(`{$name}: Reset this view, its next sync models every record.`) }
        else { $lib.warn(`{$name}: Unable to reset this view: {$retn.mesg}`) }
    }
}
