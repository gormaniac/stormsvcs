init {
    $user = $lib.import(slib.malpedia.priv.user)
    $util = $lib.import(slib.malpedia.util)
    $name = "slib.malpedia.search"

    $kinds = ([])
    if (not $cmdopts.families) { $kinds.append(actor) }
    if (not $cmdopts.actors) { $kinds.append(family) }
    if ($cmdopts.actors and $cmdopts.families) { $kinds = (actor, family) }

    $found = ([])
    for $kind in $kinds {
        $plural = $util.plural($kind)
        $results = $util.data($user.find($kind, $cmdopts.needle), `Searching the {$plural}`)
        if ($results = null) { continue }

        $rows = ([])
        for $res in $results {
            $found.append(($kind, $res.name))
            $synonyms = $res.synonyms
            if ($synonyms = null) { $synonyms = $res.alt_names }
            if ($synonyms = null) { $synonyms = ([]) }
            $display = $res.common_name
            if ($display = null) { $display = "" }
            $known = no
            if $res.known { $known = yes }
            $rows.append(($res.name, $display, $known, (", ").join($synonyms)))
        }
        if $rows {
            $lib.print(`{$name}: {$lib.len($rows)} {$plural} match {$cmdopts.needle}:`)
            $util.table(([["id", 32], ["name", 28], ["synced", 7], ["synonyms", 60]]), $rows)
        } else {
            $lib.print(`{$name}: No {$plural} match {$cmdopts.needle}.`)
        }
    }
}

if $cmdopts.yield {
    for ($kind, $id) in $found {
        if ($kind = "actor") { risk:threat=(malpedia, $id) }
        else { risk:tool:software=(malpedia, $id) }  // noqa: M001
    }
}
