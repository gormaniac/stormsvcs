// Privileged (asroot) wrappers around the slib.malpedia service, the sync cron job, and the
// tag settings, for slib.malpedia.admin.
//
// NOTE: $lib.globals.get()/set()/pop() and $lib.cron.enable()/disable() are removed in Synapse
// 3.x, but 2.x has no $lib.globals.<name> (and these names have colons) and its $lib.cron.mod()
// can't enable a job. This package requires Synapse <3.0.0 so R005 is ignored here.

init {
    $svc = $lib.service.get("slib.malpedia")
    $cronglobal = "slib:malpedia:cron"
}

// ---- The sync cron job ----

// The sync cron job, or null if there isn't one.
function cron() {
    $iden = $lib.globals.get($cronglobal)  // noqa: R005
    if (not $iden) { return() }
    try {
        return($lib.cron.get($iden))
    } catch (NoSuchIden, StormRuntimeError) as err {
        return()
    }
}

// Replace the sync cron job with one on a new schedule (a cron.add --period), in the current view.
function schedule(period) {
    $old = $cron()
    $new = $lib.cron.add(query="slib.malpedia.sync", period=$period)
    $new.set(name, "slib.malpedia.sync")
    $new.set(doc, "Pull Malpedia (if it changed) and sync its library, actors, families, and YARA rules into the view.")
    $lib.globals.set($cronglobal, $new.iden)  // noqa: R005
    if $old { $lib.cron.del($old.iden) }
    return($new)
}

function enable(enabled=(true)) {
    $job = $cron()
    if (not $job) { return() }
    if $enabled { $lib.cron.enable($job.iden) }  // noqa: R005
    else { $lib.cron.disable($job.iden) }  // noqa: R005
    return($lib.cron.get($job.iden))
}

// Delete the sync cron job. Returns whether there was one.
function unschedule() {
    $job = $cron()
    $lib.globals.pop($cronglobal)  // noqa: R005
    if (not $job) { return((false)) }
    $lib.cron.del($job.iden)
    return((true))
}

// A sync cron job schedule() made that isn't the tracked one (ex. one a failed service.del
// left behind), or null.
function _orphan() {
    for $job in $lib.cron.list() {
        $info = $job.pack()
        if ($info.name = "slib.malpedia.sync" and $info.query = "slib.malpedia.sync") {
            return($job)
        }
    }
    return()
}

// Run by the one time cron job the service's add event starts (the service isn't ready during
// the add event itself): unless malpedia:autosync is off, schedule the daily sync (at the
// service's random time) if there isn't one. A sync cron job left behind by an earlier
// service.del is kept instead of adding a second one. Returns whether the initial sync should
// run.
function autoSchedule() {
    $retn = $svc.schedInfo()
    if (not $retn.status) {
        $lib.warn(`slib.malpedia: Unable to read the sync schedule: {$retn.mesg}`)
        return((false))
    }
    $info = $retn.data
    if (not $info.autosync) { return((false)) }
    if (not $cron()) {
        $orphan = $_orphan()
        if $orphan { $lib.globals.set($cronglobal, $orphan.iden) }  // noqa: R005
        else { $schedule($info.period) }
    }
    return((true))
}

// ---- Settings ----

function tagSettings() {
    return(({
        "prefix": $lib.globals.get("slib:malpedia:tag:prefix"),  // noqa: R005
        "tlp": $lib.globals.get("slib:malpedia:tag:tlp"),  // noqa: R005
    }))
}

// Set a tag prefix (name is prefix or tlp) to a normalized syn:tag (see slib.malpedia.admin.tags).
function setTagPrefix(name, prefix) {
    $norm = $lib.cast(syn:tag, $prefix)
    $lib.globals.set(`slib:malpedia:tag:{$name}`, $norm)  // noqa: R005
    return($norm)
}

// ---- Views ----

function resetView() { return($svc.resetView($lib.view.get().iden)) }
