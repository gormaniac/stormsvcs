init {
    $crtsh = $lib.import(slib.crtsh.lib)
    $util = $lib.import(slib.crtsh.util)
    $opts = ({
        "by": $cmdopts.by,
        "valid": $cmdopts.valid,
        "precerts": (not $cmdopts.no_precerts),
        "limit": $cmdopts.limit,
        "chain": $cmdopts.chain,
    })
    $explicit = $util.given($cmdopts.cert)
    // The inbound nodes seen, so the fini block can tell when there were none.
    $inbound = ([])
}

// --cert ignores inbound nodes, it's pivoted from once in the fini block.
-$explicit

$inbound.append($node.iden())
$key = $util.certKeyOf($node)
if ($key = $lib.null) {
    $lib.warn(`slib.crtsh.pivot: Unable to pivot from {$node.form()} {$node.repr()}, it needs a crypto:x509:cert with a SHA-256 or SHA-1.`)
}
-$($key = $lib.null)

($kind, $valu) = $key
divert (true) $util.nodes($crtsh.pivot($valu, $opts.by, kind=$kind, valid=$opts.valid,
                                       precerts=$opts.precerts, limit=$opts.limit, chain=$opts.chain))

fini {
    if $explicit {
        for $valu in $cmdopts.cert {
            for $n in $crtsh.pivot($valu, $opts.by, valid=$opts.valid, precerts=$opts.precerts,
                                   limit=$opts.limit, chain=$opts.chain) {
                yield $n
            }
        }
    } elif ($lib.len($inbound) = 0) {
        $lib.warn("slib.crtsh.pivot: Nothing to pivot from, give --cert or inbound nodes.")
    }
}

| uniq
