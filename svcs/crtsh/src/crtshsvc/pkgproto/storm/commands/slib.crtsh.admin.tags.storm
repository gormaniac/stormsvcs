init {
    $privadmin = $lib.import(slib.crtsh.priv.admin)

    if ($cmdopts.enable and $cmdopts.disable) {
        $lib.raise(BadArg, "slib.crtsh.admin.tags: Use --enable or --disable, not both.")
    }

    if ($cmdopts.prefix != null) {
        // An invalid prefix (ex. "" or one with spaces) would make every tag edit fail.
        $prefix = $lib.import(slib.crtsh.util).normTagPrefix($cmdopts.prefix)
        if ($prefix = null) {
            $lib.raise(BadArg, `slib.crtsh.admin.tags: {$cmdopts.prefix} isn't a valid tag name.`)
        }
        $privadmin.setTagPrefix($prefix)
    }
    if $cmdopts.enable { $privadmin.setTagsEnabled((true)) }
    if $cmdopts.disable { $privadmin.setTagsEnabled((false)) }

    $settings = $privadmin.tagSettings()
    $lib.print(`slib.crtsh tags: enabled={$settings.enabled} prefix={$settings.prefix}`)
}
