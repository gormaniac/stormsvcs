init {
    $crtsh = $lib.import(slib.crtsh.lib)
    $util = $lib.import(slib.crtsh.util)

    $opts = ({
        "dns": $cmdopts.dns,
        "cn": $cmdopts.cn,
        "org": $cmdopts.org,
        "ou": $cmdopts.ou,
        "email": $cmdopts.email,
        "ip": $cmdopts.ip,
        "uri": $cmdopts.uri,
        "subject": $cmdopts.subject,
        "identity": $cmdopts.identity,
        "issuer": $cmdopts.issuer,
        "caids": $cmdopts.caid,
        "exact": $cmdopts.exact,
        "valid": $cmdopts.valid,
        "since": $util.toTime($cmdopts.since),
        "until": $util.toTime($cmdopts.until),
        "precerts": (not $cmdopts.no_precerts),
        "limit": $cmdopts.limit,
    })

    // Any search option means inbound nodes are ignored.
    $explicit = (false)
    for $field in (dns, cn, org, ou, email, ip, uri, subject, identity, issuer, caids) {
        if $util.given($opts.$field) { $explicit = (true) }
    }
    // The inbound nodes seen, so the fini block can tell when there were none.
    $inbound = ([])
}

// Search options ignore inbound nodes, the search runs once in the fini block.
-$explicit

$inbound.append($node.iden())
$key = $util.searchKey($node)
if ($key = $lib.null) {
    $lib.warn(`slib.crtsh.search: Unable to search for {$node.form()} {$node.repr()}.`)
}
-$($key = $lib.null)

($field, $valu) = $key
divert (true) $util.nodes($crtsh.search($util.withKey($opts, $field, $valu), chain=$cmdopts.chain))

fini {
    if $explicit {
        for $n in $crtsh.search($opts, chain=$cmdopts.chain) { yield $n }
    } elif ($lib.len($inbound) = 0) {
        $lib.warn("slib.crtsh.search: Nothing to search for, give a search option (ex. --dns) or inbound nodes.")
    }
}

| uniq
