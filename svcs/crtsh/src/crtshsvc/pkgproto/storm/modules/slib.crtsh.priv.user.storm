// Privileged (asroot) wrappers around the slib.crtsh service for slib.crtsh.user.
// Every function returns the service's {status, mesg, data} dict, or emits them for generators.

init {
    $svc = $lib.service.get("slib.crtsh")
}

// The tag prefix to apply, or null when tagging is off. A prefix stored before
// slib.crtsh.admin.tags validated it, that it would refuse, turns tagging off with a warning
// instead of failing every node edit (or tagging under a rewritten prefix).
function tagPrefix() {
    if $lib.globals.get("slib:crtsh:tag:enabled") {  // noqa: R005 - $lib.globals.<name> is 3.x only
        $prefix = $lib.globals.get("slib:crtsh:tag:prefix")  // noqa: R005
        $norm = $lib.import(slib.crtsh.util).normTagPrefix($prefix)
        if ($norm != null) { return($norm) }
        $lib.warn(`slib.crtsh: The tag prefix {$prefix} isn't a valid tag name, no tags are applied. Fix it with slib.crtsh.admin.tags --prefix.`)
    }
    return()
}

// Lookups

function lookup(kind, valus, limit=(100)) { return($svc.lookup($kind, $valus, limit=$limit)) }
function chain(valu, kind=(null)) { return($svc.chain($valu, kind=$kind)) }

function cas(name=(null), caids=(null), certs=(false), limit=(100)) {
    return($svc.cas(name=$name, caids=$caids, certs=$certs, limit=$limit))
}

// Search and pivots

function search(opts) {
    for $retn in $svc.searchGenr(dns=$opts.dns, cn=$opts.cn, org=$opts.org, ou=$opts.ou,
                                 email=$opts.email, ip=$opts.ip, uri=$opts.uri,
                                 subject=$opts.subject, identity=$opts.identity,
                                 issuer=$opts.issuer, caids=$opts.caids, exact=$opts.exact,
                                 valid=$opts.valid, since=$opts.since, until=$opts.until,
                                 precerts=$opts.precerts, limit=$opts.limit) {
        emit $retn
    }
}

function issued(caids=(null), valu=(null), kind=(null), valid=(false), since=(null),
                until=(null), precerts=(true), limit=(100)) {
    for $retn in $svc.issuedGenr(caids=$caids, valu=$valu, kind=$kind, valid=$valid, since=$since,
                                 until=$until, precerts=$precerts, limit=$limit) {
        emit $retn
    }
}

function pivot(valu, by, kind=(null), valid=(false), precerts=(true), limit=(100)) {
    for $retn in $svc.pivotGenr($valu, $by, kind=$kind, valid=$valid, precerts=$precerts, limit=$limit) {
        emit $retn
    }
}
