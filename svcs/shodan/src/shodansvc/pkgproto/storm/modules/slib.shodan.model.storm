// Model normalized Shodan data (see shodansvc.norm) in Synapse.
//
// Node edits here run as the calling user. Every node created is linked to the
// slib.shodan meta:source node with a -(seen)> edge.

init {
    $sourceGuid = "5c1b0a3d0e7f4b2e9a8c6d4f2b1e0a97"
    $util = $lib.import(slib.shodan.util)
}

// ---- Helpers that return a single node ----
//
// NOTE: A for loop that runs while a node is in a function's pipeline sends the
// node downstream after its first iteration, reaching return() and ending the
// function early. So functions here only yield a node when they don't loop, and
// loops call helpers that yield/edit the node in their own runtime instead.

// Link the node to the slib.shodan meta:source and update its .seen.
function seen(n, time=$lib.null) {
    yield $n
    [ <(seen)+ { [ meta:source=$sourceGuid :name=shodan ] } ]
    if $time { [ .seen ?= $time ] }
    return($n)
}

// Apply Shodan's tags (cloud, vpn, honeypot, etc.) to a node under the configured prefix.
function applyTags(n, tagPrefix, tags) {
    if ($tagPrefix = $lib.null or not $tags) { return($n) }
    // Never loop with a node in a function's pipeline, the node would reach return() after the first iteration.
    for $tag in $lib.tags.prefix($tags, $tagPrefix) { $addTag($n, $tag) }
    return($n)
}

function addTag(n, tag) {
    yield $n
    [ +#$tag ]
    return($n)
}

function ipNode(ip, time=$lib.null) {
    if $util.isIpv6($ip) { [ inet:ipv6?=$ip ] }
    else { [ inet:ipv4?=$ip ] }
    return($seen($node, $time))
}

function fqdnNode(fqdn, time=$lib.null) {
    [ inet:fqdn?=$fqdn ]
    return($seen($node, $time))
}

function asnNode(asn, org=$lib.null) {
    $num = $lib.regex.replace("(?i)^AS", "", $lib.cast(str, $asn))
    [ inet:asn?=$num ]
    if $org {
        [ :owner ?= { yield $lib.gen.orgByName($org) } ]
    }
    return($node)
}

function dnsNode(fqdn, ip, time=$lib.null) {
    if $util.isIpv6($ip) { [ inet:dns:aaaa?=($fqdn, $ip) ] }
    else { [ inet:dns:a?=($fqdn, $ip) ] }
    return($seen($node, $time))
}

function serverNode(ip, port, transport=tcp, time=$lib.null) {
    if $util.isIpv6($ip) { $server = `{$transport}://[{$ip}]:{$port}` }
    else { $server = `{$transport}://{$ip}:{$port}` }
    [ inet:server?=$server ]
    return($seen($node, $time))
}

function bannerNode(server, text, time=$lib.null) {
    [ inet:banner?=($server, $text) ]
    return($seen($node, $time))
}

// Model an HTTP response header from a banner, linked with a -(refs)> edge from the banner.
function httpHeaderNode(banner, header, time=$lib.null) {
    [ inet:http:response:header?=($header.name, $header.value) ]
    [ <(refs)+ $banner ]
    return($seen($node, $time))
}

// Model an SSH server's public host key as a file the server hosts (inet:servfile).
// The file is the key as OpenSSH saves it to disk, "<algo> <base64 key>\n" (see
// shodansvc.norm.normSshKey), so it matches .pub and keyscan output by hash.
// The file:bytes and inet:servfile are tagged <prefix>.banner, since they're extracted from a banner.
function sshKeyNode(server, key, time=$lib.null, tagPrefix=$lib.null) {
    // Only users allowed to upload to the Axon save the bytes, the file:bytes node is made either way.
    if $lib.user.allowed(axon.upload) {
        try { $lib.axon.put($key.text.encode()) }
        catch * as err {
            $lib.warn("slib.shodan: Unable to save the SSH key {sha256} to the Axon: {error}",
                      sha256=$key.sha256, error=$err.mesg)
        }
    }

    [ file:bytes=$key.sha256
        :size=$key.size
        :md5=$key.md5
        :sha1=$key.sha1
        :sha512=$key.sha512
        :mime=text/plain
    ]
    $file = $seen($node, $time)
    $applyTags($file, $tagPrefix, (banner,))

    [ inet:servfile=($server.value(), $file.value()) ]
    $servfile = $seen($node, $time)
    $applyTags($servfile, $tagPrefix, (banner,))
    return($file)
}

// Create an it:prod:softver from a CPE (preferred) or a product name/version,
// and link the node that runs it with a -(uses)> edge.
function softverNode(user, cpe=$lib.null, product=$lib.null, version=$lib.null) {
    $props = $lib.null
    if $cpe {
        ($ok, $normcpe) = $lib.trycast(it:sec:cpe, $cpe)
        if $ok { $props = ({"cpe": $normcpe}) }
    }
    if ($props = $lib.null and $product) {
        $props = ({"name": $product})
        if $version { $props.vers = $version }
    }
    if ($props = $lib.null) { return($lib.null) }

    [ it:prod:softver=$props ]
    if $product { [ :name ?= $product ] }
    if $version { [ :vers ?= $version ] }
    if $user { [ <(uses)+ { yield $user } ] }
    return($node)
}

function vulnNode(cve) {
    return($lib.gen.vulnByCve($cve, try=(true)))
}

// Model that a node (inet:ipv4/6 or inet:server) is vulnerable to a CVE.
function vulnerableNode(n, vuln, time=$lib.null) {
    $vulnnode = $vulnNode($vuln.cve)
    if ($vulnnode = $lib.null) { return($lib.null) }

    if $vuln.summary { $setDesc($vulnnode, $vuln.summary) }

    [ risk:vulnerable=({"node": [$n.form(), $n.value()], "vuln": $vulnnode.value()}) ]
    return($seen($node, $time))
}

// Set :desc on a node only if it doesn't already have one.
function setDesc(n, desc) {
    yield $n
    if (not :desc) { [ :desc ?= $desc ] }
    return($n)
}

function certNode(server, cert, time=$lib.null) {
    [ crypto:x509:cert=({"sha256": $cert.sha256}) ]
    [
        :sha1 ?= $cert.sha1
        :serial ?= $cert.serial
        :subject ?= $cert.subject
        :issuer ?= $cert.issuer
        :validity:notbefore ?= $cert.notbefore
        :validity:notafter ?= $cert.notafter
        :selfsigned ?= $cert.selfsigned
        :version ?= $cert.version
    ]
    if $cert.subject_cn {
        [ :identities:fqdns ?+= $cert.subject_cn ]
    }
    $certnode = $seen($node, $time)

    [ inet:tls:servercert=($server, $certnode.value()) ]
    $seen($node, $time)
    return($certnode)
}

function setAsn(n, asn, org=$lib.null) {
    $asnnode = $asnNode($asn, $org)
    if ($asnnode = $lib.null) { return($n) }
    yield $n
    [ :asn ?= $asnnode.value() ]
    return($n)
}

// Model a single DNS record from the Shodan DNS domain API.
function dnsRecordNode(rec) {
    $fqdn = $rec.fqdn
    $valu = $rec.value
    switch $rec.type {
        "A": { [ inet:dns:a?=($fqdn, $valu) ] }
        "AAAA": { [ inet:dns:aaaa?=($fqdn, $valu) ] }
        "CNAME": { [ inet:dns:cname?=($fqdn, $valu) ] }
        "MX": { [ inet:dns:mx?=($fqdn, $valu) ] }
        "NS": { [ inet:dns:ns?=($fqdn, $valu) ] }
        "TXT": { [ inet:dns:txt?=($fqdn, $valu) ] }
        "SOA": { [ inet:dns:soa=({"fqdn": $fqdn, "ns": $valu}) ] }
        *: { return($lib.null) }
    }
    return($seen($node, $rec.seen))
}

// ---- Modeling for full API results, each returns the primary node ----

// Model a normalized banner. Returns the inet:server node.
function banner(b, tagPrefix=$lib.null) {
    $res = $bannerNodes($b, $tagPrefix)
    if ($res = $lib.null) { return($lib.null) }
    return($res.server)
}

// Model a normalized banner. Returns ({"server": <inet:server>, "banner": <inet:banner or null>,
// "ip": <inet:ipv4/6 or null>}), the nodes the banner itself describes, or null.
// Queries and timelines link to only these nodes, everything else is one hop from them.
// A historical banner (from a history lookup) is an old observation, so what it says about the
// current state isn't modeled: its vulns, and the IP's ASN (which overwrites). Shodan's tags for
// it go on its inet:banner, a snapshot of what was seen, instead of the current inet:server.
function bannerNodes(b, tagPrefix=$lib.null, historical=(false)) {
    $srv = $serverNode($b.ip, $b.port, $b.transport, $b.timestamp)
    if ($srv = $lib.null) { return($lib.null) }

    $ipnode = $ipNode($b.ip, $b.timestamp)
    if ((not $historical) and $b.asn and $ipnode) { $setAsn($ipnode, $b.asn, $b.org) }

    $bannernode = $lib.null
    if $b.data {
        $bannernode = $bannerNode($srv.repr(), $b.data, $b.timestamp)
        // Date headers aren't included, see shodansvc.norm.normHttpHeaders.
        if $bannernode {
            for $header in $b.http_headers { $httpHeaderNode($bannernode, $header, $b.timestamp) }
        }
    }

    if (not $historical) { $applyTags($srv, $tagPrefix, $b.tags) }
    elif $bannernode { $applyTags($bannernode, $tagPrefix, $b.tags) }

    if ($b.ssh and $b.ssh.pubkey) { $sshKeyNode($srv, $b.ssh.pubkey, $b.timestamp, $tagPrefix) }

    // See shodansvc.norm.normSoftvers for how CPEs are paired with the product/version.
    for $sv in $b.softvers { $softverNode($srv, $sv.cpe, $sv.product, $sv.version) }

    if (not $historical) {
        for $vuln in $b.vulns { $vulnerableNode($srv, $vuln, $b.timestamp) }
    }

    if $b.cert { $certNode($srv.repr(), $b.cert, $b.timestamp) }

    for $hostname in $b.hostnames { $dnsNode($hostname, $b.ip, $b.timestamp) }

    return(({"server": $srv, "banner": $bannernode, "ip": $ipnode}))
}

// Model the banners of a history lookup (/shodan/host/{ip}?history=true). Returns the IP node.
//
// Only the banners are modeled, as historical ones (see bannerNodes): a history lookup's host-level
// fields (vulns, ports, tags, ...) are combined over its whole history, and old vulns and ASNs
// aren't current. Each banner's tags go on its inet:banner. The current host comes from a plain lookup (see slib.shodan.lib.host). With
// timeline, each banner is added to the IP's timeline.
function historyBanners(h, tagPrefix=$lib.null, timeline=(false)) {
    $ipnode = $ipNode($h.ip)
    if ($ipnode = $lib.null) { return($lib.null) }

    $tl = $lib.null
    if ($timeline and $h.banners) { $tl = $timelineNode($ipnode) }
    for $b in $h.banners {
        $res = $bannerNodes($b, $tagPrefix, historical=(true))
        if ($tl and $res) { $eventNode($tl, $b, $res) }
    }
    return($ipnode)
}

// ---- Host history timelines ----
//
// Every Shodan banner is one observation of one service at one time, so each becomes a meta:event
// in the IP's meta:timeline. Re-running a lookup adds only the banners not seen before.
//
// NOTE: :title and :summary are only set when they're unset, so analysts can edit them.

// The meta:timeline of an IP's Shodan history (one per IP), linked -(refs)> to the IP.
function timelineNode(ipnode) {
    $repr = $ipnode.repr()
    [ meta:timeline=$lib.guid(slib.shodan, history, $repr) :type=svc.shodan.host.history. ]
    if (not :title) { [ :title=`Shodan history: {$repr}` ] }
    if (not :summary) {
        [ :summary=`Shodan banners observed for {$repr}, one meta:event per banner. Shodan's history covers 90 days and at most the latest 1,000 banners per lookup.` ]
    }
    [ +(refs)> $ipnode ]
    return($seen($node))
}

// The guid of a banner's meta:event: Shodan's banner ID, or (without one) the fields that identify
// a single crawl. timestamp has microseconds, so the fallback is unique per crawl.
function eventGuid(b) {
    if $b.id { return($lib.guid(slib.shodan, banner, $b.id)) }
    return($lib.guid(slib.shodan, banner, $b.ip, $b.port, $b.transport, $b.timestamp, $b.hash))
}

// Ex. "tcp/22 OpenSSH 8.9p1", or "tcp/80 http" (the crawler's module) without a product.
function eventTitle(b) {
    $parts = ([`{$b.transport}/{$b.port}`])
    if $b.product {
        $parts.append($b.product)
        if $b.version { $parts.append($b.version) }
    } elif $b.module {
        $parts.append($b.module)
    }
    return((" ").join($parts))
}

function eventSummary(b) {
    $summary = $lib.null
    if $b.scan { $summary = `On-demand scan {$b.scan}` }
    elif $b.crawler { $summary = `Crawler {$b.crawler}` }
    if $b.truncated {
        $cut = `truncated: {(", ").join($b.truncated)}`
        if $summary { $summary = `{$summary} ({$cut})` }
        else { $summary = `({$cut})` }
    }
    return($summary)
}

// Add a banner to a timeline as a meta:event, linked -(refs)> to only the inet:server, inet:banner,
// and IP the banner describes (res, from bannerNodes). Returns the meta:event.
function eventNode(timeline, b, res) {
    $title = $eventTitle($b)
    $summary = $eventSummary($b)

    [ meta:event=$eventGuid($b)
        :timeline=$timeline
        :time?=$b.timestamp
        :type=svc.shodan.banner.
    ]
    if (not :title) { [ :title=$title ] }
    if ((not :summary) and $summary) { [ :summary=$summary ] }

    // No loop here, the node is in the pipeline (see the NOTE at the top).
    if $res.server { [ +(refs)> $res.server ] }
    if $res.banner { [ +(refs)> $res.banner ] }
    if $res.ip { [ +(refs)> $res.ip ] }

    return($seen($node))
}

// ---- Saved queries ----
//
// Saved Shodan queries are meta:rule nodes (:text is the query) of two kinds, which never sync:
//
//   - Community queries, copied from Shodan's query directory: :type svc.shodan.query.community.,
//     with a :name that starts with "[Community] " (Synapse lower-cases :name, so "[community] ").
//   - Local queries, saved in the Cortex: :type svc.shodan.query.local. They're never sent to
//     Shodan. Rules with the bare parent type, svc.shodan.query., are migrated to it by the
//     package's inits (see slib.shodan.yaml), and aren't saved queries.
//
// The same query text is a different node for each kind. :name, :desc, and :created are only set
// when they're unset, so analysts can edit them.

function communityPrefix() { return("[Community] ") }

function communityGuid(text) { return($lib.guid(slib.shodan, query, community, $text)) }
function localGuid(text) { return($lib.guid(slib.shodan, query, local, $text)) }

// Lift a meta:rule by guid. Returns the node, or null.
function liftRule(guid) {
    meta:rule=$guid
    return($node)
}

// Model a saved query from Shodan's directory as a community meta:rule. Returns the node.
function communityRule(q, tagPrefix=$lib.null) {
    $text = $lib.cast(str, $q.query)
    $name = $q.title
    if (not $name) { $name = $text }
    // :name is lower-cased, so the prefix is checked ignoring case.
    if (not $name.lower().startswith($communityPrefix().lower())) { $name = `{$communityPrefix()}{$name}` }

    [ meta:rule=$communityGuid($text) :type=svc.shodan.query.community. :text=$text ]
    if (not :name) { [ :name=$name ] }
    if ((not :desc) and $q.description) { [ :desc=$q.description ] }
    if (not :created) { [ :created?=$q.timestamp ] }
    if (not :url) { [ :url?=`https://www.shodan.io/search?query={$lib.inet.http.urlencode($text)}` ] }
    $rule = $seen($node)

    if ($tagPrefix != $lib.null and $q.tags) { $applyTags($rule, `{$tagPrefix}.query`, $q.tags) }
    return($rule)
}

// Save a query in the Cortex as a local meta:rule. Returns the node.
function localRule(text, name, desc=$lib.null) {
    [ meta:rule=$localGuid($text) :type=svc.shodan.query.local. :text=$text ]
    if (not :name) { [ :name=$name ] }
    if ((not :desc) and $desc) { [ :desc=$desc ] }
    if (not :created) { [ :created=now ] }
    return($node)
}

// ---- Query executions ----

// Create the it:exec:query for one run of a Shodan query. Every run is its own node.
// ref is the inbound node the query was built from, if any (it:exec:query -(refs)> ref).
// opts must never hold an API key.
function queryNode(text, apiurl, opts, ref=$lib.null) {
    [ it:exec:query=*
        :text=$text
        :language=shodan
        :time=now
        :synuser=$lib.user.iden
        :api:url?=$apiurl
        :opts=$opts
    ]
    if $ref { [ +(refs)> $ref ] }
    return($seen($node))
}

// Link a node to another it references (n -(refs)> target).
function linkRefs(n, target) {
    yield $n
    [ +(refs)> $target ]
    return($n)
}

// Link a query to the nodes it returned (it:exec:query -(found)> n), skipping nulls.
function found(query, nodes) {
    // No node in this function's pipeline, so looping is safe (see the NOTE at the top).
    for $n in $nodes {
        if $n { $linkFound($query, $n) }
    }
}

function linkFound(query, n) {
    yield $n
    [ <(found)+ $query ]
    return($n)
}

// Record how many results a query consumed.
function setOffset(query, offset) {
    yield $query
    [ :offset=$offset ]
    return($query)
}

// Model a normalized host (from the Shodan host API or InternetDB). Returns the IP node.
// With timeline, each banner is also added to the IP's Shodan history timeline (see timelineNode).
function host(h, tagPrefix=$lib.null, timeline=(false)) {
    $ipnode = $ipNode($h.ip, $h.last_update)
    if ($ipnode = $lib.null) { return($lib.null) }

    if $h.asn { $setAsn($ipnode, $h.asn, $h.org) }
    if $h.location { $setLocation($ipnode, $h.location) }

    $applyTags($ipnode, $tagPrefix, $h.tags)

    for $hostname in $h.hostnames { $dnsNode($hostname, $h.ip, $h.last_update) }

    for $vuln in $h.vulns { $vulnerableNode($ipnode, $vuln, $h.last_update) }

    // InternetDB results have CPEs at the host level.
    if $h.cpes {
        for $cpe in $h.cpes { $softverNode($ipnode, $cpe) }
    }

    if $h.banners {
        $tl = $lib.null
        if $timeline { $tl = $timelineNode($ipnode) }
        for $b in $h.banners {
            $res = $bannerNodes($b, $tagPrefix)
            if ($tl and $res) { $eventNode($tl, $b, $res) }
        }
    } else {
        // Minified host lookups and InternetDB only give us open ports.
        for $port in $h.ports { $serverNode($h.ip, $port, tcp, $h.last_update) }
    }

    return($ipnode)
}

// Model a normalized CVE/advisory (from CVEDB). Returns the risk:vuln node.
function cve(c, tagPrefix=$lib.null, cpes=(false)) {
    if $c.cve {
        $vulnnode = $vulnNode($c.cve)
        if $vulnnode { $cveNode($c) }
    } elif $c.aliases {
        // A GHSA/EUVD advisory without a CVE.
        $vulnnode = $advisoryNode($c.aliases.0)
    } else {
        return($lib.null)
    }
    if ($vulnnode = $lib.null) { return($lib.null) }

    $setVulnProps($vulnnode, $c)
    for $alias in $c.aliases { $addArrayValu($vulnnode, names, $alias) }
    for $cwe in $c.cwes { $addArrayValu($vulnnode, cwes, $cwe) }
    if $c.kev { $applyTags($vulnnode, $tagPrefix, (kev,)) }
    $seen($vulnnode, $c.published)

    if $cpes {
        for $cpe in $c.cpes {
            ($ok, $normcpe) = $lib.trycast(it:sec:cpe, $cpe)
            if $ok { $softverCve($normcpe, $c.cve) }
        }
    }

    return($vulnnode)
}

function setVulnProps(n, c) {
    yield $n
    if $c.summary {
        [ :cve:desc ?= $c.summary ]
        if (not :desc) { [ :desc ?= $c.summary ] }
    }
    if $c.references { [ :cve:references ?= $c.references ] }
    if $c.published { [ :timeline:published ?= $c.published ] }
    if ($c.cvss_v3 != $lib.null) { [ :cvss:v3_1:score ?= $c.cvss_v3 ] }
    if ($c.cvss_v2 != $lib.null) { [ :cvss:v2_0:score ?= $c.cvss_v2 ] }
    // Advisories without a CVE only have an unversioned score.
    if ($c.cve = "" and $c.cvss != $lib.null) { [ :cvss:v3_1:score ?= $c.cvss ] }
    return($n)
}

function setLocation(n, loc) {
    yield $n
    if $loc.latlong { [ :latlong ?= $loc.latlong ] }
    if $loc.country_code { [ :loc ?= $loc.country_code ] }
    return($n)
}

function advisoryNode(advid) {
    [ risk:vuln=({"id": $advid}) ]
    return($node)
}

// Add a value to an array property, if it is valid.
function addArrayValu(n, prop, valu) {
    yield $n
    [ :$prop ?+= $valu ]
    return($n)
}

function cveNode(c) {
    // it:sec:cve:desc/references are deprecated, the details live on the risk:vuln.
    [ it:sec:cve?=$c.cve ]
    return($seen($node, $c.published))
}

function softverCve(cpe, cve) {
    [ it:prod:softver=({"cpe": $cpe}) :cves += $cve ]
    return($node)
}

// Yield the given non-null nodes. Lets commands divert to nodes returned by the functions above.
function nodes(items) {
    for $item in $items {
        if $item { yield $item }
    }
}
