// The slib.shodan user API. Each function queries Shodan, models the results,
// and returns the resulting node(s). Errors are reported as warnings.
//
// Usable directly from Storm, ex:
//     $shodan = $lib.import(slib.shodan.lib)
//     $ipnode = $shodan.host(8.8.8.8)

init {
    $priv = $lib.import(slib.shodan.priv.user)
    $model = $lib.import(slib.shodan.model)
    $util = $lib.import(slib.shodan.util)
}

// Look up an IP in Shodan (or InternetDB) and model it. Returns the IP node, or null.
//
// With history, Shodan's history of the IP (90 days, at most the latest 1,000 banners) is looked up
// too, after a plain lookup of its current data: the history lags the current data by about a day.
// The current host is modeled from the plain lookup, and only the banners from the history, without
// their vulns (see slib.shodan.model.historyBanners).
//
// With timeline, each banner is also added to the IP's Shodan history meta:timeline as a meta:event
// (see slib.shodan.model.timelineNode). It defaults to history. Lookups without banners (minify,
// InternetDB) have nothing to add.
function host(ip, history=(false), minify=(false), internetdb=(false), timeline=$lib.null) {
    if ($timeline = $lib.null) { $timeline = $history }
    $ip = $lib.cast(str, $ip)
    $tagPrefix = $priv.tagPrefix()

    if ((not $internetdb) and (not $priv.hasKey())) {
        $lib.warn("slib.shodan: No Shodan API key is available, falling back to InternetDB.")
        $internetdb = (true)
    }

    if $internetdb {
        $retn = $priv.internetdb($ip)
        $what = `InternetDB lookup of {$ip}`
    } else {
        $retn = $priv.host($ip, minify=$minify)
        $what = `Host lookup of {$ip}`
    }

    if ($timeline and ($internetdb or $minify)) {
        $lib.warn("slib.shodan: {what} has no banners to add to a timeline.", what=$what)
    }

    $ipnode = $lib.null
    if (not $util.failed($retn, $what)) { $ipnode = $model.host($retn.data, $tagPrefix, timeline=$timeline) }

    if ($history and not $internetdb) {
        $hretn = $priv.host($ip, history=(true), minify=$minify)
        if (not $util.failed($hretn, `History lookup of {$ip}`)) {
            $hnode = $model.historyBanners($hretn.data, $tagPrefix, timeline=$timeline)
            if ($ipnode = $lib.null) { $ipnode = $hnode }
        }
    }
    return($ipnode)
}

// The endpoint recorded as the :api:url of a search's it:exec:query.
function searchUrl() { return($priv.apiUrl("/shodan/host/search")) }

// Model the banners from a Shodan query, recording the run as an it:exec:query (see
// slib.shodan.model.queryNode) linked -(found)> to each banner's inet:server, inet:banner, and IP.
//
// retns is a generator of the service's {status, mesg, data} dicts with normalized banners, ex.
// $priv.searchGenr(). text, apiurl, opts, and ref are recorded on the it:exec:query.
//
// Emits ({"query": <it:exec:query>, "ip": <inet:ipv4/6 or null>}) for each banner, then a final
// ({"query": <it:exec:query>, "ip": null, "done": (true)}). The query node is only created once the
// query has succeeded, so failed queries (reported as warnings) leave nothing behind and emit nothing.
function ingest(retns, what, text, apiurl, opts, ref=$lib.null) {
    $tagPrefix = $priv.tagPrefix()
    $qnode = $lib.null
    $nread = (0)
    $failed = (false)

    for $retn in $retns {
        if $util.failed($retn, $what) {
            $failed = (true)
            break
        }
        if ($qnode = $lib.null) { $qnode = $model.queryNode($text, $apiurl, $opts, $ref) }

        $nread = ($nread + 1)
        $res = $model.bannerNodes($retn.data, $tagPrefix)
        if $res {
            $model.found($qnode, ($res.server, $res.banner, $res.ip))
            emit ({"query": $qnode, "ip": $res.ip})
        }
    }

    // A failure after some results still records the results that were ingested.
    if ($failed and $qnode = $lib.null) { stop }

    // A query that matched nothing is still a run worth recording.
    if ($qnode = $lib.null) { $qnode = $model.queryNode($text, $apiurl, $opts, $ref) }
    $model.setOffset($qnode, $nread)
    emit ({"query": $qnode, "ip": $lib.null, "done": (true)})
}

// Search Shodan, model every matching banner, and record the run as an it:exec:query.
// ref is the node the query was built from, if any. Returns ({"query": <it:exec:query>,
// "ips": [<inet:ipv4/6>, ...]}), or null if the search failed (reported as a warning).
function search(query, limit=(100), minify=(false), page=(1), ref=$lib.null) {
    $query = $lib.cast(str, $query)
    $opts = ({"command": "slib.shodan.lib.search", "limit": $limit, "page": $page, "minify": $minify})
    $genr = $priv.searchGenr($query, limit=$limit, minify=$minify, page=$page)

    $qnode = $lib.null
    $ips = ([])
    $seen = ({})
    for $res in $ingest($genr, "Search", $query, $searchUrl(), $opts, ref=$ref) {
        $qnode = $res.query
        if $res.ip {
            $iden = $res.ip.iden()
            if (not $seen.$iden) {
                $seen.$iden = (true)
                $ips.append($res.ip)
            }
        }
    }
    if ($qnode = $lib.null) { return($lib.null) }
    return(({"query": $qnode, "ips": $ips}))
}

// The endpoint recorded as the :api:url of a count's it:exec:query.
function countUrl() { return($priv.apiUrl("/shodan/host/count")) }

// List the IPs matching a query with Shodan's free count API (no query credits) and model them,
// recording the run as an it:exec:query linked -(found)> to each IP. Only the IPs are modeled,
// never the counts. ref is the node the query was built from, if any.
//
// size is the number of IPs to ask for, defaulting to the most the API key's plan allows (one
// call returns at most that many). facets are extra facets to return for printing only.
//
// Returns ({"query": <it:exec:query>, "ips": [<inet:ipv4/6>, ...], "size": <n>, "full": <bool>,
// "facets": {...}}), or null if the count failed (reported as a warning). full is true when the IPs
// fill the size asked for, so the query likely matches more IPs than were returned.
function count(query, size=$lib.null, facets=$lib.null, ref=$lib.null) {
    $query = $lib.cast(str, $query)
    $retn = $priv.countIps($query, size=$size, facets=$facets)
    if $util.failed($retn, `Counting {$query}`) { return($lib.null) }
    $data = $retn.data

    if $data.lowered {
        $lib.warn("slib.shodan: Your plan returns at most {size} IPs per count, asked for {asked}.",
                  size=$data.size, asked=$size)
    }

    $opts = ({"command": "slib.shodan.lib.count", "size": $data.size, "facets": $facets, "full": $data.full})
    $qnode = $model.queryNode($query, $countUrl(), $opts, $ref)

    $ips = ([])
    for $ip in $data.ips {
        $ipnode = $model.ipNode($ip)
        if $ipnode { $ips.append($ipnode) }
        else { $lib.warn("slib.shodan: Skipping {ip} from the count of {query}, it isn't an IP.", ip=$ip, query=$query) }
    }
    $model.found($qnode, $ips)
    $model.setOffset($qnode, $ips.size())

    if $data.full {
        if ($data.limit != $lib.null and $data.size >= $data.limit) {
            $lib.warn("slib.shodan: {query} returned {size} IPs, the most your plan allows in one call. It likely matches more, narrow the query (ex. add country: or asn:) to get the rest.",
                      query=$query, size=$data.size)
        } elif ($size != $lib.null) {
            $lib.warn("slib.shodan: {query} returned {size} IPs, the size asked for. It likely matches more, ask for more to get the rest.",
                      query=$query, size=$data.size)
        } else {
            $lib.warn("slib.shodan: {query} returned {size} IPs, the most one call can return. It likely matches more, narrow the query (ex. add country: or asn:) to get the rest.",
                      query=$query, size=$data.size)
        }
    }

    return(({"query": $qnode, "ips": $ips, "size": $data.size, "full": $data.full, "facets": $data.facets}))
}

// Retrieve and model the DNS records for a domain. Returns a list of the subdomain inet:fqdn nodes.
function domain(domain, history=(false), rtype=$lib.null, maxpages=(10)) {
    $domain = $lib.cast(str, $domain)
    $retn = $priv.dnsDomain($domain, history=$history, rtype=$rtype, maxpages=$maxpages)
    if $util.failed($retn, `DNS lookup of {$domain}`) { return(([])) }

    $data = $retn.data
    for $rec in $data.records { $model.dnsRecordNode($rec) }

    $domnode = $model.fqdnNode($domain)
    $model.applyTags($domnode, $priv.tagPrefix(), $data.tags)

    $nodes = ([])
    for $sub in $data.subdomains {
        $subnode = $model.fqdnNode(`{$sub}.{$domain}`)
        if $subnode { $nodes.append($subnode) }
    }

    if $data.more {
        $lib.warn("slib.shodan: {domain} has more DNS results than were retrieved, increase --pages.", domain=$domain)
    }

    return($nodes)
}

// Resolve a hostname to an IP. Returns the IP node, or null.
function resolve(fqdn) {
    $fqdn = $lib.cast(str, $fqdn)
    $retn = $priv.dnsResolve(($fqdn,))
    if $util.failed($retn, `DNS resolution of {$fqdn}`) { return($lib.null) }

    $ip = $retn.data.$fqdn
    if (not $ip) { return($lib.null) }

    $model.dnsNode($fqdn, $ip)
    return($model.ipNode($ip))
}

// Reverse resolve an IP to hostnames. Returns a list of the inet:fqdn nodes.
function reverse(ip) {
    $ip = $lib.cast(str, $ip)
    $retn = $priv.dnsReverse(($ip,))
    if $util.failed($retn, `Reverse DNS lookup of {$ip}`) { return(([])) }

    $nodes = ([])
    $hostnames = $retn.data.$ip
    if (not $hostnames) { return($nodes) }

    $ipnode = $model.ipNode($ip)
    for $hostname in $hostnames {
        $model.dnsNode($hostname, $ip)
        $fqdnnode = $model.fqdnNode($hostname)
        if $fqdnnode { $nodes.append($fqdnnode) }
    }
    if ($ipnode and $nodes) {
        yield $ipnode
        [ :dns:rev ?= $hostnames.0 ]
    }

    return($nodes)
}

// Retrieve and model a CVE, GHSA, or EUVD ID from CVEDB. Returns the risk:vuln node, or null.
function cve(vulnid, cpes=(false)) {
    $vulnid = $lib.cast(str, $vulnid).upper()
    $retn = $priv.vuln($vulnid)
    if $util.failed($retn, `CVEDB lookup of {$vulnid}`) { return($lib.null) }
    return($model.cve($retn.data, $priv.tagPrefix(), $cpes))
}

// Search CVEDB for CVEs affecting a CPE or product. Returns a list of risk:vuln nodes.
function cves(cpe23=$lib.null, product=$lib.null, kev=(false), epss=(false), limit=(100),
              start=$lib.null, end=$lib.null, cpes=(false)) {

    $retn = $priv.cves(cpe23=$cpe23, product=$product, kev=$kev, epss=$epss,
                       limit=$limit, start=$start, end=$end)
    if $util.failed($retn, "CVEDB search") { return(([])) }

    $tagPrefix = $priv.tagPrefix()
    $nodes = ([])
    for $c in $retn.data.cves {
        $vuln = $model.cve($c, $tagPrefix, $cpes)
        if $vuln { $nodes.append($vuln) }
    }
    return($nodes)
}

// Count the CVEDB CVEs affecting a CPE or product. Returns the count, or null on error.
function countCves(cpe23=$lib.null, product=$lib.null, kev=(false), start=$lib.null, end=$lib.null) {
    $retn = $priv.cves(cpe23=$cpe23, product=$product, kev=$kev, start=$start, end=$end, count=(true))
    if $util.failed($retn, "CVEDB count") { return($lib.null) }
    return($retn.data.total)
}

// Calculate Shodan's banner hash for an inet:banner node or banner text. Search for banners
// with the same text using the "hash:<n>" search filter. Returns the hash, or null.
//
// The hash is calculated from the text, so it works for banners from any source.
function bannerHash(banner) {
    $text = $banner
    if ($lib.vars.type($banner) = "node") {
        if ($banner.form() != "inet:banner") {
            $lib.warn("slib.shodan: Only inet:banner nodes have a banner hash, not {form}.", form=$banner.form())
            return($lib.null)
        }
        $text = $banner.props.text
    }
    if ($text = $lib.null) { return($lib.null) }

    $retn = $priv.bannerHash($lib.cast(str, $text))
    if $util.failed($retn, "Calculating the banner hash") { return($lib.null) }
    return($retn.data)
}

// The max size of a file:bytes to read from the Axon and hash (16 MiB).
// Storm reads the Axon at most 1 MiB at a time.
function maxFileHashSize() { return((16777216)) }

// Calculate Shodan's hash of a file:bytes node's bytes, for "http.favicon.hash:<n>" (kind=favicon)
// or "http.html_hash:<n>" (kind=html) searches. Without a kind, it comes from the file's :mime,
// image/* is a favicon and text/html (or application/xhtml+xml) is HTML.
//
// The bytes must be in the Axon, and the user needs axon.has and axon.get.
// Returns ({"kind": <kind>, "hash": <n>}), or null.
function fileHash(file, kind=$lib.null) {
    if ($file.form() != "file:bytes") {
        $lib.warn("slib.shodan: Only file:bytes nodes have a file hash, not {form}.", form=$file.form())
        return($lib.null)
    }

    if (not $kind) {
        $mime = $file.props.mime
        if ($mime and $mime.startswith("image/")) { $kind = favicon }
        elif ($mime = "text/html" or $mime = "application/xhtml+xml") { $kind = html }
        else {
            $lib.warn("slib.shodan: Unable to tell if file:bytes {file} is a favicon or HTML from its :mime ({mime}), use --file-hash.",
                      file=$file.repr(), mime=$mime)
            return($lib.null)
        }
    }

    $sha256 = $file.props.sha256
    if (not $sha256) {
        $lib.warn("slib.shodan: file:bytes {file} has no :sha256 to read it from the Axon.", file=$file.repr())
        return($lib.null)
    }

    try {
        $size = $lib.axon.size($sha256)
        if ($size = $lib.null) {
            $lib.warn("slib.shodan: file:bytes {file} isn't in the Axon.", file=$file.repr())
            return($lib.null)
        }
        if ($size > $maxFileHashSize()) {
            $lib.warn("slib.shodan: file:bytes {file} is too large to hash ({size} bytes).", file=$file.repr(), size=$size)
            return($lib.null)
        }

        $chunks = ([])
        $offs = (0)
        while ($offs < $size) {
            $chunks.append($lib.axon.read($sha256, offs=$offs))
            $offs = ($offs + 1048576)
        }
    } catch AuthDeny as err {
        $lib.warn("slib.shodan: Unable to read file:bytes {file} from the Axon: {error}", file=$file.repr(), error=$err.mesg)
        return($lib.null)
    }

    $retn = $priv.fileHash($chunks, $kind)
    if $util.failed($retn, "Calculating the file hash") { return($lib.null) }
    return(({"kind": $kind, "hash": $retn.data}))
}

// Quote a value for a Shodan search filter. A comma is Shodan's OR within a filter's value
// (ex. port:22,80), so commas (and quotes) are escaped.
function quote(valu) {
    $valu = $lib.cast(str, $valu).replace('"', '\"').replace(",", '\,')
    return(`"{$valu}"`)
}

function certQuery(cert) {
    // Shodan's ssl.cert.fingerprint is the SHA-1 only, a SHA-256 never matches.
    if $cert.props.sha1 { return(`ssl.cert.fingerprint:{$cert.props.sha1}`) }
    if $cert.props.serial {
        $serial = $lib.regex.replace("^0+(?=.)", "", $cert.props.serial)
        return(`ssl.cert.serial:0x{$serial}`)
    }
    $lib.warn("slib.shodan: crypto:x509:cert {cert} has no :sha1 or :serial to search for.", cert=$cert.repr())
    return($lib.null)
}

function cpeQuery(cpe) {
    $props = $cpe.props
    $query = `cpe:{$quote(`cpe:2.3:{$props.part}:{$props.vendor}:{$props.product}`)}`
    // Shodan's cpe filter ignores the CPE's version, so it's searched with the version filter.
    if ($props.version and $props.version != "*" and $props.version != "-") {
        $query = `{$query} version:{$quote($props.version)}`
    }
    return($query)
}

function liftCert(guid) {
    crypto:x509:cert=$guid
    return($node)
}

function liftCpe(cpe) {
    it:sec:cpe=$cpe
    return($node)
}

// Build the Shodan search query that finds the services matching a node. Returns the query,
// or null (with a warning) for unsupported nodes or nodes missing the needed props.
// See slib.shodan.search's help for every supported form and the query it becomes.
//
// filehash sets which hash a file:bytes is searched for (favicon or html), see fileHash().
function searchQuery(n, filehash=$lib.null) {
    $props = $n.props
    switch $n.form() {
        "inet:banner": {
            $texthash = $bannerHash($n)
            if ($texthash = $lib.null) { return($lib.null) }
            return(`hash:{$texthash}`)
        }
        "file:bytes": {
            $info = $fileHash($n, $filehash)
            if (not $info) { return($lib.null) }
            if ($info.kind = "favicon") { return(`http.favicon.hash:{$info.hash}`) }
            return(`http.html_hash:{$info.hash}`)
        }
        "crypto:x509:cert": { return($certQuery($n)) }
        "inet:tls:servercert": {
            $cert = $liftCert($props.cert)
            if $cert { return($certQuery($cert)) }
        }
        "it:sec:cpe": { return($cpeQuery($n)) }
        "it:prod:softver": {
            if $props.cpe {
                $cpe = $liftCpe($props.cpe)
                if $cpe { return($cpeQuery($cpe)) }
            }
            $name = $props.name
            if (not $name) { $name = $props."software:name" }
            if $name {
                $query = `product:{$quote($name)}`
                if $props.vers { $query = `{$query} version:{$quote($props.vers)}` }
                return($query)
            }
        }
        "it:sec:cve": { return(`vuln:{$n.repr().upper()}`) }
        "risk:vuln": {
            if $props.cve { return(`vuln:{$props.cve.upper()}`) }
        }
        "inet:ssl:jarmhash": { return(`ssl.jarm:{$n.repr()}`) }
        "inet:tls:ja3s:sample": { return(`ssl.ja3s:{$props.ja3s}`) }
        "inet:asn": { return(`asn:AS{$n.repr()}`) }
        "inet:cidr4": { return(`net:{$n.repr()}`) }
        "inet:cidr6": { return(`net:{$n.repr()}`) }
        "inet:fqdn": { return(`hostname:{$quote($n.repr())}`) }
        "inet:server": {
            $ip = $lib.null
            if ($props.ipv4 != $lib.null) { $ip = $lib.repr(inet:ipv4, $props.ipv4) }
            elif $props.ipv6 { $ip = $props.ipv6 }
            if $ip { return(`ip:{$quote($ip)} port:{$props.port}`) }
        }
        "ou:org": {
            if $props.name { return(`org:{$quote($props.name)}`) }
        }
        "ou:name": { return(`org:{$quote($n.repr())}`) }
        // A bare search, the string is the query.
        "it:dev:str": { return($n.repr()) }
        "meta:rule": {
            if $isQueryRule($n) {
                if $props.text { return($props.text) }
            } else {
                $lib.warn("slib.shodan: meta:rule {rule} isn't a Shodan query, its :type must be svc.shodan.query.local. or svc.shodan.query.community.",
                          rule=$n.repr())
                return($lib.null)
            }
        }
        *: {
            $lib.warn("slib.shodan: The node form {form} is not supported.", form=$n.form())
            return($lib.null)
        }
    }

    $lib.warn("slib.shodan: {form} {repr} is missing the props needed to search for it.",
              form=$n.form(), repr=$n.repr())
    return($lib.null)
}

// ---- Saved queries (see slib.shodan.model's "Saved queries") ----

// Whether a meta:rule is a saved Shodan query: its :type is svc.shodan.query.local. or
// svc.shodan.query.community. (the parent type alone isn't a saved query).
function isQueryRule(rule) {
    $type = $rule.props.type
    return(($type = "svc.shodan.query.local." or $type = "svc.shodan.query.community."))
}

// Whether a saved query came from Shodan's directory.
function isCommunityRule(rule) {
    return(($rule.props.type = "svc.shodan.query.community."))
}

// Yield the saved Shodan queries stored in the Cortex (community and local). With match, only
// those whose :name, :text, or :desc contain it (ignoring case, not a regex).
function storedQueries(match=$lib.null) {
    meta:rule:type^=svc.shodan.query
    +$isQueryRule($node)

    // No loop here, the node is in the pipeline (see the NOTE in slib.shodan.model).
    // NOTE: Storm's str.find() returns null (not -1) when the text isn't found.
    $hay = ""
    if :name { $hay = `{$hay}\n{:name}` }
    if :text { $hay = `{$hay}\n{:text}` }
    if :desc { $hay = `{$hay}\n{:desc}` }
    +$($match = $lib.null or $hay.lower().find($lib.cast(str, $match).lower()) != $lib.null)
}

// Save a query in the Cortex as a local meta:rule (never sent to Shodan). Returns the node.
function saveQuery(query, name, desc=$lib.null) {
    $query = $lib.cast(str, $query).strip()
    if (not $query) { $lib.raise(BadArg, "slib.shodan: A saved query can't be empty.") }
    $existing = $localRule($query)
    if $existing {
        $lib.warn("slib.shodan: {query} is already a local saved query ({name}).",
                  query=$query, name=$existing.props.name)
        return($existing)
    }
    return($model.localRule($query, $lib.cast(str, $name), desc=$desc))
}

// The local saved query with the query text, if any. Found by :text, not the guid, since rules
// migrated from the old svc.shodan.query. type (and hand-made ones) have other guids.
function localRule(text) {
    meta:rule:text=$text
    +:type=svc.shodan.query.local.
    return($node)
}

// Whether a query from Shodan's directory is already stored as a community meta:rule.
function isStored(q) {
    return(($model.liftRule($model.communityGuid($lib.cast(str, $q.query))) != $lib.null))
}

// The IP to look up in Shodan for a node, as a string. Returns null (with a warning) for
// unsupported nodes or nodes missing the needed props.
//
//     inet:ipv4/inet:ipv6         The IP.
//     inet:server                 :ipv4 or :ipv6
//     inet:banner                 :server:ipv4 or :server:ipv6
//     inet:dns:a/inet:dns:aaaa    :ipv4 / :ipv6
function hostIp(n) {
    $props = $n.props
    $ipv4 = $lib.null
    $ipv6 = $lib.null
    switch $n.form() {
        "inet:ipv4": { return($n.repr()) }
        "inet:ipv6": { return($n.repr()) }
        "inet:server": {
            $ipv4 = $props.ipv4
            $ipv6 = $props.ipv6
        }
        "inet:banner": {
            $ipv4 = $props."server:ipv4"
            $ipv6 = $props."server:ipv6"
        }
        "inet:dns:a": { $ipv4 = $props.ipv4 }
        "inet:dns:aaaa": { $ipv6 = $props.ipv6 }
        *: {
            $lib.warn("slib.shodan: The node form {form} is not supported.", form=$n.form())
            return($lib.null)
        }
    }
    if ($ipv4 != $lib.null) { return($lib.repr(inet:ipv4, $ipv4)) }
    if $ipv6 { return($ipv6) }
    $lib.warn("slib.shodan: {form} {repr} has no IP to look up.", form=$n.form(), repr=$n.repr())
    return($lib.null)
}

// The search filters the Trends API supports (https://developer.shodan.io/api/trends).
// Trends only supports a subset of Shodan's search filters.
function trendsFilters() {
    return((
        all, asn, city, country, cpe, has_ipv6, has_screenshot, has_ssl, has_vuln, hash, hostname,
        http.component, http.component_category, http.favicon.hash, http.html_hash,
        http.robots_hash, http.securitytxt, http.status, http.title, http.waf, ip, isp, net, org,
        os, port, product, region, screenshot.label, ssh.fingerprint, ssl, ssl.alpn,
        ssl.cert.fingerprint, ssl.cert.issuer.cn, ssl.cert.serial, ssl.cert.subject.cn, ssl.ja3s,
        ssl.jarm, ssl.version, state, tag, title, version, vuln,
    ))
}

// The Trends query for a node: the searchQuery() for it, if Trends supports all of its filters.
// Returns null (with a warning) otherwise.
function trendsQuery(n, filehash=$lib.null) {
    $query = $searchQuery($n, filehash=$filehash)
    if ($query = $lib.null) { return($lib.null) }

    $supported = $trendsFilters()
    // Filters are "name:value", optionally negated with "-" or "!". Quoted values are removed
    // first, so text in them (ex. http.title:"Index of: /") isn't mistaken for a filter.
    $unquoted = $lib.regex.replace('"(?:\\.|[^"\\])*"', '""', $query)
    for $name in $lib.regex.findall("(?:^|[\\s(])[-!]?([A-Za-z0-9_.]+):", $unquoted) {
        if (not $supported.has($name.lower())) {
            $lib.warn("slib.shodan: Trends doesn't support the {name} filter, skipping {form} {repr}.",
                      name=$name, form=$n.form(), repr=$n.repr())
            return($lib.null)
        }
    }
    return($query)
}

// What a node adds to a stream: ({"kind": <stream type>, "value": <str>}), or null (with a
// warning) for unsupported nodes or nodes missing the needed props.
//
//     inet:asn                 asn         The ASN, without an "AS" prefix.
//     risk:vuln/it:sec:cve     vulns       :cve / the CVE.
//     pol:country              countries   :iso2
//     meta:rule                custom      :text, for saved queries (see isQueryRule).
function streamTarget(n) {
    $props = $n.props
    switch $n.form() {
        "inet:asn": { return(({"kind": "asn", "value": $n.repr()})) }
        "it:sec:cve": { return(({"kind": "vulns", "value": $n.repr().upper()})) }
        "risk:vuln": {
            if $props.cve { return(({"kind": "vulns", "value": $props.cve.upper()})) }
        }
        "pol:country": {
            if $props.iso2 { return(({"kind": "countries", "value": $props.iso2.upper()})) }
        }
        "meta:rule": {
            if (not $isQueryRule($n)) {
                $lib.warn("slib.shodan: meta:rule {rule} isn't a Shodan query, its :type must be svc.shodan.query.local. or svc.shodan.query.community.",
                          rule=$n.repr())
                return($lib.null)
            }
            if $props.text { return(({"kind": "custom", "value": $props.text})) }
        }
        *: {
            $lib.warn("slib.shodan: The node form {form} is not supported.", form=$n.form())
            return($lib.null)
        }
    }
    $lib.warn("slib.shodan: {form} {repr} is missing the props needed to stream it.",
              form=$n.form(), repr=$n.repr())
    return($lib.null)
}

// The lookup enrich() makes for a node, ex. "cve:CVE-2021-44228", so commands can make each lookup
// once. Returns null for nodes enrich() doesn't support (or that are missing the needed props).
function enrichKey(node) {
    switch $node.form() {
        "inet:ipv4": { return(`host:{$node.repr()}`) }
        "inet:ipv6": { return(`host:{$node.repr()}`) }
        "inet:fqdn": { return(`domain:{$node.repr()}`) }
        "risk:vuln": {
            if $node.props.cve { return(`cve:{$node.props.cve.upper()}`) }
        }
        "it:sec:cve": { return(`cve:{$node.repr().upper()}`) }
        "it:sec:cpe": { return(`cpe:{$node.repr()}`) }
    }
    return($lib.null)
}

// Enrich any supported node with the best matching Shodan API. Returns a list of the resulting nodes.
function enrich(node) {
    switch $node.form() {
        "inet:ipv4": { return(($host($node.repr()),)) }
        "inet:ipv6": { return(($host($node.repr()),)) }
        "inet:fqdn": { return($domain($node.repr())) }
        "risk:vuln": {
            $cveid = $node.props.cve
            if $cveid { return(($cve($cveid),)) }
            $lib.warn("slib.shodan: risk:vuln {iden} has no :cve to enrich.", iden=$node.iden())
        }
        "it:sec:cve": { return(($cve($node.repr()),)) }
        "it:sec:cpe": { return($cves(cpe23=$node.repr())) }
        *: {
            $lib.warn("slib.shodan: The node form {form} is not supported.", form=$node.form())
        }
    }
    return(([]))
}
