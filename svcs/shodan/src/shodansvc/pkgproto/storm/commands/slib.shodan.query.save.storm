init {
    $shodan = $lib.import(slib.shodan.lib)
}

spin |  // noqa: P001 (drops inbound nodes on purpose)

$rule = $shodan.saveQuery($cmdopts.query, $cmdopts.name, desc=$cmdopts.desc)
$lib.print(`slib.shodan.query.save: Saved {$rule.props.name} ({$rule.props.text}).`)
if $cmdopts.yield { yield $rule }
