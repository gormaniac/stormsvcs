init {
    $privalert = $lib.import(slib.shodan.priv.alert)
    $util = $lib.import(slib.shodan.util)

    $args = ({})
    $ok = (true)
    for $arg in $cmdopts.arg {
        $parts = $util.splitArg($arg)
        if ($parts = $lib.null) {
            $lib.warn("slib.shodan.notifier.edit: {arg} is not in the format <name>=<value>.", arg=$arg)
            $ok = (false)
        } else {
            $args.($parts.0) = $parts.1
        }
    }

    if $ok {
        $retn = $privalert.notifierEdit($cmdopts.id, $args)
        if (not $util.failed($retn, `Editing notifier {$cmdopts.id}`)) {
            $lib.print("slib.shodan.notifier.edit: Updated notifier {id}.", id=$cmdopts.id)
        }
    }
}
