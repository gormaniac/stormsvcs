init {
    $privscan = $lib.import(slib.shodan.priv.scan)
    $util = $lib.import(slib.shodan.util)

    if $cmdopts.id {
        $retn = $privscan.scanStatus($cmdopts.id)
        if (not $util.failed($retn, `Checking scan {$cmdopts.id}`)) {
            $lib.print("Scan {id}: {status} ({count} IPs, created {created})", id=$retn.data.id,
                status=$retn.data.status, count=$retn.data.size, created=$retn.data.created)
        }
    } else {
        $retn = $privscan.scans(page=$cmdopts.page)
        if (not $util.failed($retn, "Listing scans")) {
            $lib.print("Total scans: {total}", total=$retn.data.total)
            $rows = ([])
            for $scan in $retn.data.matches {
                $rows.append(($scan.id, $scan.status, $scan.size, $scan.credits_left, $scan.created))
            }
            $util.table(([["id", 18], ["status", 12], ["IPs", 8], ["credits left", 12], ["created", 28]]), $rows)
        }
    }
}
