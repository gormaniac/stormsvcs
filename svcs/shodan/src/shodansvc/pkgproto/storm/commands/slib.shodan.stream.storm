init {
    $shodan = $lib.import(slib.shodan.lib)
    $priv = $lib.import(slib.shodan.priv.user)
    $util = $lib.import(slib.shodan.util)

    $kind = $cmdopts.type
    $values = $cmdopts.value

    // The it:exec:query :text, ex. "ports:443,53", the custom query, or "alert:<id>".
    if ($kind = "custom") { $text = $cmdopts.query }
    elif $values { $text = `{$kind}:{(",").join($values)}` }
    elif $cmdopts.alert { $text = `{$kind}:{$cmdopts.alert}` }
    else { $text = $kind }

    $apiurl = $lib.null
    $retn = $priv.streamUrl(kind=$kind, values=$values, query=$cmdopts.query, aid=$cmdopts.alert)
    if $retn.status { $apiurl = $retn.data }

    // Recorded on the stream's it:exec:query, never include the API key.
    $opts = ({
        "command": "slib.shodan.stream",
        "kind": $kind,
        "values": $values,
        "alert": $cmdopts.alert,
        "limit": $cmdopts.limit,
        "timeout": $cmdopts.timeout,
    })
}

spin |

$genr = $priv.stream(kind=$kind, values=$values, query=$cmdopts.query, aid=$cmdopts.alert,
                     limit=$cmdopts.limit, timeout=$cmdopts.timeout)
for $res in $shodan.ingest($genr, "Stream", $text, $apiurl, $opts) {
    if $cmdopts.yield_query {
        if $res.done { yield $res.query }
    } elif $res.ip {
        yield $res.ip
    }
}

| uniq
