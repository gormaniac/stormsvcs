init {
    $shodan = $lib.import(slib.shodan.lib)
    $priv = $lib.import(slib.shodan.priv.user)
    $model = $lib.import(slib.shodan.model)
    $util = $lib.import(slib.shodan.util)
    $query = $cmdopts.query

    // Modes that only print, returning before any nodes are created.
    $printonly = ($cmdopts.filters or $cmdopts.tokens or $cmdopts.count)

    if $cmdopts.filters {
        $retn = $priv.searchFilters()
        if (not $util.failed($retn, "Listing search filters")) {
            $lib.print("Filters: {filters}", filters=(", ").join($retn.data))
        }
        $retn = $priv.searchFacets()
        if (not $util.failed($retn, "Listing search facets")) {
            $lib.print("Facets: {facets}", facets=(", ").join($retn.data))
        }
    }

    if ($cmdopts.limit = 0 and not $printonly) {
        $lib.warn("slib.shodan.search: --limit 0 retrieves every result, using a query credit per 100 results.")
    }
    $tagPrefix = $priv.tagPrefix()

    // Set once an inbound inet:banner is searched for, so the query isn't also searched on its own.
    $state = ({"banners": (false)})
}

// Run a search. Prints the --tokens/--count/--facets output, then (unless only printing)
// models every matching banner and yields the IP nodes.
// NOTE: No return() here, it would make this a function that returns a value instead of yielding nodes.
function run(query) {
    if $cmdopts.tokens {
        $retn = $priv.searchTokens($query)
        if (not $util.failed($retn, "Parsing the query")) { $util.printJson($retn.data) }
    } elif ($cmdopts.count or $cmdopts.facets) {
        // Facets come from a dedicated call to the free count API so we don't fetch page 1 twice.
        $retn = $priv.count($query, facets=$cmdopts.facets)
        if (not $util.failed($retn, "Counting results")) {
            $lib.print("Total results: {total} ({query})", total=$retn.data.total, query=$query)
            $util.printFacets($retn.data.facets)
        }
    }

    if (not $printonly) {
        for $retn in $priv.searchGenr($query, limit=$cmdopts.limit, minify=$cmdopts.minify, page=$cmdopts.page) {
            if $util.failed($retn, "Search") { break }
            $model.banner($retn.data, $tagPrefix)
            $ipnode = $model.ipNode($retn.data.ip)
            if $ipnode { yield $ipnode }
        }
    }
}

// Inbound inet:banner nodes are searched for by their Shodan banner hash, AND'd with any query.
// NOTE: The flag is set in the switch so it only runs for inbound nodes, a bare "$state.banners = (true)"
// is runtsafe and would also run (once) without any inbound nodes.
switch $node.form() {
    "inet:banner": { $state.banners = (true) }
    *: {
        $lib.warn("slib.shodan.search: The node form {form} is not supported.", form=$node.form())
        spin
    }
}
$texthash = $shodan.bannerHash($node)
if ($texthash = $lib.null) { spin }

$hashquery = `hash:{$texthash}`
if $query { $hashquery = `{$hashquery} {$query}` }
divert (true) $run($hashquery)

// Without inbound inet:banner nodes, run the query on its own (once).
| if (not $state.banners) {
    if $query {
        for $ipnode in $run($query) { yield $ipnode }
    } elif (not $cmdopts.filters) {
        $lib.raise(BadArg, "slib.shodan.search requires a query, inbound inet:banner nodes, or --filters.")
    }
}

| uniq
