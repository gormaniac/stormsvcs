// Model normalized ANY.RUN data (see anyrunsvc.norm) in Synapse.
//
// Node edits here run as the calling user. Observables are linked to the ANY.RUN meta:source
// with a -(seen)> edge, and ANY.RUN's tags and threat names are applied as "<prefix>.<tag>"
// tags (no tags when prefix is null).
//
// Guids are derived from the task UUID (and the report's IDs), so modeling a task again
// updates the same nodes.
//
// NOTE: A for loop that runs while a node is in a function's pipeline sends the node
// downstream after its first iteration, reaching return() and ending the function early.
// So functions here only yield a node when they don't loop, and loops call helpers that
// yield/edit the node in their own runtime instead.

init {
    $source = "efe78724dcaf411b87b8b34cf6fe589e"
    $scanner = "any.run"
}

// ---- Generic helpers, each returns a single node (or null) ----

// Link the node to the ANY.RUN meta:source.
function seen(n) {
    if ($n = $lib.null) { return($n) }
    yield $n
    [ <(seen)+ { meta:source=$source } ]
    return($n)
}

// Tag a node with "<prefix>.<name>", for the interval ival (a [min, max] list or null).
function tag(n, prefix, name, ival=$lib.null) {
    if ($n = $lib.null or $prefix = $lib.null or not $name) { return($n) }
    $tagname = `{$prefix}.{$name}`
    yield $n
    if $ival { [ +?#$tagname=$ival ] }
    else { [ +?#$tagname ] }
    return($n)
}

// Tag a node with each of a list of tag names.
function tags(n, prefix, names, ival=$lib.null) {
    for $name in $names { $tag($n, $prefix, $name, $ival) }
    return($n)
}

// Link two nodes with a light edge, n1 -(verb)> n2.
function edge(n1, verb, n2) {
    if ($n1 = $lib.null or $n2 = $lib.null) { return($n1) }
    yield $n1
    [ +($verb)> { yield $n2 } ]
    return($n1)
}

// A tag part for a name (lowercase letters, numbers, and _), or null.
function tagPart(name) {
    if (not $name) { return($lib.null) }
    $part = $lib.regex.replace("[^a-z0-9_]+", "_", $lib.cast(str, $name).lower()).strip("_")
    if $part { return($part) }
    return($lib.null)
}

// ---- Observables ----

function ipNode(ip, ver=$lib.null) {
    if ($ip = $lib.null) { return($lib.null) }
    if ($ver = $lib.null) {
        if ($lib.cast(str, $ip) ~= ":") { $ver = ipv6 } else { $ver = ipv4 }
    }
    if ($ver = "ipv6") { [ inet:ipv6?=$ip ] }
    else { [ inet:ipv4?=$ip ] }
    return($seen($node))
}

function fqdnNode(fqdn) {
    if ($fqdn = $lib.null) { return($lib.null) }
    [ inet:fqdn?=$fqdn ]
    return($seen($node))
}

// An IP or FQDN node for a host.
function hostNode(host) {
    if ($host = $lib.null) { return($lib.null) }
    ($ok, $valu) = $lib.trycast(inet:ipv4, $host)
    if $ok { return($ipNode($host, ver=ipv4)) }
    if ($lib.cast(str, $host) ~= ":") { return($ipNode($host, ver=ipv6)) }
    return($fqdnNode($host))
}

function urlNode(url) {
    if ($url = $lib.null) { return($lib.null) }
    [ inet:url?=$url ]
    return($seen($node))
}

function mutexNode(mutex) {
    if ($mutex = $lib.null) { return($lib.null) }
    [ it:dev:mutex?=$mutex ]
    return($seen($node))
}

function techniqueNode(ttp) {
    [ it:mitre:attack:technique?=$ttp ]
    return($seen($node))
}

// A file:bytes node from normalized hashes ({sha256, md5, sha1, ssdeep, size, name, mime}).
function fileNode(file) {
    if ($file = $lib.null or $file.sha256 = $lib.null) { return($lib.null) }
    [ file:bytes?=`sha256:{$file.sha256}`
        :sha256?=$file.sha256 :md5?=$file.md5 :sha1?=$file.sha1
        :size?=$file.size :name?=$file.name :mime?=$file.mime ]
    if $file.ssdeep { [ :ssdeeps?+=$file.ssdeep ] }
    return($seen($node))
}

// A file:bytes node for a file saved in the Axon.
function axonFile(sha256, size=$lib.null, name=$lib.null) {
    return($fileNode(({"sha256": $sha256, "size": $size, "name": $name})))
}

// The node of an observable from a feed ({kind, value}): an IP, FQDN, URL, file, or hash.
function observableNode(obs) {
    switch $obs.kind {
        "ipv4": { return($ipNode($obs.value, ver=ipv4)) }
        "ipv6": { return($ipNode($obs.value, ver=ipv6)) }
        "fqdn": { return($fqdnNode($obs.value)) }
        "url": { return($urlNode($obs.value)) }
        "sha256": { return($fileNode(({"sha256": $obs.value}))) }
        "sha1": { [ hash:sha1?=$obs.value ] return($seen($node)) }
        "md5": { [ hash:md5?=$obs.value ] return($seen($node)) }
    }
    return($lib.null)
}

// The scan result :target prop for a node, or null if it can't be a scan target.
function targetProp(n) {
    switch $n.form() {
        "file:bytes": { return("target:file") }
        "inet:url": { return("target:url") }
        "inet:fqdn": { return("target:fqdn") }
        "inet:ipv4": { return("target:ipv4") }
        "inet:ipv6": { return("target:ipv6") }
    }
    return($lib.null)
}

// A malware family as a risk:tool:software, with :tag set to its tag.
function family(fam, prefix) {
    $famtag = $lib.null
    $part = $tagPart($fam)
    if ($prefix and $part) { $famtag = `{$prefix}.{$part}` }
    [ risk:tool:software=$lib.guid(slib.anyrun, family, $fam.lower())
        :soft:name?=$fam :reporter:name=$scanner :tag?=$famtag ]
    return($seen($node))
}

// ---- Tasks ----

// The guid of something in a task (a process, flow, request...).
function taskGuid(data, kind, id) {
    if ($id = $lib.null) { return($lib.null) }
    return($lib.guid(slib.anyrun, $data.uuid, $kind, $id))
}

// Model a normalized task report (slib.anyrun.priv.user.normReport). Returns the task's
// sample node (file:bytes, or inet:url for URL analyses), or null if it has nothing to model
// it by.
function report(data, prefix=$lib.null) {
    if ($data.kind = "url") { $snode = $urlNode($data.url) }
    else { $snode = $fileNode($data.file) }
    if ($snode = $lib.null) { return($lib.null) }

    $ival = $data.ival
    $tags($snode, $prefix, $data.tagnames, ival=$ival)

    $scan($snode, $data)
    for $fam in $data.families { $family($fam, $prefix) }
    for $ttp in $data.ttps { $edge($snode, uses, $techniqueNode($ttp)) }
    for $mutex in $data.mutexes { $edge($snode, refs, $mutexNode($mutex)) }
    // The URL a download task fetched its sample from.
    if ($data.kind = "download" and $data.url) { $edge($snode, refs, $urlNode($data.url)) }

    for $config in $data.configs { $c2config($snode, $data, $config, $prefix) }
    $taskNodes($snode, $data, $prefix)
    return($snode)
}

// The sample node of a task (file:bytes, or inet:url for URL tasks), or null.
function sampleNode(data) {
    if ($data.kind = "url") { return($urlNode($data.url)) }
    return($fileNode($data.file))
}

// The node a task's artifacts (PCAP, video, screenshots) are linked to with -(refs)>: the
// task's verdict (it:av:scan:result, the only node unique to a task) or, when ANY.RUN gave no
// verdict, the sample. Returns null if the task has no sample to model.
function anchor(data) {
    $snode = $sampleNode($data)
    if ($snode = $lib.null) { return($lib.null) }
    $result = $scan($snode, $data)
    if $result { return($result) }
    return($snode)
}

// Link a downloaded task artifact (a file:bytes) to the task's anchor, setting its MIME type.
function artifact(anchor, fnode, mime=$lib.null) {
    if ($fnode = $lib.null) { return($fnode) }
    $setMime($fnode, $mime)
    return($edge($anchor, refs, $fnode))
}

function setMime(fnode, mime) {
    if ($mime = $lib.null) { return($fnode) }
    yield $fnode
    if (not :mime) { [ :mime=$mime ] }
    return($node)
}

// A screenshot of a task (an it:screenshot of the downloaded JPEG), linked to the task's anchor.
function screenshot(data, anchor, fnode, screen) {
    $setMime($fnode, "image/jpeg")
    $sandbox = $lib.null
    if ($data.kind != "url" and $data.file) { $sandbox = `sha256:{$data.file.sha256}` }
    $desc = `ANY.RUN task {$data.uuid} screenshot`
    if ($screen.offset != $lib.null) { $desc = `{$desc} at {$screen.offset}s` }
    [ it:screenshot=$lib.guid(slib.anyrun, $data.uuid, screenshot, $screen.uuid)
        :image=$fnode.repr() :sandbox:file?=$sandbox :time?=$screen.time :desc=$desc ]
    $n = $seen($node)
    $edge($anchor, refs, $n)
    return($n)
}

// A URL task's browser visit (it:exec:url), with a screenshot of the page as :page:image.
function urlVisit(data, image) {
    if ($data.kind != "url" or not $data.url) { return($lib.null) }
    [ it:exec:url=$lib.guid(slib.anyrun, $data.uuid, visit, $data.url)
        :url=$data.url :time?=$data.time :page:image?=$image.repr() ]
    return($seen($node))
}

// ANY.RUN's verdict on the sample.
function scan(snode, data) {
    if ($data.verdict = $lib.null) { return($lib.null) }
    $target = $targetProp($snode)
    $signame = $lib.null
    if $data.families { $signame = $data.families.index(0) }
    $cats = $lib.null
    if $data.tagnames { $cats = $data.tagnames }
    [ it:av:scan:result=$lib.guid(slib.anyrun, $data.uuid, scan)
        :scanner:name=$scanner :$target=$snode.repr() :time?=$data.time :verdict=$data.verdict
        :signame?=$signame :categories?=$cats ]
    return($seen($node))
}

// Tag the C2 servers of a malware config and model the config.
function c2config(snode, data, config, prefix) {
    $famtag = $tagPart($config.family)
    for $url in $config.servers { $c2($urlNode($url), $prefix, $famtag, $data.ival) }
    for $host in $config.hosts { $c2($hostNode($host), $prefix, $famtag, $data.ival) }

    $file = $lib.null
    if ($snode.form() = "file:bytes") { $file = $snode.repr() }
    [ it:sec:c2:config=$lib.guid(slib.anyrun, $data.uuid, config, $config.family, $config.servers)
        :family?=$config.family :file?=$file :servers?=$config.servers :raw?=$config.raw ]
    return($seen($node))
}

function c2(n, prefix, famtag, ival) {
    $tag($n, $prefix, c2, $ival)
    return($tag($n, $prefix, $famtag, $ival))
}

// Model a task's processes, network activity, Suricata alerts, and created files, linked to
// the sample with :sandbox:file (when the sample is a file).
function taskNodes(snode, data, prefix=$lib.null) {
    $sandbox = $lib.null
    if ($snode.form() = "file:bytes") { $sandbox = $snode.repr() }

    for $proc in $data.procs { $procNode($data, $proc, $sandbox) }
    for $req in $data.dns { $dnsNode($data, $req, $sandbox) }
    for $req in $data.http { $httpNode($data, $req, $sandbox) }
    for $flow in $data.flows { $flowNode($data, $flow, $sandbox) }
    for $alert in $data.alerts { $alertNode($data, $alert, $sandbox) }
    for $file in $data.files { $edge($snode, refs, $fileAdd($data, $file, $sandbox, $prefix)) }
    for $op in $data.fileops {
        $n = $fileOp($data, $op, $sandbox, $prefix)
        if ($op.op = "add" and $op.file) { $edge($snode, refs, $fileNode($op.file)) }
    }
    for $op in $data.regops { $regOp($data, $op, $sandbox) }
    return($snode)
}

function procNode(data, proc, sandbox) {
    // The main process runs the sample itself.
    $exe = $lib.null
    if $proc.main { $exe = $sandbox }
    [ it:exec:proc=$taskGuid($data, proc, $proc.uuid)
        :sandbox:file?=$sandbox :exe?=$exe :pid?=$proc.pid :cmd?=$proc.cmd :path?=$proc.path
        :time?=$proc.time :exited?=$proc.exited :exitcode?=$proc.exitcode
        :src:proc?=$taskGuid($data, proc, $proc.parent) ]
    return($seen($node))
}

function dnsNode(data, req, sandbox) {
    $fqdnNode($req.name)
    for $ans in $req.ips { $answerNode($req.name, $ans) }
    [ inet:dns:request=$lib.guid(slib.anyrun, $data.uuid, dns, $req.name, $req.time)
        :sandbox:file?=$sandbox :query:name?=$req.name :time?=$req.time ]
    return($seen($node))
}

function answerNode(name, ans) {
    $ipNode($ans.ip, ver=$ans.ipver)
    if ($ans.ipver = "ipv6") { [ inet:dns:aaaa?=($name, $ans.ip) ] }
    else { [ inet:dns:a?=($name, $ans.ip) ] }
    return($seen($node))
}

function httpNode(data, req, sandbox) {
    $urlNode($req.url)
    if $req.ip { $ipNode($req.ip, ver=$req.ipver) }
    $hdrs = $lib.null
    if $req.headers { $hdrs = $req.headers }
    [ inet:http:request=$lib.guid(slib.anyrun, $data.uuid, http, $req.method, $req.url, $req.time)
        :sandbox:file?=$sandbox :proc?=$taskGuid($data, proc, $req.proc) :server?=$req.server
        :method?=$req.method :url?=$req.url :headers?=$hdrs :response:code?=$req.code
        :time?=$req.time ]
    return($seen($node))
}

function flowNode(data, flow, sandbox) {
    $ipGeo($flow)
    $ipprop = `dst:{$flow.ipver}`
    [ inet:flow=$lib.guid(slib.anyrun, $data.uuid, flow, $flow.server, $flow.time, $flow.proc)
        :sandbox:file?=$sandbox :dst?=$flow.server :dst:port?=$flow.port :dst:proto?=$flow.proto
        :$ipprop?=$flow.ip :src:proc?=$taskGuid($data, proc, $flow.proc) :time?=$flow.time ]
    return($seen($node))
}

// ANY.RUN's ASN and country of an IP, only set when the graph doesn't already have them.
function ipGeo(flow) {
    $n = $ipNode($flow.ip, ver=$flow.ipver)
    if ($n = $lib.null) { return($lib.null) }
    yield $n
    if ($flow.asn and (not :asn)) { [ :asn?=$flow.asn ] }
    if ($flow.cc and (not :loc)) { [ :loc?=$flow.cc ] }
    return($node)
}

// A Suricata alert: the rule (it:app:suricata:rule) matched (it:app:suricata:matched) a flow.
function alertNode(data, alert, sandbox) {
    $rule = $suricataRule($alert)
    if $alert.srcip { $ipNode($alert.srcip, ver=$alert.srcver) }
    if $alert.dstip { $ipNode($alert.dstip, ver=$alert.dstver) }
    $fnode = $alertFlow($data, $alert, $sandbox)
    [ it:app:suricata:matched=$lib.guid(slib.anyrun, $data.uuid, alert, $alert.sid, $alert.src,
                                        $alert.dst, $alert.time)
        :rule=$rule.repr() :target=$fnode.repr() :time?=$alert.time ]
    return($seen($node))
}

function suricataRule(alert) {
    [ it:app:suricata:rule=$lib.guid(slib.anyrun, suricata, $alert.sid)
        :id=$alert.sid :name?=$alert.msg :desc?=$alert.class ]
    return($seen($node))
}

function alertFlow(data, alert, sandbox) {
    $srcprop = `src:{$alert.srcver}`
    $dstprop = `dst:{$alert.dstver}`
    [ inet:flow=$lib.guid(slib.anyrun, $data.uuid, alertflow, $alert.src, $alert.dst, $alert.time)
        :sandbox:file?=$sandbox :src?=$alert.src :dst?=$alert.dst :src:port?=$alert.srcport
        :dst:port?=$alert.dstport :src:proc?=$taskGuid($data, proc, $alert.proc) :time?=$alert.time ]
    if $alert.srcip { [ :$srcprop=$alert.srcip ] }
    if $alert.dstip { [ :$dstprop=$alert.dstip ] }
    return($seen($node))
}

// A file the task created (it:exec:file:add), tagged "<prefix>.threat_lvl.<level>" with
// ANY.RUN's threat level for it. Files without a SHA256 are modeled by path (and -(refs)> their
// hash:md5, when there is one). Returns the file's file:bytes node, or null.
function fileAdd(data, file, sandbox, prefix=$lib.null) {
    $fnode = $fileNode(({"sha256": $file.sha256, "md5": $file.md5, "sha1": $file.sha1,
                         "ssdeep": $file.ssdeep, "size": $file.size, "name": $file.name,
                         "mime": $file.mime}))
    $fval = $lib.null
    if $fnode { $fval = $fnode.repr() }
    [ it:exec:file:add=$lib.guid(slib.anyrun, $data.uuid, file, $file.path, $file.sha256)
        :sandbox:file?=$sandbox :file?=$fval :path?=$file.path :time?=$file.time
        :proc?=$taskGuid($data, proc, $file.proc) ]
    $add = $seen($node)
    $threatTag($add, $prefix, $file.threat, $data.ival)
    if ($fnode = $lib.null and $file.md5) { $edge($add, refs, $md5Node($file.md5)) }
    return($fnode)
}

function md5Node(md5) {
    [ hash:md5?=$md5 ]
    return($seen($node))
}

// Tag a node "<prefix>.threat_lvl.<level>" with ANY.RUN's threat level (unknown, low, mid, high).
function threatTag(n, prefix, level, ival=$lib.null) {
    if (not $level) { return($n) }
    return($tag($n, $prefix, `threat_lvl.{$level}`, $ival))
}

// A file operation from the task's incidents: an it:exec:file:add, write, del, or read,
// tagged with ANY.RUN's threat level for the file at that path.
function fileOp(data, op, sandbox, prefix=$lib.null) {
    $fnode = $fileNode($op.file)
    $fval = $lib.null
    if $fnode { $fval = $fnode.repr() }
    $form = `it:exec:file:{$op.op}`
    [ *$form=$lib.guid(slib.anyrun, $data.uuid, fileop, $op.op, $op.path, $op.proc, $op.time, $fval)
        :sandbox:file?=$sandbox :file?=$fval :path?=$op.path :time?=$op.time
        :proc?=$taskGuid($data, proc, $op.proc) ]
    $n = $seen($node)
    return($threatTag($n, $prefix, $op.threat, $data.ival))
}

// A registry operation: an it:exec:reg:set, del, or get of an it:dev:regval.
function regOp(data, op, sandbox) {
    $rval = $regVal($op)
    $form = `it:exec:reg:{$op.op}`
    [ *$form=$lib.guid(slib.anyrun, $data.uuid, regop, $op.op, $op.path, $op.int, $op.str, $op.proc, $op.time)
        :sandbox:file?=$sandbox :reg=$rval.repr() :time?=$op.time
        :proc?=$taskGuid($data, proc, $op.proc) ]
    return($seen($node))
}

// A registry value. Its guid doesn't include the task, so the same value set by different
// tasks (or samples) is the same node. :key is the key with the value's name appended.
function regVal(op) {
    [ it:dev:regval=$lib.guid(slib.anyrun, regval, $op.path, $op.int, $op.str)
        :key=$op.path :int?=$op.int :str?=$op.str ]
    return($seen($node))
}

// ---- TI Lookup ----

// Model a normalized TI Lookup (slib.anyrun.priv.user.lookupIndicator) of a node: its tags,
// threat names (risk:tool:software), and verdict. With related, also models the related IPs,
// domains, URLs, and files, each with its own threat names. Returns the node.
function lookup(n, data, prefix=$lib.null, related=(false)) {
    $tags($n, $prefix, $data.tagnames, ival=$data.ival)
    for $fam in $data.threats { $family($fam, $prefix) }
    $lookupScan($n, $data.verdict, $data.query, $data.lastseen, $data.threats)
    if $related {
        for $item in $data.ips { $relatedNode($ipNode($item.ip, ver=$item.ipver), $item, $prefix) }
        for $item in $data.fqdns { $relatedNode($fqdnNode($item.fqdn), $item, $prefix) }
        for $item in $data.urls { $relatedNode($urlNode($item.url), $item, $prefix) }
        for $item in $data.files { $fileNode($item) }
        for $mutex in $data.mutexes { $mutexNode($mutex) }
    }
    return($n)
}

// A TI Lookup verdict on a node, updated each time the node is looked up.
function lookupScan(n, verdict, query, time, threats) {
    $target = $targetProp($n)
    if ($target = $lib.null or $verdict = $lib.null) { return($lib.null) }
    $signame = $lib.null
    if $threats { $signame = $threats.index(0) }
    if ($time = $lib.null) { $time = $lib.time.now() }
    [ it:av:scan:result=$lib.guid(slib.anyrun, lookup, $n.form(), $n.repr())
        :scanner:name=$scanner :$target=$n.repr() :time=$time :verdict=$verdict
        :signame?=$signame ]
    return($seen($node))
}

// A related IP, domain, or URL with its threat names as tags (and C2 when it's from a config).
function relatedNode(n, item, prefix) {
    if ($n = $lib.null) { return($n) }
    $ival = $lib.null
    if $item.time { $ival = ($item.time, ($item.time + 1)) }
    for $name in $item.threats { $tag($n, $prefix, $tagPart($name), $ival) }
    if $item.malconf { $tag($n, $prefix, c2, $ival) }
    return($n)
}

// ---- YARA Search ----

// An it:app:yara:rule for a rule's text (when there's no rule node to use).
function yaraRule(name, text) {
    [ it:app:yara:rule=$lib.guid(slib.anyrun, yara, $text) :name?=$name :text=$text ]
    return($node)
}

// A YARA Search match: the file (tagged with its tags), and its it:app:yara:match.
function yaraMatch(rule, match, prefix) {
    $fnode = $fileNode($match)
    if ($fnode = $lib.null) { return($lib.null) }
    $ival = $lib.null
    if $match.first {
        $last = $match.last
        if ($last = $lib.null or $last < $match.first) { $last = $match.first }
        $ival = ($match.first, ($last + 1))
    }
    for $name in $match.tags { $tag($fnode, $prefix, $tagPart($name), $ival) }
    if $rule {
        [ it:app:yara:match=($rule.repr(), $fnode.repr()) ]
        $seen($node)
    }
    return($fnode)
}

// ---- TI Feeds ----

// Model a normalized TAXII object (slib.anyrun.priv.user.feedObjects): each observable, tagged
// "<prefix>.feed" and with the object's labels for the time it's valid. Returns a list of nodes.
function feedObject(item, prefix) {
    $nodes = ([])
    for $obs in $item.observables {
        $n = $observableNode($obs)
        if $n {
            $tag($n, $prefix, feed, $item.ival)
            for $name in $item.tagnames { $tag($n, $prefix, $name, $item.ival) }
            $nodes.append($n)
        }
    }
    return($nodes)
}

// Yield the non-null nodes of a list.
function nodes(items) {
    for $item in $items {
        if $item { yield $item }
    }
}
