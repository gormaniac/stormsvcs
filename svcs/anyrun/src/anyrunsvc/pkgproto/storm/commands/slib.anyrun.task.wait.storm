init {
    $priv = $lib.import(slib.anyrun.priv.user)
    $anyrun = $lib.import(slib.anyrun.lib)
    $util = $lib.import(slib.anyrun.util)
}

spin |
for $task in $cmdopts.task {
    $retn = $priv.wait($task, timeout=$cmdopts.timeout)
    if (not $util.failed($retn, `Waiting for task {$task}`)) {
        $status = $retn.data
        $lib.print("slib.anyrun.task.wait: Task {id} is {state}.", id=$status.uuid, state=$status.state)
        if (($cmdopts.model or $cmdopts.yield) and $status.state = "completed") {
            $n = $anyrun.model($status.uuid)
            if ($cmdopts.yield and $n) { yield $n }
        }
    }
}
