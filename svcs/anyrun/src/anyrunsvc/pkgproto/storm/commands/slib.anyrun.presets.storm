init {
    $priv = $lib.import(slib.anyrun.priv.user)
    $util = $lib.import(slib.anyrun.util)

    $retn = $priv.presets()
    if (not $util.failed($retn, "Listing your presets")) {
        if $cmdopts.json { $util.printJson($retn.data) }
        else {
            $rows = ([])
            for $p in $retn.data { $rows.append(($p.name, $p.os, $p.version, $p.bitness, $p.timeout, $p.privacy)) }
            $util.table((("name", 24), ("os", 8), ("version", 12), ("bits", 4), ("timeout", 7), ("privacy", 8)), $rows)
        }
    }
}
