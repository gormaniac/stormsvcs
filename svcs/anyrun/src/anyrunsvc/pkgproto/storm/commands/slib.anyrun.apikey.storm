// What's used instead of a key of your own.
function noUserKey(priv) {
    if $priv.hasSvcKey() {
        return("slib.anyrun: You don't have your own ANY.RUN API key set, so the service-wide key is used.")
    }
    return("slib.anyrun: You don't have your own ANY.RUN API key set, and no service-wide key is set either.")
}

init {
    $priv = $lib.import(slib.anyrun.priv.user)
    $vault = $lib.vault.bytype(anyrun, scope=user)

    if $cmdopts.clear {
        if $vault {
            $vault.delete()
            $lib.print("slib.anyrun: Deleted your ANY.RUN API key.")
            if $priv.hasSvcKey() { $lib.print("slib.anyrun: The service-wide key is used instead.") }
        } else {
            $lib.print($noUserKey($priv))
        }
    }
    elif (not $cmdopts.apikey) {
        if $vault {
            $lib.print("slib.anyrun: Your ANY.RUN API key is set in vault {name}.", name=$vault.name)
        } else {
            $lib.print($noUserKey($priv))
        }
    }
    elif $vault {
        $vault.secrets.apikey = $cmdopts.apikey
        $lib.print("slib.anyrun: Updated your ANY.RUN API key.")
    }
    else {
        $name = `anyrun:{$lib.user.name()}`
        $lib.vault.add($name, anyrun, user, $lib.user.iden, ({"apikey": $cmdopts.apikey}), ({}))
        $lib.print("slib.anyrun: Saved your ANY.RUN API key in vault {name}.", name=$name)
    }
}
