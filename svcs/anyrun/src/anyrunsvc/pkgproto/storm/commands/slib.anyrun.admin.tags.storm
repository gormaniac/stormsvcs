init {
    $padmin = $lib.import(slib.anyrun.priv.admin)

    if ($cmdopts.enable and $cmdopts.disable) {
        $lib.raise(BadArg, "slib.anyrun.admin.tags: Use --enable or --disable, not both.")
    }

    if ($cmdopts.prefix != $lib.null) { $padmin.setTagPrefix($cmdopts.prefix) }
    if $cmdopts.enable { $padmin.setTagsEnabled((true)) }
    if $cmdopts.disable { $padmin.setTagsEnabled((false)) }

    $settings = $padmin.tagSettings()
    $lib.print("slib.anyrun tags: enabled={enabled} prefix={prefix}",
        enabled=$settings.enabled, prefix=$settings.prefix)
}
