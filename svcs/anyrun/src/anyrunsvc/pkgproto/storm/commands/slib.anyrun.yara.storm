init {
    $anyrun = $lib.import(slib.anyrun.lib)
    $model = $lib.import(slib.anyrun.model)
}

if ($cmdopts.rule or $cmdopts.search) {
    // --rule and --search ignore inbound nodes.
    spin |
    if $cmdopts.search {
        $nodes = $anyrun.yaraSearch($cmdopts.search, timeout=$cmdopts.timeout, limit=$cmdopts.limit)
    } else {
        $nodes = $anyrun.yara($cmdopts.rule, timeout=$cmdopts.timeout, limit=$cmdopts.limit)
    }
    if $cmdopts.yield {
        for $n in $nodes { yield $n }
    }
}
else {
    if ($node.form() != "it:app:yara:rule") {
        $lib.warn("slib.anyrun.yara: The node form {form} is not supported.", form=$node.form())
        spin
    }
    divert $cmdopts.yield $model.nodes($anyrun.yara($node, timeout=$cmdopts.timeout, limit=$cmdopts.limit))
}
