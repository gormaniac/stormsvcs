init {
    $bgphe = $lib.import(slib.bgphe.lib)
    $util = $lib.import(slib.bgphe.util)
    $forms = (inet:ipv4, inet:ipv6, inet:cidr4, inet:cidr6)
    // Values are looked up once per command, not once per inbound node.
    $once = ({"done": false})
    function byValues() {
        if $util.first($once) {
            for $valu in $cmdopts.valus {
                for $n in $bgphe.hosts($valu, print=$cmdopts.print) { yield $n }
            }
        }
    }
}

if $cmdopts.valus {
    // Values ignore inbound nodes, which are dropped.
    divert (true) $byValues()
}
else {
    // Statements after an if block still run for a node that leaves it, so the work is in the else.
    // Unsupported nodes are passed through (or dropped, with --yield).
    if (not $forms.has($node.form())) {  // noqa: R002 - 2.x needs the call
        $lib.warn(`slib.bgphe.certs.ip: Unable to look up {$node.form()} {$node.repr()}, it needs an IP or CIDR.`)  // noqa: R002 - 2.x needs the call
        if $cmdopts.yield { spin }  // noqa: P001 - the inbound node is dropped on purpose
    } else {
        divert $cmdopts.yield $util.nodes($bgphe.hosts($node.repr(), print=$cmdopts.print))
    }
}
