init {
    $bgphe = $lib.import(slib.bgphe.lib)
    $util = $lib.import(slib.bgphe.util)
}

if $cmdopts.asns {
    // Values ignore inbound nodes.
    spin |
    for $asn in $cmdopts.asns {
        for $n in $bgphe.asnNodes($asn, print=$cmdopts.print) { yield $n }
    }
}
else {
    // Statements after an if block still run for a node that leaves it, so the work is in the else.
    // Unsupported nodes are passed through (or dropped, with --yield).
    if ($node.form() != "inet:asn") {
        $lib.warn(`slib.bgphe.asn: Unable to look up {$node.form()} {$node.repr()}, it needs an inet:asn.`)
        if $cmdopts.yield { spin }
    } else {
        divert $cmdopts.yield $util.nodes($bgphe.asnNodes($node.repr(), print=$cmdopts.print, org=(true)))
    }
}
