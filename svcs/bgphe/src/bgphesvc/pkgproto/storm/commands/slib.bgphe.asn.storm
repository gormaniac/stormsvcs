init {
    $bgphe = $lib.import(slib.bgphe.lib)
    $util = $lib.import(slib.bgphe.util)
    // Values are looked up once per command, not once per inbound node.
    $once = ({"done": false})
    function byValues() {
        if $util.first($once) {
            for $asn in $cmdopts.asns {
                for $n in $bgphe.asnNodes($asn, print=$cmdopts.print) { yield $n }
            }
        }
    }
}

if $cmdopts.asns {
    // Values ignore inbound nodes, which are dropped.
    divert (true) $byValues()
}
else {
    // Statements after an if block still run for a node that leaves it, so the work is in the else.
    // Unsupported nodes are passed through (or dropped, with --yield).
    if ($node.form() != "inet:asn") {  // noqa: R002 - 2.x needs the call
        $lib.warn(`slib.bgphe.asn: Unable to look up {$node.form()} {$node.repr()}, it needs an inet:asn.`)  // noqa: R002 - 2.x needs the call
        if $cmdopts.yield { spin }  // noqa: P001 - the inbound node is dropped on purpose
    } else {
        divert $cmdopts.yield $util.nodes($bgphe.asnNodes($node.repr(), print=$cmdopts.print, org=(true)))
    }
}
